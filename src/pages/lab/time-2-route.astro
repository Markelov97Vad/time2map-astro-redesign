---
import '../../styles/global.css';
import '../../styles/palette.css';
import '../../styles/lab.css';
import Time2RouteArticle from '../../components/Time2RouteArticle.astro';

const title = 'Time2Route: Build the Route Worth Taking';
const description = 'A map-first route planner for walking and cycling. Build a route, discover interesting places nearby, add stops, read elevation, and share the result.';
const githubUrl = 'https://github.com/time2map/time2route';
const techStack = [
  { label: 'React 19 + React DOM', detail: 'Interface' },
  { label: 'Google Maps JavaScript API', detail: 'Maps, routes and places' },
  { label: 'Geoapify IP Geolocation', detail: 'Location fallback' },
  { label: 'Chart.js', detail: 'Elevation profile' },
  { label: 'vite-plugin-pwa', detail: 'Installable web app' },
];
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: '2026-07-09',
  author: { '@type': 'Person', name: 'Vadim Markelov' },
  publisher: { '@type': 'Organization', name: 'time2map' },
};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width"/>
  <meta name="description" content={description}/>
  <meta property="og:type" content="article"/>
  <meta property="article:published_time" content="2026-07-09"/>
  <title>Time2Route — Route Planner with Places, Stops, Elevation and Shareable Links</title>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
</head>
<body class="lab-page">
  <a class="skip-link" href="#article-content">Skip to article</a>

  <header class="article-nav">
    <a class="logo" href="/" aria-label="time2map — home"><img src="/images/logo.svg" alt="time2map"/></a>
    <span class="article-nav-label">Time2map LAB</span>
    <div class="article-nav-actions">
      <a href={githubUrl} target="_blank" rel="noopener">GitHub <span>↗</span></a>
      <a class="article-nav-back" href="/">Back home <span>↗</span></a>
    </div>
  </header>

  <main class="lab-main">
    <section class="lab-hero" aria-labelledby="article-title">
      <div class="lab-hero-topline">
        <div class="eyebrow"><span></span> Product story · July 2026</div>
        <span>3 min read</span>
      </div>
      <h1 id="article-title">Time2Route:<br/><em>Build the route worth taking.</em></h1>
      <div class="lab-hero-footer">
        <p>{description}</p>
        <div class="lab-author">
          <img src="/images/vadim-markelov-avatar.jpg" alt="Vadim Markelov" width="52" height="52"/>
          <span><small>Written by</small><strong>Vadim Markelov</strong></span>
        </div>
      </div>
    </section>

    <article class="lab-article" id="article-content">
      <div class="lab-content">
        <Time2RouteArticle />
      </div>

      <aside class="lab-tech" aria-labelledby="tech-heading">
        <div>
          <div class="eyebrow"><span></span> Under the hood</div>
          <h2 id="tech-heading">Built for routes<br/><em>that travel well.</em></h2>
        </div>
        <ul>
          {techStack.map((item) => (
            <li><strong>{item.label}</strong><span>{item.detail}</span></li>
          ))}
        </ul>
      </aside>

      <div class="lab-outro">
        <div>
          <small>Explore the project</small>
          <h2>Plan a route.<br/><em>Make it worth taking.</em></h2>
        </div>
        <div class="lab-outro-actions">
          <a href="https://route.time2map.com/" target="_blank" rel="noopener">Open Time2Route <span>↗</span></a>
          <a href={githubUrl} target="_blank" rel="noopener">View source <span>↗</span></a>
        </div>
      </div>
    </article>
  </main>

  <footer class="site-footer">
    <div class="footer-brand"><a class="logo" href="/" aria-label="time2map — home"><img src="/images/logo.svg" alt="time2map"/></a><p>Maps and GIS solutions,<br/>built by specialists.</p></div>
    <div class="footer-details"><p>Barcelona, Spain</p><p>VAT: ES Z2405174T</p></div>
    <nav class="footer-links" aria-label="Footer navigation"><a href="/contact-us">Contact us</a><a href="https://www.iubenda.com/privacy-policy/48336731" target="_blank" rel="noopener">Privacy Policy <span>↗</span></a><a href="/">Home</a></nav>
    <p class="footer-copyright">© 2026 time2map. All rights reserved</p>
  </footer>
</body>
</html>
