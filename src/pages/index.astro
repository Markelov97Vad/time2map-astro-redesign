    <div class="footer-meta"><div class="footer-details"><p>Barcelona, Spain</p><p>VAT: ES Z2405174T</p></div><div class="footer-actions"><nav class="footer-links" aria-label="Footer navigation"><a href="/contact-us">Contact us</a><a href="https://www.iubenda.com/privacy-policy/48336731" target="_blank" rel="noopener">Privacy Policy <span>↗</span></a></nav><nav class="footer-social" aria-label="Social links"><a href="https://www.linkedin.com/in/sasfeat/" target="_blank" rel="noopener" aria-label="LinkedIn"><img src="/images/icons/linkedin.svg" alt="" width="32" height="32"/></a><a href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener" aria-label="Upwork"><img src="/images/icons/upwork.svg" alt="" width="32" height="32"/></a></nav></div></div>
