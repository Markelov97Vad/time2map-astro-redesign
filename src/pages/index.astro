  <script>
    const labNav = document.querySelector<HTMLDetailsElement>('.lab-nav');
    if (labNav) {
      const closeLabNav = () => { labNav.open = false; };
      document.addEventListener('pointerdown', (event) => {
        if (!labNav.open) return;
        if (event.target instanceof Node && !labNav.contains(event.target)) closeLabNav();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && labNav.open) closeLabNav();
      });
    }

    const expertise = document.querySelector<HTMLElement>('#expertise');
    const skillCards = [...document.querySelectorAll<HTMLElement>('#expertise .skill-card')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const bentoMotion = window.matchMedia('(min-width: 801px) and (hover: hover) and (pointer: fine)');

    const proofSection = document.querySelector<HTMLElement>('.proof');
    const proofCards = [...document.querySelectorAll<HTMLElement>('.proof-card')];
    const proofStats = [...document.querySelectorAll<HTMLElement>('.proof-stat strong[data-count-to]')];

    const animateProofStat = (stat:HTMLElement, sequenceStartedAt:number) => {
      const target = Number(stat.dataset.countTo ?? 0);
      const suffix = stat.dataset.countSuffix ?? '';
      const duration = 800;

      const tick = (now:number) => {
        const progress = Math.min((now - sequenceStartedAt) / duration, 1);
        if (progress < 1) {
          const current = Math.min(target - 1, Math.floor(target * progress));
          stat.textContent = `${current}${suffix}`;
          requestAnimationFrame(tick);
        } else {
          stat.textContent = `${target}${suffix}`;
          stat.style.removeProperty('width');
        }
      };

      requestAnimationFrame(tick);
    };

    if (proofSection && proofCards.length && !reduceMotion.matches) {
      document.documentElement.classList.add('has-proof-motion');
      proofCards.forEach((card, index) => card.style.setProperty('--proof-index', String(index)));
      proofStats.forEach((stat) => {
        stat.style.width = `${Math.ceil(stat.getBoundingClientRect().width)}px`;
        stat.textContent = `0${stat.dataset.countSuffix ?? ''}`;
      });
      const proofObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        proofSection.classList.add('is-visible');
        const sequenceStartedAt = performance.now();
        proofStats.forEach((stat) => animateProofStat(stat, sequenceStartedAt));
        window.setTimeout(() => proofSection.classList.add('is-settled'), 1050);
        observer.disconnect();
      }, { threshold:.18, rootMargin:'0px 0px -8% 0px' });
      proofObserver.observe(proofSection);
    } else {
      proofSection?.classList.add('is-visible', 'is-settled');
    }

    if (skillCards.length && finePointer.matches) {
      skillCards.forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
          card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
        }, { passive:true });
      });
    }

    if (expertise && skillCards.length && !reduceMotion.matches && bentoMotion.matches) {
      document.documentElement.classList.add('has-bento-motion');
      skillCards.forEach((card, cardIndex) => {
        card.style.setProperty('--card-index', String(cardIndex));
        card.querySelectorAll<HTMLElement>('.design-art i').forEach((node, nodeIndex) => {
          node.style.setProperty('--node-index', String(nodeIndex));
        });
      });

      const expertiseObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        expertise.classList.add('is-visible');
        window.setTimeout(() => {
          expertise.classList.add('is-settled');
          document.documentElement.classList.remove('has-bento-motion');
        }, 1300);
        observer.disconnect();
      }, { threshold:.08, rootMargin:'0px 0px -8% 0px' });
      expertiseObserver.observe(expertise);
    } else {
      expertise?.classList.add('is-visible');
    }

    const device = document.querySelector('#device');
    const wrap = document.querySelector('.device-wrap');
    wrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=wrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; device.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    wrap?.addEventListener('pointerleave',()=>device.style.transform='rotateY(-8deg) rotateX(5deg)');
    const audioSlides = document.querySelector<HTMLElement>('[data-audio-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-audio-slide]').forEach((button) => button.addEventListener('click', () => {
      if (audioSlides) audioSlides.style.transform = `translateX(-${Number(button.dataset.audioSlide) * 100}%)`;
      document.querySelectorAll('[data-audio-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const recycleDevice = document.querySelector<HTMLElement>('#recycle-device');
    const recycleWrap = document.querySelector<HTMLElement>('.recycle-device-wrap');
    recycleWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=recycleWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(recycleDevice) recycleDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    recycleWrap?.addEventListener('pointerleave',()=>{ if(recycleDevice) recycleDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const recycleSlides = document.querySelector<HTMLElement>('[data-recycle-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-recycle-slide]').forEach((button) => button.addEventListener('click', () => {
      if (recycleSlides) recycleSlides.style.transform = `translateX(-${Number(button.dataset.recycleSlide) * 100}%)`;
      document.querySelectorAll('[data-recycle-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));
    const airportDevice = document.querySelector<HTMLElement>('#airport-device');
    const airportWrap = document.querySelector<HTMLElement>('.airport-device-wrap');
    airportWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=airportWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(airportDevice) airportDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    airportWrap?.addEventListener('pointerleave',()=>{ if(airportDevice) airportDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const airportSlides = document.querySelector<HTMLElement>('[data-airport-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-airport-slide]').forEach((button) => button.addEventListener('click', () => {
      if (airportSlides) airportSlides.style.transform = `translateX(-${Number(button.dataset.airportSlide) * 100}%)`;
      document.querySelectorAll('[data-airport-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const enableSwipe = (track: HTMLElement | null, buttonSelector: string) => {
      if (!track) return;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>(buttonSelector)];
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;
      track.addEventListener('touchstart', (event) => {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        deltaX = 0;
        deltaY = 0;
      }, { passive:true });
      track.addEventListener('touchmove', (event) => {
        deltaX = event.touches[0].clientX - startX;
        deltaY = event.touches[0].clientY - startY;
        if (Math.abs(deltaX) > Math.abs(deltaY)) event.preventDefault();
      }, { passive:false });
      track.addEventListener('touchend', (event) => {
        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        event.preventDefault();
        const activeIndex = Math.max(0, buttons.findIndex((button) => button.classList.contains('is-active')));
        const nextIndex = Math.min(buttons.length - 1, Math.max(0, activeIndex + (deltaX < 0 ? 1 : -1)));
        buttons[nextIndex]?.click();
      }, { passive:false });
    };
    enableSwipe(audioSlides, '[data-audio-slide]');
    enableSwipe(recycleSlides, '[data-recycle-slide]');
    enableSwipe(airportSlides, '[data-airport-slide]');

    const deviceWraps = document.querySelectorAll<HTMLElement>('.cesium .device-wrap');
    let expandedWrap: HTMLElement | null = null;
    const setExpanded = (wrap: HTMLElement, expanded: boolean) => {
      const update = () => {
        wrap.classList.toggle('is-expanded', expanded);
        wrap.querySelector<HTMLElement>('.device')?.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('preview-open', expanded);
        expandedWrap = expanded ? wrap : null;
      };
      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(update);
      else update();
    };
    deviceWraps.forEach((deviceWrap, index) => {
      const preview = deviceWrap.querySelector<HTMLElement>('.device');
      if (!preview) return;
      preview.dataset.previewDevice = String(index + 1);
      preview.tabIndex = 0;
      preview.setAttribute('role', 'button');
      preview.setAttribute('aria-label', 'Open project preview fullscreen');
      preview.setAttribute('aria-expanded', 'false');
      const close = document.createElement('button');
      close.className = 'preview-close';
      close.type = 'button';
      close.setAttribute('aria-label', 'Close fullscreen preview');
      close.textContent = '×';
      deviceWrap.append(close);
      const open = () => { if (!deviceWrap.classList.contains('is-expanded')) setExpanded(deviceWrap, true); };
      preview.addEventListener('click', open);
      preview.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
      close.addEventListener('click', (event) => { event.stopPropagation(); setExpanded(deviceWrap, false); preview.focus(); });
      deviceWrap.addEventListener('click', (event) => { if (deviceWrap.classList.contains('is-expanded') && event.target === deviceWrap) setExpanded(deviceWrap, false); });
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && expandedWrap) setExpanded(expandedWrap, false); });

    const projectGrid = document.querySelector<HTMLElement>('[data-project-grid]');
    const projectShowcase = document.querySelector<HTMLElement>('.project-showcase');
    const projectTiles = [...document.querySelectorAll<HTMLElement>('[data-project-grid] [data-project]')];
    if (projectShowcase && projectTiles.length && !reduceMotion.matches) {
      document.documentElement.classList.add('has-project-motion');
      projectTiles.forEach((tile, index) => tile.style.setProperty('--project-index', String(index)));
      const projectObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        projectShowcase.classList.add('is-visible');
        window.setTimeout(() => projectShowcase.classList.add('is-settled'), 1100);
        observer.disconnect();
      }, { threshold:.12, rootMargin:'0px 0px -8% 0px' });
      projectObserver.observe(projectShowcase);
    } else {
      projectShowcase?.classList.add('is-visible', 'is-settled');
    }
    const lightbox = document.createElement('div');
    lightbox.className = 'project-lightbox';
    lightbox.setAttribute('role', 'dialog');
    lightbox.setAttribute('aria-modal', 'true');
    lightbox.setAttribute('aria-label', 'Case study screenshots');
    lightbox.innerHTML = '<button class="project-lightbox-close" type="button" aria-label="Close fullscreen case preview">×</button><button class="gallery-arrow gallery-prev" type="button" data-lightbox-dir="-1" aria-label="Previous screenshot">←</button><div class="project-lightbox-stage"></div><button class="gallery-arrow gallery-next" type="button" data-lightbox-dir="1" aria-label="Next screenshot">→</button><div class="project-lightbox-pagination" aria-hidden="true"></div>';
    document.body.append(lightbox);
    const lightboxStage = lightbox.querySelector<HTMLElement>('.project-lightbox-stage');
    const lightboxClose = lightbox.querySelector<HTMLButtonElement>('.project-lightbox-close');
    const lightboxPagination = lightbox.querySelector<HTMLElement>('.project-lightbox-pagination');
    let fullscreenProject: HTMLElement | null = null;
    let lightboxResizeTimer = 0;
    let lightboxScrollFrame = 0;
    const setLightboxPagination = (index: number) => {
      lightboxPagination?.querySelectorAll('span').forEach((dot, dotIndex) => dot.classList.toggle('is-active', dotIndex === index));
    };
    const fitLightboxStage = (index: number, align = false) => {
      if (!lightboxStage) return;
      setLightboxPagination(index);
      const images = [...lightboxStage.querySelectorAll<HTMLImageElement>('img')];
      const image = images[Math.min(images.length - 1, Math.max(0, index))];
      if (!image) return;
      const applyRatio = () => {
        const ratio = image.naturalWidth && image.naturalHeight ? image.naturalWidth / image.naturalHeight : 16 / 9;
        lightboxStage.style.setProperty('--lightbox-aspect', String(ratio));
        lightboxStage.style.setProperty('--lightbox-max-width-by-height', `${ratio * 82}dvh`);
        lightboxStage.style.setProperty('--lightbox-mobile-max-width-by-height', `${ratio * 78}dvh`);
        if (align) requestAnimationFrame(() => { lightboxStage.scrollLeft = index * lightboxStage.clientWidth; });
      };
      if (image.complete && image.naturalWidth) applyRatio();
      else image.addEventListener('load', applyRatio, { once:true });
    };
    const setProjectFullscreen = (tile: HTMLElement | null, open: boolean) => {
      if (!lightboxStage) return;
      if (open && tile) {
        const source = tile.querySelector<HTMLElement>('.project-gallery');
        const sourceImages = source ? [...source.querySelectorAll<HTMLImageElement>('img')] : [];
        const activeIndex = source?.clientWidth ? Math.round(source.scrollLeft / source.clientWidth) : 0;
        tile.setAttribute('aria-expanded', 'true');
        lightboxStage.replaceChildren();
        sourceImages.forEach((image) => {
          const clone = image.cloneNode(true) as HTMLImageElement;
          clone.loading = 'eager';
          lightboxStage.append(clone);
        });
        fitLightboxStage(activeIndex);
        const hasSlides = lightboxStage.childElementCount > 1;
        lightboxPagination?.replaceChildren(...sourceImages.map(() => document.createElement('span')));
        setLightboxPagination(activeIndex);
        lightbox.classList.toggle('has-slides', hasSlides);
        lightbox.classList.add('is-open');
        document.body.classList.add('project-preview-open');
        fullscreenProject = tile;
        requestAnimationFrame(() => {
          lightboxStage.scrollLeft = activeIndex * lightboxStage.clientWidth;
          lightboxClose?.focus();
        });
      } else {
        lightbox.classList.remove('is-open', 'has-slides');
        document.body.classList.remove('project-preview-open');
        lightboxStage.replaceChildren();
        lightboxPagination?.replaceChildren();
        fullscreenProject?.setAttribute('aria-expanded', 'false');
        fullscreenProject?.focus();
        fullscreenProject = null;
      }
    };
    const projectCounter = document.querySelector<HTMLElement>('[data-project-counter]');
    const projectJumps = [...document.querySelectorAll<HTMLButtonElement>('[data-project-jump]')];
    let currentProjectIndex = 0;
    let projectScrollFrame = 0;
    let projectDidDrag = false;
    let projectPointerId: number | null = null;
    let projectDragStartX = 0;
    let projectDragStartScroll = 0;

    const setCurrentProject = (index: number) => {
      currentProjectIndex = Math.min(projectTiles.length - 1, Math.max(0, index));
      projectTiles.forEach((tile, tileIndex) => {
        const current = tileIndex === currentProjectIndex;
        tile.classList.toggle('is-current', current);
        tile.setAttribute('aria-current', String(current));
      });
      if (projectCounter) projectCounter.textContent = `${String(currentProjectIndex + 1).padStart(2, '0')} / ${String(projectTiles.length).padStart(2, '0')}`;
      projectJumps.forEach((button, buttonIndex) => {
        const current = buttonIndex === currentProjectIndex;
        button.classList.toggle('is-active', current);
        button.setAttribute('aria-pressed', String(current));
      });
    };

    const scrollToProject = (index: number, behavior: ScrollBehavior = 'smooth') => {
      if (!projectGrid) return;
      const nextIndex = Math.min(projectTiles.length - 1, Math.max(0, index));
      const tile = projectTiles[nextIndex];
      if (!tile) return;
      setCurrentProject(nextIndex);
      const gridBounds = projectGrid.getBoundingClientRect();
      const tileBounds = tile.getBoundingClientRect();
      const centeredLeft = projectGrid.scrollLeft + tileBounds.left + tileBounds.width / 2 - gridBounds.left - projectGrid.clientWidth / 2;
      projectGrid.scrollTo({ left:centeredLeft, behavior:reduceMotion.matches ? 'auto' : behavior });
    };

    const updateProjectFromScroll = () => {
      projectScrollFrame = 0;
      if (!projectGrid) return;
      const center = projectGrid.getBoundingClientRect().left + projectGrid.clientWidth / 2;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;
      projectTiles.forEach((tile, index) => {
        const bounds = tile.getBoundingClientRect();
        const distance = Math.abs(bounds.left + bounds.width / 2 - center);
        if (distance < closestDistance) { closestDistance = distance; closestIndex = index; }
      });
      if (closestIndex !== currentProjectIndex) setCurrentProject(closestIndex);
    };

    projectJumps.forEach((button) => button.addEventListener('click', () => {
      scrollToProject(Number(button.dataset.projectJump));
    }));
    projectGrid?.addEventListener('scroll', () => {
      if (!projectScrollFrame) projectScrollFrame = requestAnimationFrame(updateProjectFromScroll);
    }, { passive:true });
    projectGrid?.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0 || (event.target as HTMLElement).closest('button')) return;
      projectPointerId = event.pointerId;
      projectDragStartX = event.clientX;
      projectDragStartScroll = projectGrid.scrollLeft;
      projectDidDrag = false;
    });
    projectGrid?.addEventListener('pointermove', (event) => {
      if (projectPointerId !== event.pointerId) return;
      const distance = event.clientX - projectDragStartX;
      if (!projectDidDrag && Math.abs(distance) > 5) {
        projectDidDrag = true;
        projectGrid.classList.add('is-dragging');
        projectGrid.setPointerCapture(event.pointerId);
      }
      if (!projectDidDrag) return;
      projectGrid.scrollLeft = projectDragStartScroll - distance;
    });
    const finishProjectDrag = (event: PointerEvent) => {
      if (!projectGrid || projectPointerId !== event.pointerId) return;
      const didDrag = projectDidDrag;
      projectGrid.classList.remove('is-dragging');
      if (projectGrid.hasPointerCapture(event.pointerId)) projectGrid.releasePointerCapture(event.pointerId);
      projectPointerId = null;
      if (didDrag) {
        updateProjectFromScroll();
        scrollToProject(currentProjectIndex);
        window.setTimeout(() => { projectDidDrag = false; }, 0);
      }
    };
    projectGrid?.addEventListener('pointerup', finishProjectDrag);
    projectGrid?.addEventListener('pointercancel', finishProjectDrag);
    projectGrid?.addEventListener('dragstart', (event) => event.preventDefault());

    projectTiles.forEach((tile, tileIndex) => {
      tile.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('button')) return;
        if (projectDidDrag) return;
        scrollToProject(tileIndex, 'auto');
        setProjectFullscreen(tile, true);
      });
      tile.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          const direction = event.key === 'ArrowLeft' ? -1 : 1;
          scrollToProject(tileIndex + direction);
          projectTiles[Math.min(projectTiles.length - 1, Math.max(0, tileIndex + direction))]?.focus();
          return;
        }
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); scrollToProject(tileIndex, 'auto'); setProjectFullscreen(tile, true); }
      });
      const gallery = tile.querySelector<HTMLElement>('.project-gallery');
      tile.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]').forEach((arrow) => arrow.addEventListener('click', (event) => {
        event.stopPropagation();
        gallery?.scrollBy({ left: Number(arrow.dataset.galleryDir) * (gallery.clientWidth || 1), behavior: 'smooth' });
      }));
    });
    setCurrentProject(0);
    requestAnimationFrame(() => scrollToProject(0, 'auto'));
    let projectResizeFrame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(projectResizeFrame);
      projectResizeFrame = requestAnimationFrame(() => scrollToProject(currentProjectIndex, 'auto'));
    }, { passive:true });
    lightboxClose?.addEventListener('click', () => setProjectFullscreen(null, false));
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) setProjectFullscreen(null, false); });
    lightboxStage?.addEventListener('scroll', () => {
      if (!lightboxScrollFrame) {
        lightboxScrollFrame = requestAnimationFrame(() => {
          lightboxScrollFrame = 0;
          if (!lightboxStage.clientWidth) return;
          setLightboxPagination(Math.round(lightboxStage.scrollLeft / lightboxStage.clientWidth));
        });
      }
      window.clearTimeout(lightboxResizeTimer);
      lightboxResizeTimer = window.setTimeout(() => {
        if (!lightboxStage.clientWidth) return;
        fitLightboxStage(Math.round(lightboxStage.scrollLeft / lightboxStage.clientWidth), true);
      }, 100);
    }, { passive:true });
    lightbox.querySelectorAll<HTMLButtonElement>('[data-lightbox-dir]').forEach((arrow) => arrow.addEventListener('click', (event) => {
      event.stopPropagation();
      lightboxStage?.scrollBy({ left: Number(arrow.dataset.lightboxDir) * (lightboxStage.clientWidth || 1), behavior: 'smooth' });
    }));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && fullscreenProject) setProjectFullscreen(null, false); });
  </script>
</body></html>
