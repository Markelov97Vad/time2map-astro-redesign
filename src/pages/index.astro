---
import '../styles/global.css';
import '../styles/palette.css';

const bookCallUrl = 'https://cal.com/alexander-semenov-uqwtme/40-min-call-with-alex-from-time2map';
const demoVideoEmbedUrl = 'https://player.vimeo.com/video/1178497009?autoplay=1&muted=1&loop=1&background=1&playsinline=1&dnt=1';
const demoVideoPoster = '/images/hero-poster.webp';
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Time2map redesign concept"/><title>time2map — maps that move business</title></head>
<body>
  <header class="nav"><a class="logo" href="#" aria-label="time2map — home"><img src="/images/logo.svg" alt="time2map"/></a><nav><a href="#expertise">Expertise</a><a href="#work">Work</a><a href="#process">Process</a><details class="lab-nav"><summary>LAB <span class="lab-chevron" aria-hidden="true"><i></i><i></i></span></summary><div class="lab-dropdown"><a href="/lab/time-2-route"><div class="lab-card-meta"><small>July 2026</small><small>3 min read</small></div><strong>Time2Route</strong><span>A map-first planner for walking and cycling — with places, stops, elevation, and shareable routes.</span><em>Explore the project ↗</em></a><a href="/lab/barcelona-crime-map"><div class="lab-card-meta"><small>May 2026</small><small>8 min read</small></div><strong>Barcelona Crime Map</strong><span>Safety analysis across Catalunya’s 59 police zones, benchmarked against Spain with trends from 2019–2025.</span><em>Explore the research ↗</em></a></div></details></nav><a class="pill pill-dark" href="/contact-us">Start a project <i>↗</i></a></header>
  <main>
    <section class="hero">
      <h1>Maps and GIS solutions<br/><em>for the real world.</em></h1>
      <p>We design and build interactive maps, geospatial platforms, and data-driven applications for organizations worldwide.</p>
      <div class="hero-actions"><a class="text-link" href="#work">Explore our work ↓</a></div>
      <div class="map-hero" aria-hidden="true">
        <div class="hero-globe"><img src="/images/globe-light.png" alt="" /></div>
        <img class="hero-marker" src="/images/map-pin.svg" alt="" />
      </div>
    </section>

    <section class="proof" aria-labelledby="proof-title">
      <header class="proof-header">
        <div class="eyebrow"><span></span> At a glance</div>
        <div class="proof-heading">
          <h2 id="proof-title">Proof,<br/><em>not promises.</em></h2>
          <p>Senior geospatial expertise, measured in delivered work and client trust.</p>
        </div>
      </header>

      <div class="proof-grid">
        <a class="proof-card" href="#work">
          <div class="proof-card-top">
            <span class="proof-index">01</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/projects-check.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="10" data-count-suffix="+" aria-label="10+">10+</strong><span>projects<br/>delivered</span></div>
          <span class="proof-link">Explore our work <i aria-hidden="true">↗</i></span>
        </a>

        <a class="proof-card proof-card-featured" href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener">
          <div class="proof-card-top">
            <span class="proof-index">02</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/job-success-large.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="100" data-count-suffix="%" aria-label="100%">100%</strong><span>Upwork Job<br/>Success Score</span></div>
          <span class="proof-link">View Upwork profile <i aria-hidden="true">↗</i></span>
        </a>

        <a class="proof-card" href="#expertise">
          <div class="proof-card-top">
            <span class="proof-index">03</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/geospatial.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="6" aria-label="6">6</strong><span>years of geospatial<br/>expertise</span></div>
          <span class="proof-link">Explore expertise <i aria-hidden="true">↓</i></span>
        </a>
      </div>
    </section>

    <!-- <section class="manifest"><p>Maps shouldn’t be a layer added at the end.</p><h2>They can be the product.</h2></section> -->

    <section class="cesium audio-feature" id="work">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · izi.TRAVEL founders</div><h2>Audio Guides<br/>Mapping Platform</h2><p>Built a full-stack map platform powering <a href="https://tmatic.travel/" target="_blank" rel="noopener">tmatic.travel</a>. A CMS, responsive public map and partner API deliver audio tours and stories to travelers and cultural institutions worldwide.</p><p class="case-details">Angular and Mapbox power 2D, 3D and dedicated indoor museum modes. Java Spring and PostGIS keep content delivery seamless at global scale.</p><div class="case-metrics"><div class="metric"><b>20K+</b><span>audio tours<br/>worldwide</span></div><div class="metric"><b>500K+</b><span>stories across<br/>the platform</span></div></div><a class="case-link" href="https://tmatic.travel/" target="_blank" rel="noopener">Explore tmatic.travel ↗</a></div>
      <div class="device-wrap">
        <div class="device" id="device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="audio-slides" data-audio-slides><div class="device-screen"><div class="device-poster" style={`background-image:url('${demoVideoPoster}')`}></div><iframe src={demoVideoEmbedUrl} title="time2map demo video" allow="autoplay; fullscreen" data-cmp-ab="2"></iframe></div><img src="/images/audio-guides-1.webp" alt="Audio Guides public map view"/><img src="/images/audio-guides-2.webp" alt="Audio Guides content management system"/><img src="/images/audio-guides-3.webp" alt="Audio Guides mobile interface"/></div></div></div>
        <div class="screen-switcher" aria-label="Audio Guides video and screenshots"><button class="is-active" data-audio-slide="0" aria-label="Show demo video">01</button><button data-audio-slide="1" aria-label="Show screenshot 1">02</button><button data-audio-slide="2" aria-label="Show screenshot 2">03</button><button data-audio-slide="3" aria-label="Show screenshot 3">04</button></div>
      </div>
    </section>

    <section class="cesium recycle-feature" id="recyclemap">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Greenpeace</div><h2>Crowdmapping<br/>for Recycling</h2><p>Developed a crowdmapping platform for <a href="https://es.greenpeace.org/" target="_blank" rel="noopener">Greenpeace’s</a> Recyclemap project, enabling volunteers to add, update and moderate recycling and ZeroWaste locations across the country.</p><p class="case-details">Angular and Mapbox GL power mobile and desktop experiences. Python, PostGIS, Martin and H3 clustering process OSM data and provide scalable spatial queries for thousands of active users.</p><div class="case-metrics"><div class="metric"><b>Web + mobile</b><span>responsive mapping<br/>applications</span></div><div class="metric"><b>Live data</b><span>community-powered<br/>locations</span></div></div><a class="case-link" href="https://wastefreemap.com" target="_blank" rel="noopener">Explore Waste Free Map ↗</a></div>
      <div class="device-wrap recycle-device-wrap">
        <div class="device recycle-device" id="recycle-device"><div class="device-top"><span></span></div><div class="screen audio-screen recycle-screen"><div class="recycle-slides" data-recycle-slides><img src="/images/recycling-1.webp" alt="Recyclemap crowdmapping interface"/><img src="/images/recycling-2.webp" alt="Recycling point details"/><img src="/images/recycling-3.webp" alt="Recyclemap mobile interface"/></div></div></div>
        <div class="screen-switcher" aria-label="Recyclemap screenshots"><button class="is-active" data-recycle-slide="0" aria-label="Show screenshot 1">01</button><button data-recycle-slide="1" aria-label="Show screenshot 2">02</button><button data-recycle-slide="2" aria-label="Show screenshot 3">03</button></div>
      </div>
    </section>

    <section class="cesium airport-feature" id="airport-maps">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Global aviation</div><h2>Automated 300+<br/>Airport Maps</h2><p>Prepared more than 300 airport maps for <a href="https://www.airportmaps.com/" target="_blank" rel="noopener">airportmaps.com</a> in only 1.5 months, meeting a demanding global production schedule.</p><p class="case-details">Python scripts extracted and processed OSM and official airport POI data for terminals, entrances and roads. Automated styling reduced production time by 50%, while designers finalized accurate web maps and print-ready PDFs.</p><div class="case-metrics"><div class="metric"><b>300+</b><span>airport maps<br/>in production</span></div><div class="metric"><b>−50%</b><span>map production<br/>time</span></div></div><a class="case-link" href="https://www.airportmaps.com/" target="_blank" rel="noopener">Explore Airport Maps ↗</a></div>
      <div class="device-wrap airport-device-wrap">
        <div class="device airport-device" id="airport-device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="airport-slides" data-airport-slides><img src="/images/airport-maps-1.webp" alt="Automated airport map"/><img src="/images/airport-maps-2.webp" alt="Airport terminal map"/><img src="/images/airport-maps-3.webp" alt="Airport map production result"/></div></div></div>
        <div class="screen-switcher" aria-label="Airport Maps screenshots"><button class="is-active" data-airport-slide="0" aria-label="Show screenshot 1">01</button><button data-airport-slide="1" aria-label="Show screenshot 2">02</button><button data-airport-slide="2" aria-label="Show screenshot 3">03</button></div>
      </div>
    </section>

    <section class="project-showcase" aria-labelledby="project-heading">
      <div class="project-intro"><div class="eyebrow"><span></span> More Time2map products</div><div class="project-intro-title"><h2 id="project-heading">More cases.</h2><div class="project-carousel-controls"><span class="project-carousel-count" data-project-counter aria-live="polite">01 / 04</span></div></div></div>
      <div class="project-carousel-shell">
        <button class="project-side-control project-side-prev" type="button" data-project-prev aria-label="Previous case">←</button>
        <div class="project-grid project-carousel-track" data-project-grid data-active="" role="region" aria-roledescription="carousel" aria-label="Time2map case studies">
        <article class="project-tile project-one is-current" data-project="one" tabindex="0" role="button" aria-current="true" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/coal-mining.webp" alt="Coal mining safety monitoring platform"/><img src="/images/projects/coal-mining-2.webp" alt="Coal mine digital twin interface"/><img src="/images/projects/coal-mining-3.webp" alt="Coal mine realtime monitoring"/></div><button class="gallery-arrow gallery-prev" data-gallery-dir="-1" aria-label="Previous screenshot">←</button><button class="gallery-arrow gallery-next" data-gallery-dir="1" aria-label="Next screenshot">→</button><span class="project-wash"></span><div class="project-copy"><small>01 · Industrial safety · Realtime</small><h3>Coal Mining<br/>Safety Platform</h3><p class="project-description">A unified digital twin combining radar, gas detector, GPS and radio data into one dispatcher interface for faster incident response.</p><span class="project-tech">React · Java Spring · RabbitMQ · Kubernetes · PostGIS</span><span class="gallery-hint">Browse screens</span></div><b>01</b></article>
        <article class="project-tile project-two" data-project="two" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/ski.webp" alt="Offline ski resort map"/></div><span class="project-wash"></span><div class="project-copy"><small>02 · Salt Lake City · Offline</small><h3>Ski Resort Maps<br/>with Offline Mode</h3><p class="project-description">Built a responsive map that keeps trails and resort details available in areas with poor connectivity, with automated lightweight raster tiles for mobile and desktop.</p><span class="project-tech">JavaScript · PHP · PWA · Mobile · Leaflet</span></div><b>02</b></article>
        <article class="project-tile project-three" data-project="three" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/land-certificates.webp" alt="Land certificate automation platform"/><img src="/images/projects/land-certificates-2.webp" alt="Land certificate parcel search"/><img src="/images/projects/land-certificates-3.webp" alt="Land certificate administration interface"/></div><button class="gallery-arrow gallery-prev" data-gallery-dir="-1" aria-label="Previous screenshot">←</button><button class="gallery-arrow gallery-next" data-gallery-dir="1" aria-label="Next screenshot">→</button><span class="project-wash"></span><div class="project-copy"><small>03 · United States · Automation</small><h3>Land Certificate<br/>Automation</h3><p class="project-description">An end-to-end platform that analyzes parcels against restricted zones and automatically generates PDF land certificates.</p><span class="project-tech">Python · React · QGIS Server · FastAPI · PDF</span><span class="gallery-hint">Browse screens</span></div><b>03</b></article>
        <article class="project-tile project-four" data-project="four" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/georeferencing.webp" alt="New York georeferencing project"/></div><span class="project-wash"></span><div class="project-copy"><small>04 · NYC · Logistics</small><h3>Georeferencing<br/>Automation</h3><p class="project-description">Automated detection and normalization of inconsistent spatial reference systems across hundreds of GPS tracks, eliminating extensive manual correction.</p><span class="project-tech">QGIS · Georeferencing · Python</span></div><b>04</b></article>
        </div>
        <button class="project-side-control project-side-next" type="button" data-project-next aria-label="Next case">→</button>
      </div>
    </section>

    <section class="expertise bento-section" id="expertise">
      <div class="bento-heading"><div class="eyebrow light"><span></span> What we do?</div><h2>Everything spatial.<br/><em>One senior team.</em></h2></div>
      <div class="bento-grid">
        <article class="skill-card card-maps card-wide"><div class="map-art"><i></i><i></i><i></i><span></span></div><div><small>Maps & GIS Solutions</small><h3>Custom interactive maps</h3><p>Mapbox · MapLibre · Leaflet</p></div></article>
        <article class="skill-card card-analysis"><span class="skill-icon">⌁</span><h3>Geospatial analysis & visualization</h3><p>QGIS · ArcGIS · GDAL · FME</p></article>
        <article class="skill-card card-mobile"><div class="signal"><i></i><i></i><i></i></div><h3>Mobile offline maps</h3><p>Maps that work beyond the network</p></article>
        <article class="skill-card card-cesium card-tall"><div class="terrain-art"><i></i><i></i><i></i><span>3D</span></div><div><h3>3D maps & terrain models</h3><p>Cesium · terrain · digital twins</p></div></article>
        <article class="skill-card card-data card-wide"><div class="nodes"><i></i><i></i><i></i><i></i></div><div><h3>Tile servers & spatial databases</h3><p>GDB · PostGIS · Geoserver · QGIS Server · Titiler</p></div></article>
        <article class="skill-card"><span class="skill-icon">↔</span><h3>CAD ↔ GIS</h3><p>FME · GDAL</p></article>
        <article class="skill-card card-design"><div class="design-art"><i></i><i></i><i></i></div><h3>UX / UI design</h3><p>Figma · prototypes · responsive systems</p></article>
        <article class="skill-card"><span class="skill-icon">◎</span><h3>Business + System Analysis</h3><p>Clear requirements and product logic</p></article>
        <article class="skill-card card-code card-wide"><div class="skill-visual skill-visual-frontend"><img src="/images/bento/frontend-development.webp" alt="Audio Guides detail view beside an interactive 3D map of the Hungarian Parliament" width="1366" height="886" loading="lazy" decoding="async"/></div><div><h3>Frontend development</h3><p>React · Vue · Angular</p></div></article>
        <article class="skill-card"><span class="skill-icon">{ }</span><h3>Backend development</h3><p>Python · Java</p></article>
        <article class="skill-card"><span class="skill-icon">✓</span><h3>Quality Assurance</h3><p>Automated + manual testing</p></article>
        <article class="skill-card card-cloud"><div class="cloud-art">☁<span>→</span>●</div><h3>CI/CD & cloud deployment</h3><p>Reliable releases at any scale</p></article>
        <article class="skill-card"><span class="skill-icon">◇</span><h3>Software Architecture</h3><p>Systems built to evolve</p></article>
        <article class="skill-card"><span class="skill-icon">∞</span><h3>High-load</h3><p>Performance under pressure</p></article>
        <article class="skill-card card-cartography card-wide"><div class="contours"></div><div><h3>Web cartography</h3><p>Mapbox Studio · visual map systems</p></div></article>
        <article class="skill-card"><span class="skill-icon">✦</span><h3>Geodata preprocessing</h3><p>Cleaning · transformation · digitizing</p></article>
      </div>
    </section>

    <section class="technologies" id="technologies" aria-labelledby="technologies-title">
      <div class="technology-intro">
        <div class="eyebrow light"><span></span> Our toolkit</div>
        <h2 id="technologies-title">Built with the<br/><em>right tools.</em></h2>
        <p>A practical stack selected around the product, its users, and the scale it needs to reach.</p>
      </div>
      <div class="technology-map">
        <article class="technology-row">
          <div class="technology-label"><span>01</span><h3>Design</h3></div>
          <ul><li><i>Fi</i>Figma</li><li><i>Ai</i>Adobe</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>02</span><h3>Frontend</h3></div>
          <ul><li><i>Re</i>React</li><li><i>TS</i>TypeScript</li><li><i>Ng</i>Angular</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>03</span><h3>Backend</h3></div>
          <ul><li><i>Ja</i>Java</li><li><i>Py</i>Python</li><li><i>Pg</i>PostgreSQL</li><li><i>My</i>MySQL</li><li><i>Mg</i>MongoDB</li><li><i>Rb</i>RabbitMQ</li><li><i>Ax</i>APISIX</li><li><i>Aw</i>AWS</li><li><i>Ti</i>TimescaleDB</li><li><i>Ke</i>Keycloak</li><li><i>Rd</i>Redis</li><li><i>Es</i>Elasticsearch</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>04</span><h3>QA</h3></div>
          <ul><li><i>Cy</i>Cypress</li><li><i>Po</i>Postman</li><li><i>Ch</i>Charles Proxy</li><li><i>Bs</i>BrowserStack</li><li><i>Jm</i>JMeter</li><li><i>Ki</i>Kibana</li><li><i>Qa</i>Qase</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>05</span><h3>DevOps</h3></div>
          <ul><li><i>Ku</i>Kubernetes</li><li><i>Aw</i>AWS</li><li><i>Do</i>Docker</li><li><i>An</i>Ansible</li><li><i>Gl</i>GitLab</li></ul>
        </article>
        <article class="technology-row technology-row-geo">
          <div class="technology-label"><span>06</span><h3>Geoservices</h3></div>
          <ul><li><i>Mb</i>Mapbox</li><li><i>Lf</i>Leaflet</li><li><i>H3</i>H3</li><li><i>Pg</i>PostGIS</li><li><i>Ma</i>Martin</li><li><i>Os</i>OSM</li></ul>
        </article>
        <article class="technology-row technology-row-geo">
          <div class="technology-label"><span>07</span><h3>GIS</h3></div>
          <ul><li><i>Qg</i>QGIS</li><li><i>Gr</i>GRASS</li><li><i>Fm</i>FME</li></ul>
        </article>
      </div>
    </section>

    <section class="founder" aria-labelledby="founder-title">
      <header class="founder-header">
        <div class="eyebrow"><span></span> Founder-led delivery</div>
        <div class="founder-heading">
          <h2 id="founder-title">Meet Alex.</h2>
          <p>
            <strong>One senior point of contact</strong>
            <span>from the first conversation to the final release.</span>
          </p>
        </div>
      </header>

      <div class="founder-stage">
        <figure class="founder-portrait">
          <img src="/images/alex-semenov.jpg" alt="Alexander Semenov, founder of time2map" width="640" height="640" loading="lazy" />
          <figcaption>
            <strong>Alexander Semenov</strong>
            <span>Founder · 10+ years in GIS &amp; web development</span>
          </figcaption>
        </figure>

        <div class="founder-message">
          <span class="founder-quote-mark" aria-hidden="true">“</span>
          <blockquote>
            <p>I lead every project personally and bring in trusted specialists when the scope demands it.</p>
          </blockquote>

          <div class="founder-trust" aria-label="Upwork credentials">
            <span><i aria-hidden="true"></i> Top Rated Plus</span>
            <span><i aria-hidden="true"></i> 100% Job Success</span>
          </div>

          <div class="founder-links">
            <a href="https://www.linkedin.com/in/sasfeat/" target="_blank" rel="noopener">
              Connect on LinkedIn <span aria-hidden="true">↗</span>
            </a>
            <a href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener">
              Review projects on Upwork <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>

      <div class="reviews-header">
        <div>
          <span>Selected feedback</span>
          <h3>Trusted in the work,<br/>not just the pitch.</h3>
        </div>
        <p>Long-term partnerships built on clear communication, senior expertise and reliable delivery.</p>
      </div>

      <div class="reviews-grid">
        <figure class="review-card">
          <div class="review-topline"><span>01</span><span class="review-stars" role="img" aria-label="5 out of 5 stars"></span></div>
          <blockquote>
            <p>Alexander was an absolute pleasure to work with. Truly an expert in his subject matter, he provided the guidance we needed and achieved the results we were looking for. I would highly recommend him to anyone.</p>
          </blockquote>
          <figcaption><strong>Dan Whitson</strong><span>Edgewise Energy · USA</span></figcaption>
        </figure>

        <figure class="review-card">
          <div class="review-topline"><span>02</span><span class="review-stars" role="img" aria-label="5 out of 5 stars"></span></div>
          <blockquote>
            <p>Great experience working with these Python developers. They completed every task with high quality and attention to detail. Communication was always clear, responsive and responsible throughout the project.</p>
          </blockquote>
          <figcaption><strong>Alfiya Tarasenko</strong><span>Geoapify · Cyprus</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="process" id="process"><div class="eyebrow process-eyebrow"><span></span> How we work</div><div class="process-head"><h2>From “what if ?”<br/>to working software.</h2><p>We designed our process to make it easy to get started and build trust early on.</p></div><div class="steps"><article><b>01</b><h3>40-min FREE consultation</h3><p>We’ll listen to your needs, suggest the best approach and technologies, and answer all your questions.</p></article><article><b>02</b><h3>7-days trial</h3><p>Start working with us for 7 days without commitment. Test our communication, skills, and workflows.</p><p>If you’re satisfied, we’ll include these 7 days in the project contract.</p></article><article><b>03</b><h3>Kickoff & roadmap</h3><p>We prepare a clear roadmap with milestones, delivery timelines, and responsibilities.</p><ul><li><strong>Fixed-price</strong> for well-defined scopes</li><li><strong>Time & Material</strong> for flexible, evolving projects</li><li><strong>Hybrid</strong> tailored to your needs</li></ul></article><article><b>04</b><h3>Delivery & support</h3><p>We deliver high-quality solutions on time and provide ongoing support if needed.</p><p>From deployment to maintenance, you’re covered.</p></article></div><div class="process-cta"><div><small>Free · 40 minutes · No commitment</small><h3>Let’s find the clearest path for your project.</h3><p>Leave the call knowing what to build, which technologies fit, and how we can help.</p></div><a href={bookCallUrl} target="_blank" rel="noopener">Book a call <span>↗</span></a></div></section>

    <section class="contact" id="contact">
      <div class="contact-main">
        <div class="eyebrow"><span></span> Have a map in mind?</div>
        <h2>Let’s put it<br/><em>on the map.</em></h2>
        <a class="circle-link" href="/contact-us">Start a<br/>project <i>↗</i></a>
      </div>
      <div class="client-trust" aria-label="Selected clients">
        <div class="client-trust-row">
          <a href="https://www.geoapify.com/" target="_blank" rel="noopener" aria-label="Geoapify"><img src="/images/clients/geoapify.svg" alt="Geoapify" loading="lazy"/></a>
          <a href="https://www.greenpeace.org/" target="_blank" rel="noopener" aria-label="Greenpeace"><img src="/images/clients/greenpeace.svg" alt="Greenpeace" loading="lazy"/></a>
          <a href="https://izi.travel/en" target="_blank" rel="noopener" aria-label="izi.TRAVEL"><img src="/images/clients/izi-travel.svg" alt="izi.TRAVEL" loading="lazy"/></a>
          <a href="https://postplatforms.org/" target="_blank" rel="noopener" aria-label="Post Platforms"><img src="/images/clients/postplatforms.svg" alt="Post Platforms" loading="lazy"/></a>
        </div>
        <a class="client-trust-more" href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener">and others trust us <span>↗</span></a>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="footer-brand"><a class="logo" href="/" aria-label="time2map — home"><img src="/images/logo.svg" alt="time2map"/></a><p>Maps and GIS solutions,<br/>built by specialists.</p></div>
    <div class="footer-details"><p>Barcelona, Spain</p><p>VAT: ES Z2405174T</p></div>
    <nav class="footer-links" aria-label="Footer navigation"><a href="/contact-us">Contact us</a><a href="https://www.iubenda.com/privacy-policy/48336731" target="_blank" rel="noopener">Privacy Policy <span>↗</span></a><a href="/use-cases">Use cases</a></nav>
    <p class="footer-copyright">© 2026 time2map. All rights reserved</p>
  </footer>
  <script>
    const expertise = document.querySelector<HTMLElement>('#expertise');
    const skillCards = [...document.querySelectorAll<HTMLElement>('#expertise .skill-card')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const bentoMotion = window.matchMedia('(min-width: 801px) and (hover: hover) and (pointer: fine)');

    const proofSection = document.querySelector<HTMLElement>('.proof');
    const proofCards = [...document.querySelectorAll<HTMLElement>('.proof-card')];
    const proofStats = [...document.querySelectorAll<HTMLElement>('.proof-stat strong[data-count-to]')];

    const animateProofStat = (stat:HTMLElement, sequenceStartedAt:number) => {
      const target = Number(stat.dataset.countTo ?? 0);
      const suffix = stat.dataset.countSuffix ?? '';
      const duration = 800;

      const tick = (now:number) => {
        const progress = Math.min((now - sequenceStartedAt) / duration, 1);
        if (progress < 1) {
          const current = Math.min(target - 1, Math.floor(target * progress));
          stat.textContent = `${current}${suffix}`;
          requestAnimationFrame(tick);
        } else {
          stat.textContent = `${target}${suffix}`;
          stat.style.removeProperty('width');
        }
      };

      requestAnimationFrame(tick);
    };

    if (proofSection && proofCards.length && !reduceMotion.matches) {
      document.documentElement.classList.add('has-proof-motion');
      proofCards.forEach((card, index) => card.style.setProperty('--proof-index', String(index)));
      proofStats.forEach((stat) => {
        stat.style.width = `${Math.ceil(stat.getBoundingClientRect().width)}px`;
        stat.textContent = `0${stat.dataset.countSuffix ?? ''}`;
      });
      const proofObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        proofSection.classList.add('is-visible');
        const sequenceStartedAt = performance.now();
        proofStats.forEach((stat) => animateProofStat(stat, sequenceStartedAt));
        window.setTimeout(() => proofSection.classList.add('is-settled'), 1050);
        observer.disconnect();
      }, { threshold:.18, rootMargin:'0px 0px -8% 0px' });
      proofObserver.observe(proofSection);
    } else {
      proofSection?.classList.add('is-visible', 'is-settled');
    }

    if (expertise && skillCards.length && !reduceMotion.matches && bentoMotion.matches) {
      document.documentElement.classList.add('has-bento-motion');
      skillCards.forEach((card, cardIndex) => {
        card.style.setProperty('--card-index', String(cardIndex));
        card.querySelectorAll<HTMLElement>('.map-art i,.signal i,.terrain-art i,.nodes i,.design-art i').forEach((node, nodeIndex) => {
          node.style.setProperty('--node-index', String(nodeIndex));
        });
        const art = card.matches('.card-wide,.card-tall')
          ? card.querySelector<HTMLElement>('.map-art,.terrain-art,.nodes,.code-art,.contours,.skill-visual')
          : null;
        let parallaxFrame = 0;
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
          card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
          if (!art) return;
          const x = (event.clientX - bounds.left) / bounds.width - .5;
          const y = (event.clientY - bounds.top) / bounds.height - .5;
          cancelAnimationFrame(parallaxFrame);
          parallaxFrame = requestAnimationFrame(() => {
            card.classList.add('is-parallax-active');
            art.style.translate = `${x * 10}px ${y * 8}px`;
          });
        }, { passive:true });
        card.addEventListener('pointerleave', () => {
          cancelAnimationFrame(parallaxFrame);
          if (!art) return;
          art.style.translate = '0 0';
          window.setTimeout(() => card.classList.remove('is-parallax-active'), 200);
        }, { passive:true });
      });

      const expertiseObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        expertise.classList.add('is-visible');
        window.setTimeout(() => {
          expertise.classList.add('is-settled');
          document.documentElement.classList.remove('has-bento-motion');
        }, 1300);
        observer.disconnect();
      }, { threshold:.08, rootMargin:'0px 0px -8% 0px' });
      expertiseObserver.observe(expertise);
    } else {
      expertise?.classList.add('is-visible');
    }

    const device = document.querySelector('#device');
    const wrap = document.querySelector('.device-wrap');
    wrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=wrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; device.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    wrap?.addEventListener('pointerleave',()=>device.style.transform='rotateY(-8deg) rotateX(5deg)');
    const audioSlides = document.querySelector<HTMLElement>('[data-audio-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-audio-slide]').forEach((button) => button.addEventListener('click', () => {
      if (audioSlides) audioSlides.style.transform = `translateX(-${Number(button.dataset.audioSlide) * 100}%)`;
      document.querySelectorAll('[data-audio-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const recycleDevice = document.querySelector<HTMLElement>('#recycle-device');
    const recycleWrap = document.querySelector<HTMLElement>('.recycle-device-wrap');
    recycleWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=recycleWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(recycleDevice) recycleDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    recycleWrap?.addEventListener('pointerleave',()=>{ if(recycleDevice) recycleDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const recycleSlides = document.querySelector<HTMLElement>('[data-recycle-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-recycle-slide]').forEach((button) => button.addEventListener('click', () => {
      if (recycleSlides) recycleSlides.style.transform = `translateX(-${Number(button.dataset.recycleSlide) * 100}%)`;
      document.querySelectorAll('[data-recycle-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));
    const airportDevice = document.querySelector<HTMLElement>('#airport-device');
    const airportWrap = document.querySelector<HTMLElement>('.airport-device-wrap');
    airportWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=airportWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(airportDevice) airportDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    airportWrap?.addEventListener('pointerleave',()=>{ if(airportDevice) airportDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const airportSlides = document.querySelector<HTMLElement>('[data-airport-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-airport-slide]').forEach((button) => button.addEventListener('click', () => {
      if (airportSlides) airportSlides.style.transform = `translateX(-${Number(button.dataset.airportSlide) * 100}%)`;
      document.querySelectorAll('[data-airport-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const enableSwipe = (track: HTMLElement | null, buttonSelector: string) => {
      if (!track) return;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>(buttonSelector)];
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;
      track.addEventListener('touchstart', (event) => {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        deltaX = 0;
        deltaY = 0;
      }, { passive:true });
      track.addEventListener('touchmove', (event) => {
        deltaX = event.touches[0].clientX - startX;
        deltaY = event.touches[0].clientY - startY;
        if (Math.abs(deltaX) > Math.abs(deltaY)) event.preventDefault();
      }, { passive:false });
      track.addEventListener('touchend', (event) => {
        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        event.preventDefault();
        const activeIndex = Math.max(0, buttons.findIndex((button) => button.classList.contains('is-active')));
        const nextIndex = Math.min(buttons.length - 1, Math.max(0, activeIndex + (deltaX < 0 ? 1 : -1)));
        buttons[nextIndex]?.click();
      }, { passive:false });
    };
    enableSwipe(audioSlides, '[data-audio-slide]');
    enableSwipe(recycleSlides, '[data-recycle-slide]');
    enableSwipe(airportSlides, '[data-airport-slide]');

    const deviceWraps = document.querySelectorAll<HTMLElement>('.cesium .device-wrap');
    let expandedWrap: HTMLElement | null = null;
    const setExpanded = (wrap: HTMLElement, expanded: boolean) => {
      const update = () => {
        wrap.classList.toggle('is-expanded', expanded);
        wrap.querySelector<HTMLElement>('.device')?.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('preview-open', expanded);
        expandedWrap = expanded ? wrap : null;
      };
      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(update);
      else update();
    };
    deviceWraps.forEach((deviceWrap, index) => {
      const preview = deviceWrap.querySelector<HTMLElement>('.device');
      if (!preview) return;
      preview.dataset.previewDevice = String(index + 1);
      preview.tabIndex = 0;
      preview.setAttribute('role', 'button');
      preview.setAttribute('aria-label', 'Open project preview fullscreen');
      preview.setAttribute('aria-expanded', 'false');
      const close = document.createElement('button');
      close.className = 'preview-close';
      close.type = 'button';
      close.setAttribute('aria-label', 'Close fullscreen preview');
      close.textContent = '×';
      deviceWrap.append(close);
      const open = () => { if (!deviceWrap.classList.contains('is-expanded')) setExpanded(deviceWrap, true); };
      preview.addEventListener('click', open);
      preview.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
      close.addEventListener('click', (event) => { event.stopPropagation(); setExpanded(deviceWrap, false); preview.focus(); });
      deviceWrap.addEventListener('click', (event) => { if (deviceWrap.classList.contains('is-expanded') && event.target === deviceWrap) setExpanded(deviceWrap, false); });
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && expandedWrap) setExpanded(expandedWrap, false); });

    const projectGrid = document.querySelector<HTMLElement>('[data-project-grid]');
    const projectShowcase = document.querySelector<HTMLElement>('.project-showcase');
    const projectTiles = [...document.querySelectorAll<HTMLElement>('[data-project-grid] [data-project]')];
    if (projectShowcase && projectTiles.length && !reduceMotion.matches) {
      document.documentElement.classList.add('has-project-motion');
      projectTiles.forEach((tile, index) => tile.style.setProperty('--project-index', String(index)));
      const projectObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        projectShowcase.classList.add('is-visible');
        window.setTimeout(() => projectShowcase.classList.add('is-settled'), 1100);
        observer.disconnect();
      }, { threshold:.12, rootMargin:'0px 0px -8% 0px' });
      projectObserver.observe(projectShowcase);
    } else {
      projectShowcase?.classList.add('is-visible', 'is-settled');
    }
    const lightbox = document.createElement('div');
    lightbox.className = 'project-lightbox';
    lightbox.setAttribute('role', 'dialog');
    lightbox.setAttribute('aria-modal', 'true');
    lightbox.setAttribute('aria-label', 'Case study screenshots');
    lightbox.innerHTML = '<button class="project-lightbox-close" type="button" aria-label="Close fullscreen case preview">×</button><button class="gallery-arrow gallery-prev" type="button" data-lightbox-dir="-1" aria-label="Previous screenshot">←</button><div class="project-lightbox-stage"></div><button class="gallery-arrow gallery-next" type="button" data-lightbox-dir="1" aria-label="Next screenshot">→</button>';
    document.body.append(lightbox);
    const lightboxStage = lightbox.querySelector<HTMLElement>('.project-lightbox-stage');
    const lightboxClose = lightbox.querySelector<HTMLButtonElement>('.project-lightbox-close');
    let fullscreenProject: HTMLElement | null = null;
    const setProjectFullscreen = (tile: HTMLElement | null, open: boolean) => {
      if (!lightboxStage) return;
      if (open && tile) {
        const source = tile.querySelector<HTMLElement>('.project-gallery');
        tile.setAttribute('aria-expanded', 'true');
        lightboxStage.replaceChildren();
        source?.querySelectorAll('img').forEach((image) => lightboxStage.append(image.cloneNode(true)));
        const hasSlides = lightboxStage.childElementCount > 1;
        lightbox.classList.toggle('has-slides', hasSlides);
        lightbox.classList.add('is-open');
        document.body.classList.add('project-preview-open');
        fullscreenProject = tile;
        requestAnimationFrame(() => {
          if (!source) return;
          const ratio = source.scrollWidth ? source.scrollLeft / source.scrollWidth : 0;
          lightboxStage.scrollLeft = ratio * lightboxStage.scrollWidth;
          lightboxClose?.focus();
        });
      } else {
        lightbox.classList.remove('is-open', 'has-slides');
        document.body.classList.remove('project-preview-open');
        lightboxStage.replaceChildren();
        fullscreenProject?.setAttribute('aria-expanded', 'false');
        fullscreenProject?.focus();
        fullscreenProject = null;
      }
    };
    const projectCounter = document.querySelector<HTMLElement>('[data-project-counter]');
    const projectPrev = document.querySelector<HTMLButtonElement>('[data-project-prev]');
    const projectNext = document.querySelector<HTMLButtonElement>('[data-project-next]');
    let currentProjectIndex = 0;
    let projectScrollFrame = 0;
    let projectDidDrag = false;
    let projectPointerId: number | null = null;
    let projectDragStartX = 0;
    let projectDragStartScroll = 0;

    const setCurrentProject = (index: number) => {
      currentProjectIndex = Math.min(projectTiles.length - 1, Math.max(0, index));
      projectTiles.forEach((tile, tileIndex) => {
        const current = tileIndex === currentProjectIndex;
        tile.classList.toggle('is-current', current);
        tile.setAttribute('aria-current', String(current));
      });
      if (projectCounter) projectCounter.textContent = `${String(currentProjectIndex + 1).padStart(2, '0')} / ${String(projectTiles.length).padStart(2, '0')}`;
      if (projectPrev) projectPrev.disabled = currentProjectIndex === 0;
      if (projectNext) projectNext.disabled = currentProjectIndex === projectTiles.length - 1;
    };

    const scrollToProject = (index: number, behavior: ScrollBehavior = 'smooth') => {
      if (!projectGrid) return;
      const nextIndex = Math.min(projectTiles.length - 1, Math.max(0, index));
      const tile = projectTiles[nextIndex];
      if (!tile) return;
      setCurrentProject(nextIndex);
      const gridBounds = projectGrid.getBoundingClientRect();
      const tileBounds = tile.getBoundingClientRect();
      const centeredLeft = projectGrid.scrollLeft + tileBounds.left + tileBounds.width / 2 - gridBounds.left - projectGrid.clientWidth / 2;
      projectGrid.scrollTo({ left:centeredLeft, behavior:reduceMotion.matches ? 'auto' : behavior });
    };

    const updateProjectFromScroll = () => {
      projectScrollFrame = 0;
      if (!projectGrid) return;
      const center = projectGrid.getBoundingClientRect().left + projectGrid.clientWidth / 2;
      let closestIndex = 0;
      let closestDistance = Number.POSITIVE_INFINITY;
      projectTiles.forEach((tile, index) => {
        const bounds = tile.getBoundingClientRect();
        const distance = Math.abs(bounds.left + bounds.width / 2 - center);
        if (distance < closestDistance) { closestDistance = distance; closestIndex = index; }
      });
      if (closestIndex !== currentProjectIndex) setCurrentProject(closestIndex);
    };

    projectPrev?.addEventListener('click', () => scrollToProject(currentProjectIndex - 1));
    projectNext?.addEventListener('click', () => scrollToProject(currentProjectIndex + 1));
    projectGrid?.addEventListener('scroll', () => {
      if (!projectScrollFrame) projectScrollFrame = requestAnimationFrame(updateProjectFromScroll);
    }, { passive:true });
    projectGrid?.addEventListener('pointerdown', (event) => {
      if (event.pointerType !== 'mouse' || event.button !== 0 || (event.target as HTMLElement).closest('button')) return;
      projectPointerId = event.pointerId;
      projectDragStartX = event.clientX;
      projectDragStartScroll = projectGrid.scrollLeft;
      projectDidDrag = false;
    });
    projectGrid?.addEventListener('pointermove', (event) => {
      if (projectPointerId !== event.pointerId) return;
      const distance = event.clientX - projectDragStartX;
      if (!projectDidDrag && Math.abs(distance) > 5) {
        projectDidDrag = true;
        projectGrid.classList.add('is-dragging');
        projectGrid.setPointerCapture(event.pointerId);
      }
      if (!projectDidDrag) return;
      projectGrid.scrollLeft = projectDragStartScroll - distance;
    });
    const finishProjectDrag = (event: PointerEvent) => {
      if (!projectGrid || projectPointerId !== event.pointerId) return;
      const didDrag = projectDidDrag;
      projectGrid.classList.remove('is-dragging');
      if (projectGrid.hasPointerCapture(event.pointerId)) projectGrid.releasePointerCapture(event.pointerId);
      projectPointerId = null;
      if (didDrag) {
        updateProjectFromScroll();
        scrollToProject(currentProjectIndex);
        window.setTimeout(() => { projectDidDrag = false; }, 0);
      }
    };
    projectGrid?.addEventListener('pointerup', finishProjectDrag);
    projectGrid?.addEventListener('pointercancel', finishProjectDrag);
    projectGrid?.addEventListener('dragstart', (event) => event.preventDefault());

    projectTiles.forEach((tile, tileIndex) => {
      tile.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('button')) return;
        if (projectDidDrag) return;
        scrollToProject(tileIndex, 'auto');
        setProjectFullscreen(tile, true);
      });
      tile.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          const direction = event.key === 'ArrowLeft' ? -1 : 1;
          scrollToProject(tileIndex + direction);
          projectTiles[Math.min(projectTiles.length - 1, Math.max(0, tileIndex + direction))]?.focus();
          return;
        }
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); scrollToProject(tileIndex, 'auto'); setProjectFullscreen(tile, true); }
      });
      const gallery = tile.querySelector<HTMLElement>('.project-gallery');
      tile.querySelectorAll<HTMLButtonElement>('[data-gallery-dir]').forEach((arrow) => arrow.addEventListener('click', (event) => {
        event.stopPropagation();
        gallery?.scrollBy({ left: Number(arrow.dataset.galleryDir) * (gallery.clientWidth || 1), behavior: 'smooth' });
      }));
    });
    setCurrentProject(0);
    lightboxClose?.addEventListener('click', () => setProjectFullscreen(null, false));
    lightbox.addEventListener('click', (event) => { if (event.target === lightbox) setProjectFullscreen(null, false); });
    lightbox.querySelectorAll<HTMLButtonElement>('[data-lightbox-dir]').forEach((arrow) => arrow.addEventListener('click', (event) => {
      event.stopPropagation();
      lightboxStage?.scrollBy({ left: Number(arrow.dataset.lightboxDir) * (lightboxStage.clientWidth || 1), behavior: 'smooth' });
    }));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && fullscreenProject) setProjectFullscreen(null, false); });
  </script>
</body></html>
