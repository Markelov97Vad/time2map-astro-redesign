---
import '../styles/global.css';
import '../styles/palette.css';

const bookCallUrl = 'https://cal.com/alexander-semenov-uqwtme/40-min-call-with-alex-from-time2map';
const demoVideoEmbedUrl = 'https://player.vimeo.com/video/1178497009?autoplay=1&muted=1&loop=1&background=1&playsinline=1&dnt=1';
const demoVideoPoster = '/images/hero-poster.webp';
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Time2map redesign concept"/><title>time2map — maps that move business</title></head>
<body>
  <header class="nav"><a class="logo" href="#" aria-label="time2map — home"><img src="/images/logo.svg" alt="time2map"/></a><nav><a class="nav-link" href="#expertise">Expertise</a><a class="nav-link" href="#work">Work</a><a class="nav-link" href="#process">Process</a><details class="lab-nav"><summary>LAB <span class="lab-chevron" aria-hidden="true"><i></i></span></summary><div class="lab-dropdown"><a href="/lab/time-2-route"><div class="lab-card-meta"><small>July 2026</small><small>3 min read</small></div><strong>Time2Route</strong><span>A map-first planner for walking and cycling — with places, stops, elevation, and shareable routes.</span><em>Explore the project ↗</em></a><a href="/lab/barcelona-crime-map"><div class="lab-card-meta"><small>May 2026</small><small>8 min read</small></div><strong>Barcelona Crime Map</strong><span>Safety analysis across Catalunya’s 59 police zones, benchmarked against Spain with trends from 2019–2025.</span><em>Explore the research ↗</em></a></div></details></nav><a class="pill pill-accent" href={bookCallUrl} target="_blank" rel="noopener">Book a call <i>↗</i></a></header>
  <main>
    <section class="hero">
      <h1>Maps and GIS solutions<br/><em>for the real world</em></h1>
      <p>We design and build interactive maps, geospatial platforms, and data-driven applications for organizations worldwide.</p>
      <div class="hero-actions"><a class="text-link" href="#work">Explore our work ↓</a></div>
      <div class="map-hero" aria-hidden="true">
        <div class="hero-globe"><img src="/images/globe-light.png" alt="" /></div>
        <img class="hero-marker" src="/images/map-pin.svg" alt="" />
      </div>
    </section>

    <section class="proof" aria-labelledby="proof-title">
      <header class="proof-header">
        <div class="eyebrow"><span></span> At a glance</div>
        <div class="proof-heading">
          <h2 id="proof-title">Proof,<br/><em>not promises</em></h2>
          <p>Senior geospatial expertise, measured in delivered work and client trust.</p>
        </div>
      </header>

      <div class="proof-grid">
        <a class="proof-card" href="#work">
          <div class="proof-card-top">
            <span class="proof-index">01</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/projects-check.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="10" data-count-suffix="+" aria-label="10+">10+</strong><span>projects<br/>delivered</span></div>
          <span class="proof-link">Explore our work <i aria-hidden="true">↗</i></span>
        </a>

        <a class="proof-card proof-card-featured" href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener">
          <div class="proof-card-top">
            <span class="proof-index">02</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/job-success-large.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="100" data-count-suffix="%" aria-label="100%">100%</strong><span>Upwork Job<br/>Success Score</span></div>
          <span class="proof-link">View Upwork profile <i aria-hidden="true">↗</i></span>
        </a>

        <a class="proof-card" href="#expertise">
          <div class="proof-card-top">
            <span class="proof-index">03</span>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/geospatial.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="6" aria-label="6">6</strong><span>years of geospatial<br/>expertise</span></div>
          <span class="proof-link">Explore expertise <i aria-hidden="true">↓</i></span>
        </a>
      </div>
    </section>

    <!-- <section class="manifest"><p>Maps shouldn’t be a layer added at the end.</p><h2>They can be the product</h2></section> -->

    <section class="cesium audio-feature" id="work">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · izi.TRAVEL founders</div><h2>Audio Guides<br/>Mapping Platform</h2><p>Built a full-stack map platform powering <a href="https://tmatic.travel/" target="_blank" rel="noopener">tmatic.travel</a>. A CMS, responsive public map and partner API deliver audio tours and stories to travelers and cultural institutions worldwide.</p><p class="case-details">Angular and Mapbox power 2D, 3D and dedicated indoor museum modes. Java Spring and PostGIS keep content delivery seamless at global scale.</p><div class="case-metrics"><div class="metric"><b>20K+</b><span>audio tours<br/>worldwide</span></div><div class="metric"><b>500K+</b><span>stories across<br/>the platform</span></div></div><a class="case-link" href="https://tmatic.travel/" target="_blank" rel="noopener">Explore tmatic.travel ↗</a></div>
      <div class="device-wrap">
        <div class="device" id="device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="audio-slides" data-audio-slides><div class="device-screen"><div class="device-poster" style={`background-image:url('${demoVideoPoster}')`}></div><iframe src={demoVideoEmbedUrl} title="time2map demo video" allow="autoplay; fullscreen" data-cmp-ab="2"></iframe></div><img src="/images/audio-guides-1.webp" alt="Audio Guides public map view"/><img src="/images/audio-guides-2.webp" alt="Audio Guides content management system"/><img src="/images/audio-guides-3.webp" alt="Audio Guides mobile interface"/></div></div></div>
        <div class="screen-switcher" aria-label="Audio Guides video and screenshots"><button class="is-active" data-audio-slide="0" aria-label="Show demo video">01</button><button data-audio-slide="1" aria-label="Show screenshot 1">02</button><button data-audio-slide="2" aria-label="Show screenshot 2">03</button><button data-audio-slide="3" aria-label="Show screenshot 3">04</button></div>
      </div>
    </section>

    <section class="cesium recycle-feature" id="recyclemap">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Greenpeace</div><h2>Crowdmapping<br/>for Recycling</h2><p>Developed a crowdmapping platform for <a href="https://es.greenpeace.org/" target="_blank" rel="noopener">Greenpeace’s</a> Recyclemap project, enabling volunteers to add, update and moderate recycling and ZeroWaste locations across the country.</p><p class="case-details">Angular and Mapbox GL power mobile and desktop experiences. Python, PostGIS, Martin and H3 clustering process OSM data and provide scalable spatial queries for thousands of active users.</p><div class="case-metrics"><div class="metric"><b>Web + mobile</b><span>responsive mapping<br/>applications</span></div><div class="metric"><b>Live data</b><span>community-powered<br/>locations</span></div></div><a class="case-link" href="https://wastefreemap.com" target="_blank" rel="noopener">Explore Waste Free Map ↗</a></div>
      <div class="device-wrap recycle-device-wrap">
        <div class="device recycle-device" id="recycle-device"><div class="device-top"><span></span></div><div class="screen audio-screen recycle-screen"><div class="recycle-slides" data-recycle-slides><img src="/images/recycling-1.webp" alt="Recyclemap crowdmapping interface"/><img src="/images/recycling-2.webp" alt="Recycling point details"/><img src="/images/recycling-3.webp" alt="Recyclemap mobile interface"/></div></div></div>
        <div class="screen-switcher" aria-label="Recyclemap screenshots"><button class="is-active" data-recycle-slide="0" aria-label="Show screenshot 1">01</button><button data-recycle-slide="1" aria-label="Show screenshot 2">02</button><button data-recycle-slide="2" aria-label="Show screenshot 3">03</button></div>
      </div>
    </section>

    <section class="cesium airport-feature" id="airport-maps">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Global aviation</div><h2>Automated 300+<br/>Airport Maps</h2><p>Prepared more than 300 airport maps for <a href="https://www.airportmaps.com/" target="_blank" rel="noopener">airportmaps.com</a> in only 1.5 months, meeting a demanding global production schedule.</p><p class="case-details">Python scripts extracted and processed OSM and official airport POI data for terminals, entrances and roads. Automated styling reduced production time by 50%, while designers finalized accurate web maps and print-ready PDFs.</p><div class="case-metrics"><div class="metric"><b>300+</b><span>airport maps<br/>in production</span></div><div class="metric"><b>−50%</b><span>map production<br/>time</span></div></div><a class="case-link" href="https://www.airportmaps.com/" target="_blank" rel="noopener">Explore Airport Maps ↗</a></div>
      <div class="device-wrap airport-device-wrap">
        <div class="device airport-device" id="airport-device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="airport-slides" data-airport-slides><img src="/images/airport-maps-1.webp" alt="Automated airport map"/><img src="/images/airport-maps-2.webp" alt="Airport terminal map"/><img src="/images/airport-maps-3.webp" alt="Airport map production result"/></div></div></div>
        <div class="screen-switcher" aria-label="Airport Maps screenshots"><button class="is-active" data-airport-slide="0" aria-label="Show screenshot 1">01</button><button data-airport-slide="1" aria-label="Show screenshot 2">02</button><button data-airport-slide="2" aria-label="Show screenshot 3">03</button></div>
      </div>
    </section>

    <section class="project-showcase" id="more-cases" aria-labelledby="project-heading">
      <div class="project-intro"><div class="eyebrow"><span></span> More Time2map products</div><div class="project-intro-title"><h2 id="project-heading">More cases</h2><div class="project-carousel-controls"><span class="project-carousel-count" data-project-counter aria-live="polite">01 / 04</span></div></div></div>
      <div class="project-carousel-shell">
        <div class="project-grid project-carousel-track" data-project-grid data-active="" role="region" aria-roledescription="carousel" aria-label="Time2map case studies">
        <article class="project-tile project-one is-current" data-project="one" tabindex="0" role="button" aria-current="true" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/coal-mining.webp" alt="Coal mining safety monitoring platform"/><img src="/images/projects/coal-mining-2.webp" alt="Coal mine digital twin interface"/><img src="/images/projects/coal-mining-3.webp" alt="Coal mine realtime monitoring"/></div><span class="project-wash"></span><div class="project-copy"><small>Industrial safety · Realtime</small><h3>Coal Mining<br/>Safety Platform</h3><p class="project-description">A unified digital twin combining radar, gas detector, GPS and radio data into one dispatcher interface for faster incident response.</p><span class="project-tech">React · Java Spring · RabbitMQ · Kubernetes · PostGIS</span><span class="gallery-hint">Browse screens</span></div></article>
        <article class="project-tile project-two" data-project="two" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/ski.webp" alt="Offline ski resort map"/></div><span class="project-wash"></span><div class="project-copy"><small>Salt Lake City · Offline</small><h3>Ski Resort Maps<br/>with Offline Mode</h3><p class="project-description">Built a responsive map that keeps trails and resort details available in areas with poor connectivity, with automated lightweight raster tiles for mobile and desktop.</p><span class="project-tech">JavaScript · PHP · PWA · Mobile · Leaflet</span></div></article>
        <article class="project-tile project-three" data-project="three" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/land-certificates.webp" alt="Land certificate automation platform"/><img src="/images/projects/land-certificates-2.webp" alt="Land certificate parcel search"/><img src="/images/projects/land-certificates-3.webp" alt="Land certificate administration interface"/></div><span class="project-wash"></span><div class="project-copy"><small>United States · Automation</small><h3>Land Certificate<br/>Automation</h3><p class="project-description">An end-to-end platform that analyzes parcels against restricted zones and automatically generates PDF land certificates.</p><span class="project-tech">Python · React · QGIS Server · FastAPI · PDF</span><span class="gallery-hint">Browse screens</span></div></article>
        <article class="project-tile project-four" data-project="four" tabindex="0" role="button" aria-expanded="false"><div class="project-gallery"><img src="/images/projects/georeferencing.webp" alt="New York georeferencing project"/></div><span class="project-wash"></span><div class="project-copy"><small>NYC · Logistics</small><h3>Georeferencing<br/>Automation</h3><p class="project-description">Automated detection and normalization of inconsistent spatial reference systems across hundreds of GPS tracks, eliminating extensive manual correction.</p><span class="project-tech">QGIS · Georeferencing · Python</span></div></article>
        </div>
        <div class="project-carousel-nav" role="group" aria-label="Choose a case study">
          <button class="is-active" type="button" data-project-jump="0" aria-label="Show Coal Mining Safety Platform" aria-pressed="true"></button>
          <button type="button" data-project-jump="1" aria-label="Show Ski Resort Maps with Offline Mode" aria-pressed="false"></button>
          <button type="button" data-project-jump="2" aria-label="Show Land Certificate Automation" aria-pressed="false"></button>
          <button type="button" data-project-jump="3" aria-label="Show Georeferencing Automation" aria-pressed="false"></button>
        </div>
      </div>
    </section>

    <section class="expertise bento-section" id="expertise">
      <div class="bento-heading"><div class="eyebrow light"><span></span> What we do?</div><h2>Everything is spatial<br/><em>One senior team</em></h2></div>
      <div class="bento-grid">
        <article class="skill-card card-maps card-wide"><div class="skill-visual skill-visual-maps"><img src="/images/maps-card.png" alt="Interactive city map with points of interest, routes, zones, and layer controls" width="2244" height="701" loading="lazy" decoding="async"/></div><div><small>Maps & GIS Solutions</small><h3>Custom interactive maps</h3><p>Mapbox · MapLibre · Leaflet</p></div></article>
        <article class="skill-card card-mobile-app"><div class="mobile-app-visual" aria-hidden="true"><img src="/images/mobile-maps.png" alt="" width="1364" height="1153" loading="lazy" decoding="async"/></div><h3>Mobile map applications</h3><p>iOS · Android · cross-platform</p></article>
        <article class="skill-card card-cesium card-tall"><div class="skill-visual skill-visual-terrain"><img src="/images/3d-mount.png" alt="Detailed photorealistic 3D mountain terrain model" width="1363" height="1440" loading="lazy" decoding="async"/></div><div><h3>3D maps & terrain models</h3><p>Cesium · Deck.gl · Three.js</p></div></article>
        <article class="skill-card card-data card-wide"><div class="skill-visual skill-visual-postgis"><img src="/images/postGIS.png" alt="PostGIS database servers supporting layered digital maps" width="1536" height="1024" loading="lazy" decoding="async"/></div><div><h3>Tile servers & spatial databases</h3><p>GDB · PostGIS · Geoserver · QGIS Server · Titiler</p></div></article>
        <article class="skill-card card-mobile"><div class="mobile-phone" aria-hidden="true"><img src="/images/phone.png" alt="" width="1254" height="1254" loading="lazy" decoding="async"/></div><h3>Offline maps</h3><p>Maps that work beyond the network</p></article>
        <article class="skill-card card-cloud card-wide"><div class="cloud-pipeline" aria-hidden="true"><img src="/images/cicd-pipeline.png" alt="" width="2172" height="724" loading="lazy" decoding="async"/></div><div class="cloud-copy"><h3>CI/CD & cloud deployment</h3><p>Reliable releases at any scale</p></div></article>
        <article class="skill-card card-cad card-wide">
          <div class="cad-flow" role="img" aria-label="A DWG architectural model integrated into a GIS application">
            <div class="cad-flow-stage">
              <div class="cad-flow-source"><img src="/images/cad-model.png" alt="" width="1185" height="828" loading="lazy" decoding="async"/></div>
              <div class="cad-flow-result"><img class="cad-flow-target" src="/images/inter-gis.png" alt="" width="3310" height="1997" loading="lazy" decoding="async"/></div>
            </div>
          </div>
          <div class="cad-copy"><h3>CAD ↔ GIS integration</h3><p>Engineering drawings · spatial data · conversion</p></div>
        </article>
      </div>
      <div class="capability-group" aria-labelledby="capability-title">
        <div class="capability-group-head">
          <span>Supporting capabilities</span>
          <h3 id="capability-title">The disciplines behind every delivery</h3>
          <p>Senior expertise applied where the product needs it.</p>
        </div>
        <div class="capability-list">
          <article><span>01</span><div><h4>Frontend development</h4><p>React · Vue · Angular · responsive interfaces</p></div></article>
          <article><span>02</span><div><h4>UX / UI design</h4><p>Figma · prototypes · responsive design systems</p></div></article>
          <article><span>03</span><div><h4>Business + System Analysis</h4><p>Clear requirements, workflows, and product logic.</p></div></article>
          <article><span>04</span><div><h4>Backend development</h4><p>Python · Java · APIs · integrations</p></div></article>
          <article><span>05</span><div><h4>Quality Assurance</h4><p>Automated and manual testing across the delivery cycle.</p></div></article>
          <article><span>06</span><div><h4>Software Architecture</h4><p>Systems designed to scale, integrate, and evolve.</p></div></article>
          <article><span>07</span><div><h4>High-load systems</h4><p>Performance and resilience under real-world pressure.</p></div></article>
          <article><span>08</span><div><h4>Geodata preprocessing</h4><p>Cleaning · transformation · digitizing</p></div></article>
          <article><span>09</span><div><h4>Geospatial analysis &amp; visualization</h4><p>QGIS · ArcGIS · GDAL · FME</p></div></article>
          <article><span>10</span><div><h4>Web cartography</h4><p>Mapbox Studio · visual map systems</p></div></article>
        </div>
      </div>
    </section>

    <section class="technologies" id="technologies" aria-labelledby="technologies-title">
      <div class="technology-intro">
        <div class="eyebrow light"><span></span> Our toolkit</div>
        <h2 id="technologies-title">Built with the<br/> <em>right tools</em></h2>
        <p>A practical stack selected around the product, its users, and the scale it needs to reach.</p>
      </div>
      <div class="technology-map">
        <article class="technology-row">
          <div class="technology-label"><span>01</span><h3>Design</h3></div>
          <ul><li><i><img src="/images/tech/figma.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Figma</li><li><i><img src="/images/tech/adobe.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Adobe</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>02</span><h3>Frontend</h3></div>
          <ul><li><i><img src="/images/tech/react.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>React</li><li><i><img src="/images/tech/typescript.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>TypeScript</li><li><i><img src="/images/tech/angular.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Angular</li><li><i><img src="/images/tech/mapbox.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Mapbox GL JS</li><li><i><img src="/images/tech/cesium.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Cesium</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>03</span><h3>Backend</h3></div>
          <ul><li><i><img src="/images/tech/java.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Java</li><li><i><img src="/images/tech/python.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Python</li><li><i><img src="/images/tech/postgresql.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>PostgreSQL</li><li><i><img src="/images/tech/mysql.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>MySQL</li><li><i><img src="/images/tech/mongodb.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>MongoDB</li><li><i><img src="/images/tech/rabbitmq.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>RabbitMQ</li><li><i><img src="/images/tech/apisix.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>APISIX</li><li><i><img src="/images/tech/aws.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>AWS</li><li><i><img src="/images/tech/timescaledb.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>TimescaleDB</li><li><i><img src="/images/tech/keycloak.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Keycloak</li><li><i><img src="/images/tech/redis.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Redis</li><li><i><img src="/images/tech/elasticsearch.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Elasticsearch</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>04</span><h3>QA</h3></div>
          <ul><li><i><img src="/images/tech/cypress.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Cypress</li><li><i><img src="/images/tech/postman.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Postman</li><li><i><img src="/images/tech/charles-proxy.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Charles Proxy</li><li><i><img src="/images/tech/browserstack.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>BrowserStack</li><li><i><img src="/images/tech/jmeter.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>JMeter</li><li><i><img src="/images/tech/kibana.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Kibana</li><li><i><img src="/images/tech/qase.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Qase</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>05</span><h3>DevOps</h3></div>
          <ul><li><i><img src="/images/tech/kubernetes.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Kubernetes</li><li><i><img src="/images/tech/aws.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>AWS</li><li><i><img src="/images/tech/docker.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Docker</li><li><i><img src="/images/tech/ansible.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Ansible</li><li><i><img src="/images/tech/gitlab.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>GitLab</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>06</span><h3>Geoservices</h3></div>
