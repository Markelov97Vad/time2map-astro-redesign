<div class="t2r-app-modal" data-t2r-app-modal hidden>
  <div class="t2r-app-modal-backdrop" data-t2r-app-close></div>
  <div class="t2r-app-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="t2r-app-modal-title">
    <div class="t2r-app-modal-header">
      <div class="t2r-app-modal-title" id="t2r-app-modal-title">Time2Route preview</div>
      <div class="t2r-app-modal-actions">
        <button type="button" class="t2r-app-modal-close" data-t2r-app-close aria-label="Close preview">Close</button>
      </div>
    </div>
    <div class="t2r-app-modal-body">
      <iframe
        class="t2r-app-modal-frame"
        data-t2r-app-frame
        title="Time2Route app preview"
        loading="eager"
        referrerpolicy="strict-origin-when-cross-origin"
      ></iframe>
      <div class="t2r-app-modal-status" data-t2r-app-status>
        <strong>Loading preview…</strong><br/>
        The app is opening inside the modal.
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const page = document.getElementById('t2r-page');
    const flowWrap = document.querySelector('.t2r-route-flow-wrap');
    const flow = flowWrap?.querySelector('.t2r-route-flow');
    const wheelTrack = flow?.querySelector('.t2r-flow-wheel-track');
    const wheelViewport = flow?.querySelector('.t2r-flow-wheel-viewport');
    const flowSteps = document.querySelectorAll('.t2r-flow-step[data-target]');
    const sectionIds = [...flowSteps]
      .map((step) => step.getAttribute('data-target'))
      .filter(Boolean);
    const mobileWheelQuery = window.matchMedia('(max-width: 868px)');

    let stickyTop = 88;
    let fixed = false;
    let activeFlowId = '';
    let scrollPending = false;
    let wheelSyncLock = false;
    let wheelUserScrolling = false;
    let wheelProgrammaticScroll = false;
    let wheelSuppressClick = false;
    let wheelScrollEndTimer = 0;
    let wheelFramePending = 0;
    let appModalFallbackTimer = 0;
    let lastFocusedElement = null;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const appModal = document.querySelector('[data-t2r-app-modal]');
    const appModalFrame = appModal?.querySelector('[data-t2r-app-frame]');
    const appModalStatus = appModal?.querySelector('[data-t2r-app-status]');
    const appModalCloseControls = appModal?.querySelectorAll('[data-t2r-app-close]');

    const getIframePreviewUrl = (url) => {
      try {
        const previewUrl = new URL(url);
        if (!previewUrl.searchParams.has('hideReset')) {
          previewUrl.searchParams.set('hideReset', '1');
        }
        return previewUrl.toString();
      } catch {
        const joiner = url.includes('?') ? '&' : '?';
        return `${url}${joiner}hideReset=1`;
      }
    };

    const setAppModalStatus = (message, show = true) => {
      if (!(appModalStatus instanceof HTMLElement)) return;
      appModalStatus.hidden = !show;
      appModalStatus.innerHTML = message;
    };

    const closeAppModal = () => {
      if (!(appModal instanceof HTMLElement) || !(appModalFrame instanceof HTMLIFrameElement)) return;

      window.clearTimeout(appModalFallbackTimer);
      appModal.hidden = true;
      document.body.classList.remove('t2r-lock-scroll');
      page?.classList.remove('t2r-modal-open');
      appModalFrame.removeAttribute('src');
      setAppModalStatus('<strong>Loading preview…</strong><br/>The app is opening inside the modal.');
      if (lastFocusedElement instanceof HTMLElement) {
        lastFocusedElement.focus({ preventScroll: true });
      }
    };

    const openAppModal = (url, trigger) => {
      if (!(appModal instanceof HTMLElement) || !(appModalFrame instanceof HTMLIFrameElement)) {
        return;
      }

      lastFocusedElement = trigger instanceof HTMLElement ? trigger : document.activeElement;
      appModal.hidden = false;
      document.body.classList.add('t2r-lock-scroll');
      page?.classList.add('t2r-modal-open');
      setAppModalStatus('<strong>Loading preview…</strong><br/>The app is opening inside the modal.');

      appModalFrame.onload = () => {
        window.clearTimeout(appModalFallbackTimer);
        setAppModalStatus('', false);
      };

      appModalFrame.src = getIframePreviewUrl(url);
      appModalFallbackTimer = window.setTimeout(() => {
        setAppModalStatus('<strong>Preview is taking longer than expected.</strong><br/>If the app still does not appear, embedding may be blocked.');
      }, 1800);
    };

    appModalCloseControls?.forEach((control) => {
      control.addEventListener('click', closeAppModal);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && appModal instanceof HTMLElement && !appModal.hidden) {
        closeAppModal();
      }
    });

    document.querySelectorAll('a[href*="route.time2map.com"]').forEach((link) => {
      link.addEventListener('click', (event) => {
        if (!(link instanceof HTMLAnchorElement)) return;

        const shouldPreviewInModal =
          link.classList.contains('t2r-shot-link')
          || link.closest('.t2r-shot-grid');

        if (!shouldPreviewInModal) return;

        event.preventDefault();
        openAppModal(link.href, link);
      });
    });

    const isMobileWheel = () => mobileWheelQuery.matches;
    const isMobileWheelActive = () => isMobileWheel() && flow?.classList.contains('is-fixed');

    const resetMobileListStyles = () => {
      flowSteps.forEach((step) => {
        if (!(step instanceof HTMLElement)) return;
        step.style.transform = '';
        step.style.opacity = '';
      });

      if (wheelTrack instanceof HTMLElement) {
        wheelTrack.scrollTop = 0;
      }
    };

    const activateMobileWheel = () => {
      if (!isMobileWheelActive()) return;

      const activeStep =
        [...flowSteps].find((step) => step.getAttribute('data-target') === activeFlowId) || flowSteps[0];

      if (activeStep instanceof HTMLElement) {
        scrollWheelToStep(activeStep, 'auto');
      } else {
        scheduleWheelItemTransforms();
      }
    };

    const getWheelItemHeight = () => {
      if (!(wheelViewport instanceof HTMLElement)) return 32;
      const value = getComputedStyle(wheelViewport).getPropertyValue('--t2r-wheel-item').trim();
      return Number.parseFloat(value) || 32;
    };

    const getWheelTrackCenter = () => {
      if (!(wheelTrack instanceof HTMLElement) || !(wheelViewport instanceof HTMLElement)) return 0;
      return wheelTrack.scrollTop + wheelViewport.offsetHeight / 2;
    };

    const getStepTrackCenter = (step) => {
      if (!(step instanceof HTMLElement)) return 0;
      return step.offsetTop + step.offsetHeight / 2;
    };

    const alignWheelToStep = (step, behavior = 'auto', onComplete) => {
      if (
        !isMobileWheelActive()
        || !(step instanceof HTMLElement)
        || !(wheelTrack instanceof HTMLElement)
        || !(wheelViewport instanceof HTMLElement)
      ) {
        onComplete?.();
        return;
      }

      wheelProgrammaticScroll = true;
      const targetScrollTop = getStepTrackCenter(step) - wheelViewport.offsetHeight / 2;

      wheelTrack.scrollTo({
        top: Math.max(0, targetScrollTop),
        behavior: prefersReducedMotion ? 'auto' : behavior,
      });
      scheduleWheelItemTransforms();

      window.setTimeout(() => {
        wheelProgrammaticScroll = false;
        scheduleWheelItemTransforms();
        onComplete?.();
      }, prefersReducedMotion || behavior === 'auto' ? 48 : 340);
    };

    const updateWheelItemTransforms = () => {
      if (!isMobileWheelActive() || !(wheelViewport instanceof HTMLElement) || !(wheelTrack instanceof HTMLElement)) return;

      const itemHeight = getWheelItemHeight();
      const trackCenter = getWheelTrackCenter();

      flowSteps.forEach((step) => {
        if (!(step instanceof HTMLElement)) return;

        const dist = (getStepTrackCenter(step) - trackCenter) / itemHeight;
        const absDist = Math.min(Math.abs(dist), 2.4);

        if (prefersReducedMotion) {
          step.style.transform = '';
          step.style.opacity = absDist < 0.55 ? '0.88' : '0.28';
          return;
        }

        const scale = absDist < 0.35
          ? 1
          : Math.max(0.62, 1 - absDist * 0.15);
        const opacity = absDist < 0.35
          ? 0.92
          : Math.max(0.16, 0.78 - absDist * 0.28);
        const rotateX = dist * -8;
        step.style.transform = `translate3d(0, 0, 0) rotateX(${rotateX}deg) scale(${scale})`;
        step.style.opacity = String(opacity);
      });
    };

    const scheduleWheelItemTransforms = () => {
      if (wheelFramePending) return;

      wheelFramePending = window.requestAnimationFrame(() => {
        wheelFramePending = 0;
        updateWheelItemTransforms();
      });
    };

    const getCenteredFlowStep = () => {
      if (!(wheelTrack instanceof HTMLElement)) return null;

      const trackCenter = getWheelTrackCenter();
      let closest = null;
      let closestDist = Infinity;

      flowSteps.forEach((step) => {
        if (!(step instanceof HTMLElement)) return;

        const dist = Math.abs(getStepTrackCenter(step) - trackCenter);
        if (dist < closestDist) {
          closestDist = dist;
          closest = step;
        }
      });

      return closest;
    };

    const snapWheelToNearestStep = (onComplete, behavior = 'auto') => {
      if (!(wheelTrack instanceof HTMLElement) || !(wheelViewport instanceof HTMLElement)) {
        onComplete?.();
        return;
      }

      const centered = getCenteredFlowStep();
      if (!(centered instanceof HTMLElement)) {
        onComplete?.();
        return;
      }

      const trackCenter = getWheelTrackCenter();
      if (Math.abs(trackCenter - getStepTrackCenter(centered)) <= 1) {
        scheduleWheelItemTransforms();
        onComplete?.();
        return;
      }

      alignWheelToStep(centered, behavior, onComplete);
    };

    const finishWheelInteraction = () => {
      if (!isMobileWheelActive() || !wheelUserScrolling) return;

      window.clearTimeout(wheelScrollEndTimer);
      wheelScrollEndTimer = 0;
      wheelUserScrolling = false;

      snapWheelToNearestStep(() => {
        scheduleWheelItemTransforms();
        wheelSuppressClick = true;
        window.setTimeout(() => {
          wheelSuppressClick = false;
        }, 280);
        wheelSyncLock = false;
      }, 'auto');
    };

    const handleWheelScroll = () => {
      if (!isMobileWheelActive()) return;

      scheduleWheelItemTransforms();

      if (wheelProgrammaticScroll) return;

      if (!wheelUserScrolling) {
        wheelUserScrolling = true;
        wheelSyncLock = true;
      }

      window.clearTimeout(wheelScrollEndTimer);
      wheelScrollEndTimer = window.setTimeout(finishWheelInteraction, 420);
    };

    const scrollWheelToStep = (step, behavior = 'smooth', onComplete) => {
      alignWheelToStep(step, behavior, onComplete);
    };

    const initMobileWheel = () => {
      if (!isMobileWheel()) {
        resetMobileListStyles();
        return;
      }

      if (flow?.classList.contains('is-fixed')) {
        activateMobileWheel();
      } else {
        resetMobileListStyles();
      }
    };

    const getScrollTriggerY = () => {
      resolveStickyTop();
      const flowBarGap = 20;
      const flowHeight =
        flow instanceof HTMLElement && flow.classList.contains('is-fixed') ? flow.offsetHeight : 0;
      const minTrigger = stickyTop + flowHeight + flowBarGap;
      const zoneTrigger = window.innerHeight * 0.42;
      return Math.max(minTrigger, zoneTrigger);
    };

    const getActiveSectionFromScroll = () => {
      const triggerY = getScrollTriggerY();
      let fallbackId = sectionIds[0];

      for (const id of sectionIds) {
        const section = document.getElementById(id);
        if (!section) continue;

        const rect = section.getBoundingClientRect();
        if (rect.top <= triggerY) {
          fallbackId = id;
        }
        if (rect.top <= triggerY && rect.bottom > triggerY) {
          return id;
        }
      }

      return fallbackId;
    };

    const waitForPageScrollEnd = (callback, delay = 160) => {
      let timer = 0;

      const finish = () => {
        window.removeEventListener('scroll', onScroll);
        callback();
      };

      const onScroll = () => {
        window.clearTimeout(timer);
        timer = window.setTimeout(finish, delay);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      timer = window.setTimeout(finish, delay);
    };

    const scrollToSection = (section) => {
      const top = section.getBoundingClientRect().top + window.scrollY - getScrollTriggerY();

      window.scrollTo({
        top: Math.max(0, top),
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
      });
    };

    const resolveStickyTop = () => {
      if (!flow) return;

      const header = document.querySelector('header');
      const headerHeight = header instanceof HTMLElement ? header.getBoundingClientRect().height : 0;
      stickyTop = Math.round(headerHeight + 10);
      flow.style.setProperty('--t2r-sticky-top', `${stickyTop}px`);
    };

    const getScrollOffset = () => getScrollTriggerY();

    const scrollToSectionHeading = (section) => {
      scrollToSection(section);
    };

    const updateFlowStickyState = () => {
      if (!flowWrap || !flow) return;

      resolveStickyTop();
      const rect = flowWrap.getBoundingClientRect();
      const shouldFix = rect.top <= stickyTop;

      if (shouldFix && !fixed) {
        flowWrap.style.height = `${flow.offsetHeight}px`;
        flow.classList.add('is-fixed');
        fixed = true;
        if (isMobileWheel()) {
          window.requestAnimationFrame(() => activateMobileWheel());
        }
        return;
      }

      if (!shouldFix && fixed) {
        flow.classList.remove('is-fixed');
        flowWrap.style.height = '';
        fixed = false;
        if (isMobileWheel()) {
          resetMobileListStyles();
        }
      }
    };

    const setActiveFlowStep = (targetId, options = {}) => {
      if (!targetId || (targetId === activeFlowId && !options.force)) return;

      activeFlowId = targetId;

      flowSteps.forEach((step) => {
        const isActive = step.getAttribute('data-target') === targetId;
        step.classList.toggle('active', isActive);
        step.querySelector('.t2r-flow-dot')?.classList.toggle('active', isActive);
        step.setAttribute('aria-current', isActive ? 'true' : 'false');
      });

      const activeStep = [...flowSteps].find((step) => step.getAttribute('data-target') === targetId);
      if (activeStep && !options.skipWheelScroll) {
        if (isMobileWheelActive()) {
          scrollWheelToStep(activeStep);
        } else if (flow?.classList.contains('is-fixed')) {
          activeStep.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            inline: 'center',
            block: 'nearest',
          });
        }
      }

      scheduleWheelItemTransforms();
    };

    const updateActiveFlowFromScroll = () => {
      if (!sectionIds.length || wheelSyncLock || wheelUserScrolling) return;

      setActiveFlowStep(getActiveSectionFromScroll());
    };

    const handleScroll = () => {
      if (scrollPending) return;

      scrollPending = true;
      requestAnimationFrame(() => {
        updateFlowStickyState();
        updateActiveFlowFromScroll();
        scrollPending = false;
      });
    };

    const handleResize = () => {
      updateFlowStickyState();
      updateActiveFlowFromScroll();
      initMobileWheel();
    };

    updateFlowStickyState();
    updateActiveFlowFromScroll();
    initMobileWheel();
    window.addEventListener('scroll', handleScroll, { passive: true });
    window.addEventListener('resize', handleResize);
    wheelTrack?.addEventListener('scroll', handleWheelScroll, { passive: true });
    if ('onscrollend' in window && wheelTrack) {
      wheelTrack.addEventListener('scrollend', finishWheelInteraction, { passive: true });
    }
    mobileWheelQuery.addEventListener('change', initMobileWheel);

    flowSteps.forEach((step) => {
      const targetId = step.getAttribute('data-target');
      if (!targetId) return;

      const navigate = () => {
        if (wheelSuppressClick) return;

        const target = document.getElementById(targetId);
        if (!target) return;

        const stepEl = [...flowSteps].find((item) => item.getAttribute('data-target') === targetId);
        if (!(stepEl instanceof HTMLElement)) return;

        wheelSyncLock = true;
        setActiveFlowStep(targetId, { skipWheelScroll: true, force: true });
        scrollToSectionHeading(target);
        waitForPageScrollEnd(() => {
          alignWheelToStep(stepEl, 'auto', () => {
            setActiveFlowStep(targetId, { skipWheelScroll: true, force: true });
            wheelSyncLock = false;
          });
        }, prefersReducedMotion ? 80 : 180);
      };

      step.addEventListener('click', navigate);
      step.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          navigate();
        }
      });
    });

    const shots = document.querySelectorAll('[data-t2r-shot]');

    shots.forEach((shot) => {
      const video = shot.querySelector('.t2r-shot-video');
      const hotspots = shot.querySelectorAll('.t2r-hotspot');

      if (!video || !hotspots.length) return;

      let activeHotspot = null;

      const setVideoSource = (src) => {
        if (!src) return;

        if (video.dataset.currentSrc === src) return;

        video.pause();
        video.removeAttribute('src');
        video.innerHTML = '';

        const source = document.createElement('source');
        source.src = src;
        source.type = 'video/mp4';

        video.appendChild(source);
        video.dataset.currentSrc = src;
        video.load();
      };

      const playPreview = async (hotspot) => {
        const src = hotspot.dataset.video;
        if (!src) return;

        activeHotspot?.classList.remove('is-active');
        activeHotspot = hotspot;
        activeHotspot.classList.add('is-active');

        setVideoSource(src);

        shot.classList.add('is-playing');

        try {
          await video.play();
        } catch {
          // Autoplay can be blocked in some browsers.
        }
      };

      const stopPreview = () => {
        shot.classList.remove('is-playing');
        activeHotspot?.classList.remove('is-active');
        activeHotspot = null;

        video.pause();
        video.currentTime = 0;
      };

      hotspots.forEach((hotspot) => {
        hotspot.addEventListener('mouseenter', () => playPreview(hotspot));
        hotspot.addEventListener('focus', () => playPreview(hotspot));

        hotspot.addEventListener('click', () => {
          if (hotspot.classList.contains('is-active')) {
            stopPreview();
          } else {
            playPreview(hotspot);
          }
        });
      });

      shot.addEventListener('mouseleave', stopPreview);

      shot.addEventListener('focusout', (event) => {
        if (!shot.contains(event.relatedTarget)) {
          stopPreview();
        }
      });
    });

    if (!prefersReducedMotion) {
      const loupeScale = 1.6;

      document.querySelectorAll('.t2r-shot-grid[data-t2r-loupe] a').forEach((link) => {
        link.addEventListener('mousemove', (event) => {
          const rect = link.getBoundingClientRect();
          const x = event.clientX - rect.left;
          const y = event.clientY - rect.top;
          link.style.setProperty('--loupe-tx', `${x * (1 - loupeScale)}px`);
          link.style.setProperty('--loupe-ty', `${y * (1 - loupeScale)}px`);
        });

        link.addEventListener('mouseleave', () => {
          link.style.removeProperty('--loupe-tx');
          link.style.removeProperty('--loupe-ty');
        });
      });
    }
  })();
</script>
