<!--
  Time2Route landing content adapted from the Open Design HTML export.
  It is scoped under #t2r-page and does not change the global page background.
  Replace screenshot placeholders with real images when they are ready.
-->

<style>
/* ============================================================
   Time2Route — route-story landing page
   Modern minimal direction, app palette accents
   Scoped under #t2r-page to avoid global bleed
   ============================================================ */
#t2r-page {
  --t2r-bg: transparent;
  --t2r-fg: oklch(18% 0.012 250);
  --t2r-muted: oklch(52% 0.01 250);
  --t2r-border: oklch(90% 0.005 250);
  --t2r-accent: #d97a56;
  --t2r-accent-strong: #e06b65;
  --t2r-accent-hover: #c9463b;
  --t2r-accent-soft: color-mix(in srgb, var(--t2r-accent) 12%, transparent);
  --t2r-accent-mid: color-mix(in srgb, var(--t2r-accent) 50%, transparent);
  --t2r-accent-shadow: color-mix(in srgb, var(--t2r-accent-strong) 26%, transparent);
  --t2r-teal: #5aaab8;
  --t2r-teal-soft: color-mix(in srgb, #a3d4da 24%, transparent);
  --t2r-teal-deep: #1b7a8a;
  --t2r-teal-shadow: color-mix(in srgb, var(--t2r-teal-deep) 28%, transparent);
  --t2r-surface: oklch(100% 0 0 / 0.55);
  --t2r-ease: cubic-bezier(0.23, 1, 0.32, 1);
}

#t2r-page * { box-sizing: border-box; }
#t2r-page {
  margin: 0 auto;
  padding: 0 1.5rem 0;
  color: var(--t2r-fg);
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

#t2r-page h2 {
  font-size: 1.8rem;
  font-weight: 650;
  letter-spacing: -0.025em;
  line-height: 1.2;
  margin: 0 0 0.5rem;
}
#t2r-page h3 {
  font-size: 1.15rem;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 0.4rem;
}
#t2r-page p {
  margin: 0 0 1.2rem;
  color: var(--t2r-muted);
}
#t2r-page section {
  margin: 5rem 0;
}
#t2r-page section:first-child { margin-top: 0; }
#t2r-page section:last-child { margin-bottom: 0; }

/* Static fallback for Astro Markdown: keep all sections visible without JS. */
.t2r-reveal {
  opacity: 1;
  transform: none;
}
.t2r-reveal.t2r-visible {
  opacity: 1;
  transform: none;
}

/* ============================================================
   HERO
   ============================================================ */
.t2r-hero {
  text-align: center;
  padding: 3rem 0 2.5rem;
  border-bottom: 1px solid var(--t2r-border);
  margin-bottom: 0;
}
.t2r-hero-headline {
  font-size: clamp(1.5rem, 5vw, 2.5rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin: 0 0 1rem;
}
#t2r-page .t2r-hero-sub {
  font-size: 1.1rem;
  max-width: 520px;
  margin: 0 auto 1.8rem;
  text-align: center;
  color: var(--t2r-muted);
}
.t2r-ctas {
  display: flex;
  gap: 0.75rem;
  justify-content: center;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}
.t2r-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.7rem 1.5rem;
  border-radius: 8px;
  font-size: 0.95rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
  cursor: pointer;
  line-height: 1.3;
  font-family: inherit;
}
.t2r-btn-primary {
  background: var(--t2r-accent);
  color: #fff;
  border: 1px solid var(--t2r-accent);
}
.t2r-btn-primary:hover {
  background: var(--t2r-accent-hover);
  transform: translateY(-1px);
}
.t2r-btn-secondary {
  background: transparent;
  color: var(--t2r-fg);
  border: 1px solid var(--t2r-border);
}
.t2r-btn-secondary:hover {
  border-color: var(--t2r-muted);
  background: var(--t2r-accent-soft);
}

/* route-flow visual */
.t2r-route-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  padding: 1rem 0;
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}
.t2r-route-flow-wrap {
  position: relative;
}
.t2r-route-flow.is-fixed {
  position: fixed;
  top: var(--t2r-sticky-top, 88px);
  left: 50%;
  transform: translateX(-50%);
  z-index: 40;
  padding: 0.75rem 0.8rem;
  border: 1px solid var(--t2r-border);
  border-radius: 12px;
  background: oklch(100% 0 0 / 0.94);
  backdrop-filter: blur(8px);
  overflow: hidden;
  overscroll-behavior: none;
  touch-action: none;
  box-shadow: 0 12px 30px oklch(18% 0.012 250 / 0.12);
}
.t2r-flow-step {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  flex-shrink: 0;
  cursor: pointer;
  transition: transform 0.24s var(--t2r-ease);
}
.t2r-flow-step:hover {
  transform: translateY(-3px);
}
.t2r-flow-dot {
  position: relative;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--t2r-muted);
  background: var(--t2r-border);
  border: 2px solid transparent;
  transition:
    transform 0.24s var(--t2r-ease),
    background 0.24s var(--t2r-ease),
    color 0.24s var(--t2r-ease),
    box-shadow 0.24s var(--t2r-ease),
    border-color 0.24s var(--t2r-ease);
}
.t2r-flow-dot::after {
  content: '';
  position: absolute;
  inset: -8px;
  border-radius: 999px;
  border: 1px solid var(--t2r-accent);
  opacity: 0;
  transform: scale(0.82);
}
.t2r-flow-step.active .t2r-flow-dot,
.t2r-flow-dot.active {
  background: var(--t2r-accent);
  color: #fff;
  border-color: var(--t2r-accent);
  box-shadow: 0 0 0 4px var(--t2r-accent-soft);
}
.t2r-flow-label {
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--t2r-muted);
  white-space: nowrap;
  letter-spacing: 0.01em;
  transition: color 0.24s var(--t2r-ease);
}
.t2r-flow-step:hover .t2r-flow-dot {
  background: var(--t2r-accent);
  color: #fff;
  border-color: var(--t2r-accent);
  box-shadow:
    0 0 0 4px var(--t2r-accent-soft),
    0 10px 20px oklch(18% 0.012 250 / 0.2);
  transform: scale(1.06);
}
.t2r-flow-step:hover .t2r-flow-dot::after {
  opacity: 0.5;
  animation: t2r-flow-dot-pulse 1.1s ease-out infinite;
}
.t2r-flow-step:hover .t2r-flow-label {
  color: var(--t2r-fg);
}
.t2r-flow-step.active .t2r-flow-label {
  color: var(--t2r-fg);
}
.t2r-flow-line {
  width: 32px;
  height: 2px;
  background: var(--t2r-border);
  flex-shrink: 0;
  margin: 0 6px;
  position: relative;
}
.t2r-flow-line::after {
  content: '';
  position: absolute;
  right: -1px;
  top: 50%;
  transform: translateY(-50%);
  width: 6px;
  height: 6px;
  background: var(--t2r-border);
  clip-path: polygon(100% 50%, 0 0, 0 100%);
}
@keyframes t2r-flow-dot-pulse {
  0% {
    transform: scale(0.82);
    opacity: 0.5;
  }

  100% {
    transform: scale(1.3);
    opacity: 0;
  }
}

/* flow wheel — desktop passthrough */
.t2r-flow-wheel-viewport,
.t2r-flow-wheel-track {
  display: contents;
}
.t2r-flow-wheel-highlight,
.t2r-flow-wheel-pad {
  display: none;
}

/* ============================================================
   ROUTE TIMELINE
   ============================================================ */
.t2r-timeline {
  position: relative;
  padding-left: 2.5rem;
}
.t2r-timeline::before {
  content: '';
  position: absolute;
  left: 11px;
  top: 8px;
  bottom: 8px;
  width: 2px;
  background: var(--t2r-border);
}
.t2r-waypoint {
  position: relative;
  margin-bottom: 2rem;
  padding: 1.2rem 1.5rem;
  background: var(--t2r-surface);
  border: 1px solid var(--t2r-border);
  border-radius: 10px;
  transition: all 0.3s var(--t2r-ease);
}
.t2r-waypoint:hover {
  border-color: var(--t2r-accent-mid);
  background: var(--t2r-accent-soft);
}
.t2r-waypoint:last-child { margin-bottom: 0; }
.t2r-waypoint-dot {
  position: absolute;
  left: calc(-2.5rem + 4px);
  top: 1.6rem;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--t2r-border);
  border: 3px solid var(--t2r-surface);
  z-index: 1;
  transition: all 0.3s var(--t2r-ease);
}
.t2r-waypoint:hover .t2r-waypoint-dot {
  background: var(--t2r-accent);
  box-shadow: 0 0 0 4px var(--t2r-accent-soft);
}
.t2r-waypoint h4 {
  font-size: 1rem;
  font-weight: 600;
  margin: 0 0 0.3rem;
  letter-spacing: -0.01em;
}
.t2r-waypoint p {
  font-size: 0.9rem;
  margin: 0;
  color: var(--t2r-muted);
  line-height: 1.5;
}
.t2r-waypoint-step {
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--t2r-accent);
  margin-bottom: 0.3rem;
}

/* ============================================================
   SCREENSHOT
   ============================================================ */
.t2r-shot {
  margin: 1.5rem 0;
  border-radius: 12px;
  overflow: hidden;
}
.t2r-shot img,
.t2r-shot video {
  width: 100%;
  height: auto;
  display: block;
}
.t2r-shot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6px;
  margin: 0.5rem 0 0.25rem;
  align-items: start;
}
.t2r-shot-grid a {
  position: relative;
  display: block;
  min-width: 0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 4px 18px oklch(18% 0.012 250 / 0.07);
  transition:
    transform 0.32s var(--t2r-ease),
    box-shadow 0.32s var(--t2r-ease);
}
.t2r-shot-grid a::before {
  content: none;
}
.t2r-shot-grid a::after {
  content: 'Open route →';
  position: absolute;
  left: 50%;
  bottom: 14px;
  z-index: 2;
  transform: translateX(-50%) translateY(12px);
  opacity: 0;
  padding: 0.42rem 0.9rem;
  border-radius: 999px;
  background: oklch(100% 0 0 / 0.94);
  color: var(--t2r-accent);
  font-size: 0.74rem;
  font-weight: 600;
  letter-spacing: 0.03em;
  white-space: nowrap;
  box-shadow: 0 8px 22px oklch(18% 0.012 250 / 0.16);
  transition:
    opacity 0.26s var(--t2r-ease),
    transform 0.26s var(--t2r-ease);
  pointer-events: none;
}
.t2r-shot-grid a:first-child::after {
  content: 'Try walking route →';
}
.t2r-shot-grid a:last-child::after {
  content: 'Try cycling route →';
  color: var(--t2r-teal);
  box-shadow: 0 8px 22px var(--t2r-teal-shadow);
}
.t2r-shot-grid a:last-child:hover,
.t2r-shot-grid a:last-child:focus-visible {
  box-shadow: 0 20px 48px var(--t2r-teal-shadow);
}
.t2r-shot-grid img {
  width: 100%;
  height: auto;
  display: block;
  border: none;
  border-radius: 0;
  background: transparent;
  transition: transform 0.45s var(--t2r-ease);
}
.t2r-shot-grid a:hover,
.t2r-shot-grid a:focus-visible {
  transform: translateY(-5px);
  box-shadow: 0 20px 48px var(--t2r-accent-shadow);
  outline: none;
}
.t2r-shot-grid a:hover img,
.t2r-shot-grid a:focus-visible img {
  transform: scale(1.05);
}
.t2r-shot-grid[data-t2r-loupe] a {
  cursor: zoom-in;
}
.t2r-shot-grid[data-t2r-loupe] img {
  transform-origin: 0 0;
  transition: none;
}
.t2r-shot-grid[data-t2r-loupe] a:hover,
.t2r-shot-grid[data-t2r-loupe] a:focus-visible {
  transform: none;
}
.t2r-shot-grid[data-t2r-loupe] a:hover img,
.t2r-shot-grid[data-t2r-loupe] a:focus-visible img {
  transform: translate(var(--loupe-tx, 0px), var(--loupe-ty, 0px)) scale(1.6);
}
.t2r-shot-grid a:hover::before,
.t2r-shot-grid a:focus-visible::before {
  opacity: 1;
}
.t2r-shot-grid a:hover::after,
.t2r-shot-grid a:focus-visible::after {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
#t2r-mode > p {
  margin-bottom: 0.75rem;
}
.t2r-shot-caption {
  text-align: center;
  margin-top: 8px;
  font-size: 1rem;
  color: var(--t2r-muted);
  font-style: italic;
}

/* ============================================================
   INTERACTIVE SCREENSHOT HOTSPOTS
   ============================================================ */
.t2r-interactive-shot {
  position: relative;
  isolation: isolate;
}

.t2r-interactive-shot-stage {
  position: relative;
}
.t2r-interactive-shot-video {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 12px;
  margin-bottom: 0.5rem;
}

.t2r-shot-demo {
  margin-top: 1.75rem;
  padding-top: 1.5rem;
}

#t2r-page .t2r-shot-demo-text {
  margin: 0 0 0.9rem;
  font-size: 1rem;
  line-height: 1.5;
  color: var(--t2r-muted);
}


.t2r-shot-poster,
.t2r-shot-video {
  width: 100%;
  height: auto;
  display: block;
}

.t2r-shot-video {
  position: absolute;
  inset: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.28s var(--t2r-ease);
}

.t2r-interactive-shot.is-playing .t2r-shot-video {
  opacity: 1;
}

.t2r-interactive-shot.is-playing .t2r-shot-poster {
  opacity: 0.35;
}

.t2r-hotspot {
  position: absolute;
  left: var(--x);
  top: var(--y);
  z-index: 4;
  width: 18px;
  height: 18px;
  padding: 0;
  border: 2px solid #fff;
  border-radius: 999px;
  background: var(--t2r-accent);
  box-shadow:
    0 0 0 4px var(--t2r-accent-soft),
    0 10px 30px oklch(18% 0.012 250 / 0.18);
  transform: translate(-50%, -50%);
  cursor: pointer;
  transition:
    transform 0.22s var(--t2r-ease),
    box-shadow 0.22s var(--t2r-ease),
    background 0.22s var(--t2r-ease);
}

.t2r-hotspot::before {
  content: '';
  position: absolute;
  inset: -10px;
  border: 1px solid var(--t2r-accent);
  border-radius: inherit;
  opacity: 0.45;
  animation: t2r-hotspot-pulse 1.8s ease-out infinite;
}

.t2r-hotspot:hover,
.t2r-hotspot:focus-visible,
.t2r-hotspot.is-active {
  transform: translate(-50%, -50%) scale(1.25);
  background: var(--t2r-accent-hover);
  box-shadow:
    0 0 0 7px var(--t2r-accent-soft),
    0 16px 40px oklch(18% 0.012 250 / 0.26);
}

.t2r-hotspot-label {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 10px);
  transform: translateX(-50%) translateY(4px);
  width: max-content;
  max-width: 180px;
  padding: 0.42rem 0.65rem;
  border: 1px solid var(--t2r-border);
  border-radius: 8px;
  background: oklch(100% 0 0 / 0.92);
  color: var(--t2r-fg);
  font-size: 0.75rem;
  font-weight: 550;
  line-height: 1.25;
  opacity: 0;
  pointer-events: none;
  transition:
    opacity 0.2s var(--t2r-ease),
    transform 0.2s var(--t2r-ease);
  backdrop-filter: blur(10px);
}

.t2r-hotspot:hover .t2r-hotspot-label,
.t2r-hotspot:focus-visible .t2r-hotspot-label,
.t2r-hotspot.is-active .t2r-hotspot-label {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.t2r-route-callout {
  position: absolute;
  left: var(--x);
  top: var(--y);
  z-index: 4;
  width: min(230px, 26vw);
  padding: 0.7rem 0.85rem;
  border-radius: 12px;
  background: oklch(100% 0 0 / 1);
  color: var(--t2r-fg);
  box-shadow: 0 16px 42px oklch(18% 0.012 250 / 0.18);
  backdrop-filter: blur(12px);
  opacity: 0;
  transform: translate(14px, -50%) scale(0.98);
  animation: t2r-route-callout-cycle 9s var(--t2r-ease) infinite;
  pointer-events: none;
}
.t2r-route-callout::before {
  content: '';
  position: absolute;
  left: -7px;
  top: 50%;
  width: 14px;
  height: 14px;
  background: inherit;
  transform: translateY(-50%) rotate(45deg);
  border-radius: 3px;
}
.t2r-route-callout:nth-of-type(2) {
  animation-delay: 3s;
}
.t2r-route-callout:nth-of-type(3) {
  animation-delay: 6s;
}
.t2r-route-callout-title {
  display: block;
  margin-bottom: 0.18rem;
  color: var(--t2r-teal);
  font-size: 0.82rem;
  font-weight: 650;
  line-height: 1.2;
}
.t2r-route-callout-text {
  display: block;
  color: var(--t2r-muted);
  font-size: 0.72rem;
  line-height: 1.35;
}

@keyframes t2r-hotspot-pulse {
  0% {
    transform: scale(0.75);
    opacity: 0.55;
  }

  70% {
    transform: scale(1.6);
    opacity: 0;
  }

  100% {
    transform: scale(1.6);
    opacity: 0;
  }
}

@keyframes t2r-route-callout-cycle {
  0%,
  5% {
    opacity: 0;
    transform: translate(14px, -50%) scale(0.98);
  }

  12%,
  31% {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }

  38%,
  100% {
    opacity: 0;
    transform: translate(14px, -50%) scale(0.98);
  }
}

@media (prefers-reduced-motion: reduce) {
  .t2r-flow-step,
  .t2r-flow-dot,
  .t2r-flow-label {
    transition: none;
  }
  .t2r-flow-step:hover {
    transform: none;
  }
  .t2r-flow-step:hover .t2r-flow-dot::after {
    animation: none;
  }

  .t2r-hotspot::before {
    animation: none;
  }

  .t2r-route-callout {
    animation: none;
    opacity: 1;
    transform: translate(0, -50%);
  }

  .t2r-shot-video,
  .t2r-hotspot,
  .t2r-hotspot-label,
  .t2r-route-callout {
    transition: none;
  }

  .t2r-shot-grid a,
  .t2r-shot-grid a::before,
  .t2r-shot-grid a::after,
  .t2r-shot-grid img {
    transition: none;
  }
  .t2r-shot-grid a:hover,
  .t2r-shot-grid a:focus-visible {
    transform: none;
  }
  .t2r-shot-grid a:hover img,
  .t2r-shot-grid a:focus-visible img {
    transform: none;
  }

  .t2r-shot-link,
  .t2r-shot-link::before,
  .t2r-shot-link::after,
  .t2r-shot-link video {
    transition: none;
  }
  .t2r-shot-link:hover,
  .t2r-shot-link:focus-visible {
    transform: none;
  }
  .t2r-shot-link:hover video,
  .t2r-shot-link:focus-visible video {
    transform: none;
  }
}

@media (max-width: 868px) {
  .t2r-hotspot {
    width: 22px;
    height: 22px;
  }

  .t2r-hotspot-label {
    font-size: 0.7rem;
  }
}

/* ============================================================
   SCREENSHOT PLACEHOLDER (legacy)
   ============================================================ */
.t2r-screenshot {
  margin: 1.5rem 0;
  border: 1px solid var(--t2r-border);
  border-radius: 12px;
  overflow: hidden;
  background: oklch(97% 0.005 250);
  aspect-ratio: 16 / 9;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 220px;
}
.t2r-screenshot-inner {
  text-align: center;
  padding: 2rem;
}
.t2r-screenshot-inner svg {
  display: block;
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
  opacity: 0.25;
  pointer-events: none;
}
.t2r-screenshot-label {
