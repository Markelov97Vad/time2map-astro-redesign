# apps/server runtime config. Copy to .env and fill in for production.
# Without SMTP_HOST the contact endpoint logs submissions instead of emailing
# (handy for local development).

# Where contact-form emails are delivered
CONTACT_TO=contact@time2map.com
# Optional "From" header (defaults to the CONTACT_TO address)
# CONTACT_FROM="time2map website <contact@time2map.com>"

# SMTP transport (your mail server, or e.g. Resend's SMTP gateway)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# CORS: the public site origin allowed to call this API (set in production)
ALLOWED_ORIGIN=https://time2map.com
# Where no-JS form posts are redirected back to
SITE_URL=https://time2map.com

# Keystatic admin (Basic Auth). Without ADMIN_PASS the admin is refused (503).
ADMIN_USER=admin
ADMIN_PASS=
# Repo root for the publish pipeline (defaults to two levels up from apps/server)
# REPO_ROOT=/var/www/time2map
