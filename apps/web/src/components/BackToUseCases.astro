---
interface Props {
  href?: string;
  label?: string;
}

const { href = '/use-cases', label = 'All use cases' } = Astro.props;
---

<a class="case-back-link" href={href}>
  <span class="case-back-icon" aria-hidden="true">
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none">
      <path d="M16 10H4m5-5-5 5 5 5" />
    </svg>
  </span>
  <span>{label}</span>
</a>

<style>
  .case-back-link {
    display:inline-flex;
    align-items:center;
    gap:10px;
    min-height:44px;
    padding:4px 8px 4px 0;
    border:0;
    border-radius:8px;
    background:transparent;
    color:var(--case-back-ink,var(--color-text-light,#555));
    font:500 13px/1 var(--font-body,Arial,sans-serif);
    letter-spacing:0;
    white-space:nowrap;
    touch-action:manipulation;
    transition:color 180ms ease,opacity 110ms ease;
  }

  .case-back-link:focus-visible {
    outline:2px solid var(--case-back-focus,var(--case-back-accent,var(--color-accent,#c94e43)));
    outline-offset:4px;
  }

  .case-back-link:active { opacity:.72; }

  .case-back-icon {
    display:grid;
    place-items:center;
    flex:none;
    width:32px;
    height:32px;
    border:1px solid color-mix(in srgb,var(--case-back-accent,var(--color-accent,#c94e43)) 38%,transparent);
    border-radius:50%;
    background:transparent;
    color:var(--case-back-accent,var(--color-accent,#c94e43));
    transition:background-color 180ms ease,color 180ms ease,border-color 180ms ease;
  }

  .case-back-icon svg {
    display:block;
    overflow:visible;
  }

  .case-back-icon path {
    stroke:currentColor;
    stroke-width:1.7;
    stroke-linecap:round;
    stroke-linejoin:round;
  }

  @media(hover:hover) and (pointer:fine){
    .case-back-link:hover {
      color:var(--case-back-accent,var(--color-accent,#c94e43));
    }

    .case-back-link:hover .case-back-icon {
      border-color:var(--case-back-accent,var(--color-accent,#c94e43));
      background:var(--case-back-accent,var(--color-accent,#c94e43));
      color:var(--case-back-icon-ink,#fff);
    }
  }

  @media(prefers-reduced-motion:reduce){
    .case-back-icon { transition:none; }
  }
</style>
