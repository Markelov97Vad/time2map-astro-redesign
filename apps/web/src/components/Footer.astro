---
import site from '../content/site.yaml';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container container-lg">
    <div class="footer-top">
      <a href="/" class="footer-brand" aria-label="time2map — home">
        <img src="/images/logo.svg" alt="time2map" width="140" height="32" />
      </a>
      <div class="footer-columns">
        <div class="footer-about text-small">
          <p>{site.tagline}</p>
          <p>{site.location}</p>
          <p>VAT: {site.vat}</p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/use-cases">Use Cases</a>
          <a href="/contact-us">Contact Us</a>
          <a href={site.privacyPolicyUrl} target="_blank" rel="noopener">Privacy Policy</a>
        </nav>
      </div>
    </div>
    <hr class="footer-divider" />
    <div class="footer-bottom">
      <div class="text-small">© {year} {site.title}. All rights reserved</div>
      <div class="footer-social">
        <a href={site.social.linkedinCompany} target="_blank" rel="noopener" aria-label="LinkedIn">
          <img src="/images/icons/linkedin.svg" alt="" width="32" height="32" />
        </a>
        <a href={site.social.upworkAgency} target="_blank" rel="noopener" aria-label="Upwork">
          <img src="/images/icons/upwork.svg" alt="" width="32" height="32" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-footer);
    padding: 80px 0 40px;
    margin-top: 40px;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-brand img {
    height: 32px;
    width: auto;
  }

  .footer-columns {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    flex-wrap: wrap;
  }

  .footer-about p {
    margin: 0 0 8px;
    color: #6e6e6e;
    -webkit-text-stroke-color: #a7a7a7;
    font-size: 16px;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }

  .footer-links a {
    font-size: 16px;
    color: #1a1b1f;
    text-decoration: none;
    font-weight: 300;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-divider {
    border: none;
    border-top: 1px solid #e8e8e8;
    margin: 40px 0;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    color: var(--color-gray);
  }

  .footer-bottom .text-small {
    font-size: 16px;
    color: #6e6e6e
  }

  .footer-social {
    display: flex;
    gap: 12px;
  }

  .footer-social img {
    border-radius: 50%;
  }

  @media (max-width: 767px) {
    .footer {
      margin: 0;
    }
    .footer-links {
      align-items: flex-start;
    }
  }
</style>
