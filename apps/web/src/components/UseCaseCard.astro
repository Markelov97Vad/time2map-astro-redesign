---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'useCases'>;
  index: number;
  priority?: boolean;
}

const { entry, index, priority = false } = Astro.props;
const { title, tags, images, tryItUrl, caseStudyUrl: configuredCaseStudyUrl } = entry.data;
const caseStudyUrl = configuredCaseStudyUrl
  ?? (images.includes('/images/use-cases/archi2go-prev.webp') ? '/use-cases/archi2go' : undefined);
const { Content } = await render(entry);
const imageDimensions: Record<string, { width: number; height: number }> = {
  '/images/use-cases/archi2go-prev.webp': { width: 1600, height: 867 },
  '/images/use-cases/audio-guides-1.webp': { width: 1441, height: 813 },
  '/images/use-cases/audio-guides-2.webp': { width: 1441, height: 813 },
  '/images/use-cases/audio-guides-3.webp': { width: 1441, height: 813 },
  '/images/use-cases/recycling-1.webp': { width: 2880, height: 1600 },
  '/images/use-cases/recycling-2.webp': { width: 1441, height: 813 },
  '/images/use-cases/recycling-3.webp': { width: 1441, height: 813 },
  '/images/use-cases/coal-mining-1.webp': { width: 1441, height: 811 },
  '/images/use-cases/coal-mining-2.webp': { width: 1441, height: 811 },
  '/images/use-cases/coal-mining-3.webp': { width: 1441, height: 811 },
  '/images/use-cases/land-certificates-1.webp': { width: 1600, height: 1035 },
  '/images/use-cases/land-certificates-2.webp': { width: 1920, height: 1080 },
  '/images/use-cases/land-certificates-3.webp': { width: 2048, height: 1152 },
  '/images/use-cases/ski-resort-1.webp': { width: 1600, height: 866 },
  '/images/use-cases/airport-maps-1.webp': { width: 2002, height: 1501 },
  '/images/use-cases/airport-maps-2.webp': { width: 2000, height: 1500 },
  '/images/use-cases/airport-maps-3.webp': { width: 2002, height: 1501 },
  '/images/use-cases/georeferencing-1.webp': { width: 1600, height: 781 },
  '/images/use-cases/weed-detection-1.webp': { width: 1600, height: 900 },
  '/images/use-cases/weed-detection-2.webp': { width: 1800, height: 1000 },
  '/images/use-cases/weed-detection-3.webp': { width: 1800, height: 1000 },
};
const firstImage = images[0];
const firstImageDimensions = imageDimensions[firstImage];
const firstImageRatio = firstImageDimensions ? `${firstImageDimensions.width} / ${firstImageDimensions.height}` : '16 / 9';
const firstImageAspect = firstImageDimensions ? firstImageDimensions.width / firstImageDimensions.height : 16 / 9;
const lightboxWidthByHeight = `${(firstImageAspect * 80).toFixed(2)}dvh`;
const lightboxMobileWidthByHeight = `${(firstImageAspect * 72).toFixed(2)}dvh`;
// Responsive variants generated by scripts/optimize-images.mjs (`use-cases` group):
// <name>-<w>.webp for w in 720/1280/1600, never wider than the source.
const VARIANT_WIDTHS = [720, 1280, 1600];
const PREVIEW_SIZES = '(max-width: 900px) 90vw, (max-width: 1420px) 52vw, 740px';
const LIGHTBOX_SIZES = '(max-width: 520px) 92vw, 80vw';
/** 1×1 transparent GIF. Slides that are not on screen ship this and get their real source
 * from the script below (otherwise every hidden slide sits inside Chrome's lazy-load margin
 * and the whole gallery downloads on page open). */
const PLACEHOLDER = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';
const responsive = (src: string) => {
  const dims = imageDimensions[src];
  if (!dims) return { src, srcset: undefined };
  const widths = [...new Set(VARIANT_WIDTHS.map((w) => Math.min(w, dims.width)))].sort((a, b) => a - b);
  const file = (w: number) => `${src.replace(/\.webp$/, '')}-${w}.webp`;
  return { src: file(widths[Math.min(1, widths.length - 1)]), srcset: widths.map((w) => `${file(w)} ${w}w`).join(', ') };
};
---

<article class="use-case">
  <div class="case-media" data-slider data-title={title}>
    <button class="case-preview" type="button" data-expand aria-label={`View ${title} screenshots full screen`} style={`--case-preview-ratio:${firstImageRatio}`}>
      <span class="case-slides" data-slides>
        {images.map((src, imageIndex) => {
          const dimensions = imageDimensions[src];
          const { src: variantSrc, srcset } = responsive(src);
          const eager = priority && imageIndex === 0;
          return imageIndex === 0 ? (
            <img src={variantSrc} srcset={srcset} sizes={PREVIEW_SIZES} alt={`${title} — screenshot 1`} width={dimensions?.width} height={dimensions?.height} loading={eager ? undefined : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
          ) : (
            <img src={PLACEHOLDER} data-src={variantSrc} data-srcset={srcset} sizes={PREVIEW_SIZES} alt={`${title} — screenshot ${imageIndex + 1}`} width={dimensions?.width} height={dimensions?.height} decoding="async" />
          );
        })}
      </span>
      <span class="case-preview-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none">
          <path d="M9 4H4v5M15 4h5v5M9 20H4v-5M15 20h5v-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </button>
    {(tryItUrl || images.length > 1) && <div class="case-media-toolbar">
      {tryItUrl && <a class="case-live-link button-motion" href={tryItUrl} target="_blank" rel="noopener">View live project <span aria-hidden="true"><svg viewBox="0 0 18 18"><path d="M5 13 13 5M8 5h5v5"/></svg></span></a>}
      {images.length > 1 && (
        <div class="case-controls" role="group" aria-label={`${title} screenshots`}>
          <span data-slider-count aria-live="polite">01 / {String(images.length).padStart(2, '0')}</span>
          <button type="button" data-prev aria-label="Previous screenshot">←</button>
          <button type="button" data-next aria-label="Next screenshot">→</button>
        </div>
      )}
    </div>}
  </div>

  <div class="case-body">
    <div class="case-kicker"><span>{String(index).padStart(2, '0')}</span></div>
    <h2>{title}</h2>
    <div class="case-copy"><Content /></div>
    {caseStudyUrl && (
      <a class="case-study-link button-motion" href={caseStudyUrl} aria-label={`Explore the ${title} case study`}>
        <span>Explore case study</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14L14 6M8 6h6v6" /></svg>
      </a>
    )}
    <div class="case-stack">
      <span class="case-section-label">Stack</span>
      <div class="case-tags">{tags.map((tag) => <span>{tag}</span>)}</div>
    </div>
  </div>

  <dialog class="case-lightbox" data-lightbox aria-label={`${title} screenshots full screen`} style={`--case-lightbox-ratio:${firstImageRatio};--case-lightbox-width-by-height:${lightboxWidthByHeight};--case-lightbox-mobile-width-by-height:${lightboxMobileWidthByHeight}`}>
    <div class="case-lightbox-shell">
      <button class="case-lightbox-close" type="button" data-lightbox-close aria-label="Close fullscreen preview"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button>
      <div class="case-lightbox-device">
        <div class="case-lightbox-track" data-lightbox-track>
          {images.map((src, imageIndex) => {
            const dimensions = imageDimensions[src];
            const { src: variantSrc, srcset } = responsive(src);
            return <img src={PLACEHOLDER} data-src={variantSrc} data-srcset={srcset} sizes={LIGHTBOX_SIZES} alt={`${title} — screenshot ${imageIndex + 1}`} width={dimensions?.width} height={dimensions?.height} decoding="async" />;
          })}
        </div>
      </div>
      {images.length > 1 && <div class="case-lightbox-switcher" role="group" aria-label={`${title} fullscreen screenshots`}>
        {images.map((_, imageIndex) => <button class={imageIndex === 0 ? 'is-active' : ''} type="button" data-lightbox-slide={imageIndex} aria-label={`Show screenshot ${imageIndex + 1}`} aria-pressed={imageIndex === 0 ? 'true' : 'false'}>{String(imageIndex + 1).padStart(2, '0')}</button>)}
      </div>}
    </div>
  </dialog>
</article>

<style>
  .use-case { display:grid; grid-template-columns:minmax(0,1.16fr) minmax(400px,.84fr); align-items:start; gap:clamp(28px,3vw,46px); padding:clamp(30px,4vh,44px) 0; border-top:1px solid var(--line); }
  .case-media { display:grid; grid-template-rows:auto auto; min-width:0; overflow:hidden; border:1px solid var(--line); border-radius:14px; background:#fff; }
  .case-preview { position:relative; display:block; min-width:0; width:100%; height:auto; aspect-ratio:var(--case-preview-ratio); padding:0; overflow:hidden; border:0; background:#fff; cursor:zoom-in; }
  .case-slides { display:flex; min-width:0; width:100%; height:100%; background:#fff; transition:transform 420ms var(--ease-out); }
  .case-slides img { display:block; flex:0 0 100%; width:100%; height:100%; padding:0; object-fit:contain; object-position:center; }
  .case-preview-icon { position:absolute; right:14px; bottom:14px; display:grid; place-items:center; width:42px; height:42px; border:1px solid rgb(255 255 255 / 42%); border-radius:9px; background:rgb(17 17 17 / 84%); color:#fff; opacity:0; transform:scale(.9); transition:opacity .2s ease,transform .2s var(--ease-out),background .2s ease; -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); }
  .case-preview-icon svg { display:block; }
  .case-preview:hover .case-preview-icon,.case-preview:focus-visible .case-preview-icon { opacity:1; transform:translateY(0); }
  .case-preview:focus-visible { outline:3px solid var(--color-accent); outline-offset:-3px; }
  .case-preview:focus-visible .case-preview-icon { background:var(--color-accent); }
  .case-media-toolbar { display:flex; align-items:center; justify-content:space-between; gap:18px; min-height:58px; padding:7px 9px 7px 16px; border-top:1px solid var(--line); background:#fff; }
  .case-live-link { display:inline-flex; align-items:center; gap:11px; min-height:44px; padding:6px 7px 6px 11px; border-radius:999px; color:var(--color-heading); font:500 12px var(--font-heading); transition:background .2s ease,color .2s ease; }
  .case-live-link>span:last-child { display:grid; place-items:center; width:30px; height:30px; border-radius:50%; background:var(--color-heading); color:#fff; font-size:14px; }
  .case-live-link svg { width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .case-live-link:hover { background:var(--color-bg-soft); color:var(--color-accent); }
  .case-live-link:focus-visible { background:var(--color-bg-soft); color:var(--color-accent); outline:2px solid var(--color-accent); outline-offset:2px; }
  .case-controls { display:flex; align-items:center; gap:6px; margin-left:auto; }
  .case-controls span { min-width:54px; color:var(--color-muted); font-size:10px; text-align:center; letter-spacing:.08em; }
  .case-controls button { display:grid; place-items:center; width:44px; height:44px; padding:0; border:1px solid var(--line); border-radius:50%; background:#fff; color:var(--color-heading); font:500 18px var(--font-heading); cursor:pointer; transition:border-color .2s ease,background .2s ease,color .2s ease; }
  .case-controls button:hover { border-color:var(--color-accent); background:var(--color-accent); color:#fff; }
  .case-controls button:focus-visible { border-color:var(--color-accent); background:var(--color-accent); color:#fff; outline:2px solid var(--color-accent); outline-offset:2px; }
  .case-body { display:flex; flex-direction:column; align-items:flex-start; padding:0; background:transparent; }
  .case-kicker { color:var(--color-accent); font-size:11px; font-weight:500; letter-spacing:.04em; }
  h2 { max-width:560px; margin:18px 0 0; color:var(--color-heading); font:500 clamp(28px,2.5vw,40px)/.98 var(--font-heading); letter-spacing:-.045em; }
  .case-stack { width:100%; margin-top:20px; padding-top:16px; border-top:1px solid var(--line); }
  .case-section-label { display:block; margin-bottom:9px; color:var(--color-muted); font-size:10px; font-weight:500; text-transform:uppercase; letter-spacing:.12em; }
  .case-tags { display:flex; flex-wrap:wrap; gap:7px; }
  .case-tags span { padding:5px 8px; border:1px solid var(--line); border-radius:999px; color:var(--color-muted); font-size:10px; text-transform:uppercase; letter-spacing:.05em; }
  .case-copy { max-width:590px; margin-top:18px; color:var(--color-text-light); font-size:14px; line-height:1.5; }
  .case-copy :global(p) { margin:0; }
  .case-copy :global(a) { color:var(--color-heading); text-decoration:underline; text-decoration-color:var(--color-accent); text-underline-offset:3px; }
  .case-study-link { display:inline-flex; align-items:center; justify-content:space-between; gap:30px; min-width:210px; min-height:48px; margin-top:24px; padding:0 10px 0 18px; border-radius:999px; background:var(--color-heading); color:#fff; font:500 13px var(--font-heading); transition:transform .25s var(--ease-out); }
  .case-study-link svg { width:30px; height:30px; padding:6px; border-radius:50%; background:var(--color-accent); color:#fff; fill:none; stroke:currentColor; stroke-width:1.6; stroke-linecap:round; stroke-linejoin:round; transition:background .2s ease,color .2s ease; }
  .case-study-link:hover { transform:translateY(-2px); }
  .case-study-link:hover svg { background:#fff; color:var(--color-heading); }
  .case-study-link:focus-visible { outline:3px solid var(--color-accent); outline-offset:3px; }
  :global(html.case-lightbox-open),:global(html.case-lightbox-open body) { overflow:hidden!important; overscroll-behavior:none; }
  .case-lightbox { position:fixed; inset:0; width:100%; max-width:none; height:100dvh; max-height:100dvh; margin:0; padding:0; overflow:hidden; overscroll-behavior:none; border:0; background:#000; color:#fff; }
  .case-lightbox[open] { display:block; }
  .case-lightbox::backdrop { background:#000; }
  .case-lightbox-shell { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:22px; width:100%; height:100%; min-width:0; min-height:0; padding:4vh 4vw; overflow:hidden; }
  .case-lightbox-close { position:absolute; z-index:8; top:22px; right:25px; display:grid; place-items:center; width:48px; height:48px; padding:0; border:1px solid rgb(255 255 255 / 28%); border-radius:50%; background:rgb(20 20 20 / 70%); color:#fff; cursor:pointer; }
  .case-lightbox-close svg { display:block; }
  .case-lightbox-close:hover,.case-lightbox-close:focus-visible { border-color:var(--color-accent); background:var(--color-accent); outline:2px solid #fff; outline-offset:2px; }
  .case-lightbox-device { flex:none; width:min(80vw,var(--case-lightbox-width-by-height)); max-width:1500px; max-height:80dvh; aspect-ratio:var(--case-lightbox-ratio); overflow:hidden; border-radius:18px; background:#080808; }
  .case-lightbox-track { display:flex; width:100%; height:100%; overflow-x:auto; overflow-y:hidden; overscroll-behavior-x:none; scroll-behavior:smooth; scroll-snap-type:x mandatory; scrollbar-width:none; touch-action:pan-x; }
  .case-lightbox-track::-webkit-scrollbar { display:none; }
  .case-lightbox-track img { flex:0 0 100%; width:100%; height:100%; padding:0; object-fit:contain; object-position:center; background:#080808; scroll-snap-align:start; scroll-snap-stop:normal; }
  .case-lightbox-switcher { display:flex; flex:none; gap:8px; min-height:45px; }
  .case-lightbox-switcher button { width:45px; height:45px; padding:0; border:1px solid #555; border-radius:50%; background:transparent; color:#999; font:500 12px var(--font-body); cursor:pointer; transition:border-color .25s ease,background .25s ease,color .25s ease; }
  .case-lightbox-switcher button:hover,.case-lightbox-switcher button:focus-visible,.case-lightbox-switcher button.is-active { border-color:var(--color-accent); background:var(--color-accent); color:#fff; }
  .case-lightbox-switcher button:focus-visible { outline:2px solid #fff; outline-offset:2px; }

  @media(max-width:900px){
    .use-case { grid-template-columns:1fr; gap:30px; padding:48px 0 58px; }
    .case-body { max-width:680px; padding:0 2px; }
    h2 { margin-top:26px; }
  }
  @media(max-width:520px){
    .use-case { gap:24px; padding:34px 0 46px; }
    .case-media { position:relative; grid-template-rows:auto auto; aspect-ratio:auto; overflow:visible; border:0; border-radius:0; background:transparent; }
    .case-preview {
      box-sizing:border-box;
      height:auto;
      aspect-ratio:var(--case-preview-ratio);
      border:1px solid color-mix(in srgb,var(--color-heading) 14%,transparent);
      border-radius:10px;
      background:#fff;
      box-shadow:0 2px 8px rgb(17 17 17 / 5%);
      touch-action:pan-y;
    }
    .case-slides { background:transparent; }
    .case-slides img { padding:0; }
    .case-media-toolbar { display:grid; grid-template-columns:1fr; gap:0; min-height:54px; padding:2px 0 4px; border-top:0; border-bottom:0; background:transparent; }
    .case-media-toolbar:has(.case-live-link) { border-bottom:0; }
    .case-live-link {
      grid-row:2;
      justify-self:stretch;
      width:100%;
      min-height:50px;
      margin-top:4px;
      padding:8px 2px 4px;
      border-radius:0;
      font-size:13px;
    }
    .case-live-link>span:last-child {
      display:block;
      width:auto;
      height:auto;
      border-radius:0;
      background:transparent;
      color:var(--color-accent);
    }
    .case-live-link svg { width:18px; height:18px; }
    .case-live-link:hover,
    .case-live-link:focus-visible { background:transparent; }
    .case-controls { display:grid; grid-row:1; grid-template-columns:44px 1fr 44px; align-items:center; width:100%; gap:8px; margin:0; }
    .case-controls span { position:static; grid-column:2; grid-row:1; min-width:48px; justify-self:center; }
    .case-controls button { position:static; z-index:3; width:44px; height:44px; border:1px solid color-mix(in srgb,var(--color-heading) 22%,transparent); border-radius:50%; background:rgb(255 255 255 / 76%); box-shadow:0 5px 14px rgb(17 17 17 / 10%),inset 0 1px 0 #fff; color:var(--color-heading); font-size:20px; text-shadow:none; transform:none; -webkit-backdrop-filter:blur(8px); backdrop-filter:blur(8px); }
    .case-controls button:hover,.case-controls button:focus-visible { border-color:var(--color-accent); background:#fff; color:var(--color-accent); outline:none; }
    .case-controls button:focus:not(:focus-visible) { outline:none; }
    .case-controls button[data-prev] { grid-column:1; grid-row:1; justify-self:start; }
    .case-controls button[data-next] { grid-column:3; grid-row:1; justify-self:end; }
    h2 { margin-top:24px; font-size:34px; }
    .case-copy { margin-top:20px; font-size:14px; }
    .case-stack { margin-top:24px; padding-top:20px; border-top:0; }
    .case-lightbox-shell { gap:16px; padding:6vh 4vw; }
    .case-lightbox-close { top:18px; right:18px; }
    .case-lightbox-device { width:min(92vw,var(--case-lightbox-mobile-width-by-height)); max-height:72dvh; border-radius:14px; }
    .case-lightbox-switcher { gap:12px; min-height:30px; }
    .case-lightbox-switcher button { width:30px; height:30px; border-color:rgb(255 255 255 / 24%); font-size:11px; }
  }
  @media(prefers-reduced-motion:reduce){.case-slides,.case-controls button,.case-preview-icon,.case-live-link,.case-study-link,.case-lightbox-track,.case-lightbox-switcher button{transition:none;scroll-behavior:auto}.case-preview:hover .case-preview-icon,.case-preview:focus-visible .case-preview-icon,.case-study-link:hover{transform:none}}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const slides = slider.querySelector<HTMLElement>('[data-slides]');
    if (!slides || slider.dataset.ready === 'true') return;
    slider.dataset.ready = 'true';
    const sourceImages = [...slides.querySelectorAll<HTMLImageElement>('img')];
    const count = sourceImages.length;
    const card = slider.closest<HTMLElement>('.use-case');
    const expand = slider.querySelector<HTMLButtonElement>('[data-expand]');
    const lightbox = card?.querySelector<HTMLDialogElement>('[data-lightbox]');
    const lightboxShell = lightbox?.querySelector<HTMLElement>('.case-lightbox-shell');
    const lightboxTrack = lightbox?.querySelector<HTMLElement>('[data-lightbox-track]');
    const lightboxClose = lightbox?.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    const lightboxButtons = [...(lightbox?.querySelectorAll<HTMLButtonElement>('[data-lightbox-slide]') || [])];
    const sliderCount = slider.querySelector<HTMLElement>('[data-slider-count]');
    const lightboxImages = [...(lightboxTrack?.querySelectorAll<HTMLImageElement>('img') || [])];
    // Slides other than the first ship a 1×1 placeholder (see the markup). The real source is
    // attached the moment the visitor touches, hovers or focuses the card (a swipe or a click
    // on “next” starts with one of those), on a slide change, and when the lightbox opens.
    const hydrate = (img: HTMLImageElement | undefined) => {
      if (!img?.dataset.src) return;
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src;
      delete img.dataset.src;
      delete img.dataset.srcset;
    };
    const hydrateSlides = () => sourceImages.forEach(hydrate);
    for (const type of ['pointerenter', 'touchstart', 'focusin'] as const) {
      card?.addEventListener(type, hydrateSlides, { once: true, passive: true });
    }
    let activeIndex = 0;
    const updateActiveState = (nextIndex: number) => {
      activeIndex = Math.min(count - 1, Math.max(0, nextIndex));
      hydrate(sourceImages[activeIndex]);
      slides.style.transform = `translateX(-${activeIndex * 100}%)`;
      if (sliderCount) sliderCount.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(count).padStart(2, '0')}`;
      lightboxButtons.forEach((button, buttonIndex) => {
        const isActive = buttonIndex === activeIndex;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
    };
    const go = (nextIndex: number, scrollLightbox = false) => {
      updateActiveState((nextIndex + count) % count);
      if (scrollLightbox && lightboxTrack) {
        lightboxTrack.scrollTo({ left: activeIndex * lightboxTrack.clientWidth, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      }
    };
    let suppressExpand = false;
    const bindSwipe = (target: HTMLElement | null | undefined, onSwipe: (direction: number) => void) => {
      if (!target || count < 2) return;
      let startX = 0;
      let startY = 0;
      target.addEventListener('touchstart', (event) => {
        const touch = event.changedTouches[0];
        startX = touch.clientX;
        startY = touch.clientY;
      }, { passive: true });
      target.addEventListener('touchend', (event) => {
        const touch = event.changedTouches[0];
        const deltaX = touch.clientX - startX;
        const deltaY = touch.clientY - startY;
        if (Math.abs(deltaX) < 44 || Math.abs(deltaX) <= Math.abs(deltaY) * 1.2) return;
        onSwipe(deltaX < 0 ? 1 : -1);
      }, { passive: true });
    };
    bindSwipe(expand, (direction) => {
      suppressExpand = true;
      go(activeIndex + direction);
      window.setTimeout(() => { suppressExpand = false; }, 450);
    });
    slider.querySelector('[data-prev]')?.addEventListener('click', () => go(activeIndex - 1));
    slider.querySelector('[data-next]')?.addEventListener('click', () => go(activeIndex + 1));
    lightboxButtons.forEach((button) => button.addEventListener('click', () => go(Number(button.dataset.lightboxSlide), true)));
    let lightboxScrollFrame = 0;
    lightboxTrack?.addEventListener('scroll', () => {
      if (lightboxScrollFrame) return;
      lightboxScrollFrame = requestAnimationFrame(() => {
        lightboxScrollFrame = 0;
        if (!lightboxTrack.clientWidth) return;
        updateActiveState(Math.round(lightboxTrack.scrollLeft / lightboxTrack.clientWidth));
      });
    }, { passive: true });
    expand?.addEventListener('click', (event) => {
      if (suppressExpand) {
        event.preventDefault();
        suppressExpand = false;
        return;
      }
      if (!lightbox) return;
      document.documentElement.classList.add('case-lightbox-open');
      lightboxImages.forEach(hydrate);
      lightbox.showModal();
      requestAnimationFrame(() => {
        if (lightboxTrack) lightboxTrack.scrollLeft = activeIndex * lightboxTrack.clientWidth;
        lightboxClose?.focus();
      });
    });
    lightboxClose?.addEventListener('click', () => lightbox?.close());
    lightbox?.addEventListener('click', (event) => { if (event.target === lightbox || event.target === lightboxShell) lightbox.close(); });
    lightbox?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') go(activeIndex - 1, true);
      if (event.key === 'ArrowRight') go(activeIndex + 1, true);
    });
    lightbox?.addEventListener('close', () => {
      document.documentElement.classList.remove('case-lightbox-open');
      expand?.focus();
    });
  });
</script>
