---
import { publicFileExists } from '../lib/public-file';

interface Props {
  kind?: 'image' | 'video';
  src: string;
  poster?: string;
  alt: string;
  label: string;
  brief: string;
  caption?: string;
  width: number;
  height: number;
  frame?: 'phone' | 'browser' | 'plain';
  browserHost?: string;
  priority?: boolean;
  class?: string;
}

const {
  kind = 'image',
  src,
  poster,
  alt,
  label,
  brief,
  caption,
  width,
  height,
  frame = 'plain',
  browserHost,
  priority = false,
  class: className,
} = Astro.props;

const hasMedia = publicFileExists(src);
const hasPoster = poster ? publicFileExists(poster) : false;
const fileName = src.split('/').at(-1) ?? src;
const kindLabel = kind === 'video' ? 'Video' : 'Screenshot';
---

<figure
  class:list={['case-media', `frame-${frame}`, className, { 'has-media': hasMedia }]}
  style={`--media-ratio:${width}/${height}`}
  data-case-media
  data-kind={kind}
>
  {frame === 'browser' ? (
    <div class="case-media-browser">
      <div class="case-media-browser-bar" aria-hidden="true">
        <span></span><span></span><span></span>
        {browserHost && <code>{browserHost}</code>}
      </div>
      <div class="case-media-surface">
        {hasMedia ? (
          kind === 'video' ? (
            <>
              <video
                class="case-media-video"
                src={src}
                poster={hasPoster ? poster : undefined}
                width={width}
                height={height}
                muted
                playsinline
                loop
                preload="none"
                data-case-video
                aria-label={alt}
              ></video>
              <button type="button" class="case-media-pause" data-case-video-toggle aria-pressed="false" aria-label="Pause video">
                <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><rect x="4" y="3" width="4" height="14" rx="1"/><rect x="12" y="3" width="4" height="14" rx="1"/></svg>
              </button>
            </>
          ) : (
            <img
              src={src}
              alt={alt}
              width={width}
              height={height}
              loading={priority ? 'eager' : 'lazy'}
              fetchpriority={priority ? 'high' : undefined}
              decoding="async"
            />
          )
        ) : (
          <div class="case-media-placeholder" role="img" aria-label={`Reserved ${kindLabel.toLowerCase()}: ${alt}`}>
            <span>{label}</span>
            <strong>{kindLabel} reserved</strong>
            <p>{brief}</p>
            <code>{fileName}</code>
            <small>{width} × {height} recommended</small>
          </div>
        )}
      </div>
    </div>
  ) : frame === 'phone' ? (
    <div class="case-media-phone">
      <div class="case-media-phone-frame">
        <div class="case-media-surface">
          {hasMedia ? (
            kind === 'video' ? (
              <>
                <video
                  class="case-media-video"
                  src={src}
                  poster={hasPoster ? poster : undefined}
                  width={width}
                  height={height}
                  muted
                  playsinline
                  loop
                  preload="none"
                  data-case-video
                  aria-label={alt}
                ></video>
                <button type="button" class="case-media-pause" data-case-video-toggle aria-pressed="false" aria-label="Pause video">
                  <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><rect x="4" y="3" width="4" height="14" rx="1"/><rect x="12" y="3" width="4" height="14" rx="1"/></svg>
                </button>
              </>
            ) : (
              <img
                src={src}
                alt={alt}
                width={width}
                height={height}
                loading={priority ? 'eager' : 'lazy'}
                fetchpriority={priority ? 'high' : undefined}
                decoding="async"
              />
            )
          ) : (
            <div class="case-media-placeholder" role="img" aria-label={`Reserved ${kindLabel.toLowerCase()}: ${alt}`}>
              <span>{label}</span>
              <strong>{kindLabel} reserved</strong>
              <p>{brief}</p>
              <code>{fileName}</code>
              <small>{width} × {height}</small>
            </div>
          )}
        </div>
      </div>
    </div>
  ) : (
    <div class="case-media-surface case-media-plain">
      {hasMedia ? (
        kind === 'video' ? (
          <>
            <video
              class="case-media-video"
              src={src}
              poster={hasPoster ? poster : undefined}
              width={width}
              height={height}
              muted
              playsinline
              loop
              preload="none"
              data-case-video
              aria-label={alt}
            ></video>
            <button type="button" class="case-media-pause" data-case-video-toggle aria-pressed="false" aria-label="Pause video">
              <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><rect x="4" y="3" width="4" height="14" rx="1"/><rect x="12" y="3" width="4" height="14" rx="1"/></svg>
            </button>
          </>
        ) : (
          <img
            src={src}
            alt={alt}
            width={width}
            height={height}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
          />
        )
      ) : (
        <div class="case-media-placeholder" role="img" aria-label={`Reserved ${kindLabel.toLowerCase()}: ${alt}`}>
          <span>{label}</span>
          <strong>{kindLabel} reserved</strong>
          <p>{brief}</p>
          <code>{fileName}</code>
          <small>{width} × {height} recommended</small>
        </div>
      )}
    </div>
  )}

  {caption ? (
    <figcaption>
      <span>{label}</span>
      {caption}
    </figcaption>
  ) : null}
</figure>

<style>
  .case-media { margin:0; min-width:0; }
  .case-media-surface {
    position:relative;
    aspect-ratio:var(--media-ratio);
    overflow:hidden;
    background:#0b0b0a;
  }
  .case-media-plain {
    border:1px solid rgb(255 255 255 / 14%);
    border-radius:14px;
    box-shadow:0 26px 70px rgb(0 0 0 / 16%);
  }
  .case-media img,
  .case-media-video {
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
    object-position:center;
  }
  .case-media-pause {
    position:absolute;
    right:12px;
    bottom:12px;
    z-index:2;
    display:grid;
    place-items:center;
    width:40px;
    height:40px;
    min-width:44px;
    min-height:44px;
    border:1px solid rgb(255 255 255 / 22%);
    border-radius:999px;
    background:rgb(17 17 16 / 78%);
    color:#fff;
    cursor:pointer;
    backdrop-filter:blur(8px);
  }
  .case-media-pause svg { fill:currentColor; }
  .case-media-pause[aria-pressed="true"] svg { display:none; }
  .case-media-pause[aria-pressed="true"]::after {
    content:'';
    width:0;
    height:0;
    border-style:solid;
    border-width:6px 0 6px 10px;
    border-color:transparent transparent transparent currentColor;
    margin-left:2px;
  }
  .case-media-pause:focus-visible { outline:3px solid var(--color-accent); outline-offset:3px; }

  .case-media-placeholder {
    position:absolute;
    inset:0;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    gap:0;
    padding:22px 18px;
    color:#fff;
    text-align:center;
    background-color:#191918;
    background-image:
      linear-gradient(rgb(255 255 255 / 5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(255 255 255 / 5%) 1px, transparent 1px);
    background-size:28px 28px;
  }
  .case-media-placeholder::before {
    content:'';
    position:absolute;
    inset:14px;
    border:1px dashed rgb(255 255 255 / 20%);
    border-radius:8px;
    pointer-events:none;
  }
  .case-media-placeholder span {
    color:var(--color-accent);
    font-size:10px;
    font-weight:600;
    letter-spacing:.14em;
    text-transform:uppercase;
  }
  .case-media-placeholder strong {
    margin-top:12px;
    font:500 clamp(18px,2.4vw,28px)/1.05 var(--font-heading);
    letter-spacing:-.04em;
  }
  .case-media-placeholder p {
    max-width:28ch;
    margin:12px 0 0;
    color:#c8c5bd;
    font-size:12px;
    line-height:1.45;
  }
  .case-media-placeholder code {
    margin-top:14px;
    padding:6px 9px;
    border-radius:4px;
    background:rgb(255 255 255 / 8%);
    color:#c8c5bd;
    font-size:10px;
  }
  .case-media-placeholder small {
    margin-top:8px;
    color:#77746e;
    font-size:10px;
  }

  .case-media-phone { display:flex; justify-content:center; }
  .case-media-phone-frame {
    width:min(100%, 320px);
    padding:8px;
    border:1px solid rgb(255 255 255 / 22%);
    border-radius:34px;
    background:#050505;
    box-shadow:0 0 0 6px #1b1b1a, 0 40px 90px rgb(0 0 0 / 45%);
  }
  .case-media-phone-frame .case-media-surface { border-radius:26px; }
  .case-media-phone-frame .case-media-placeholder::before { border-radius:18px; }

  .case-media-browser {
    overflow:hidden;
    border:1px solid rgb(255 255 255 / 14%);
    border-radius:14px;
    background:#0b0b0a;
    box-shadow:0 40px 100px rgb(0 0 0 / 45%);
  }
  .case-media-browser-bar {
    display:flex;
    align-items:center;
    gap:7px;
    height:38px;
    padding:0 14px;
    border-bottom:1px solid rgb(255 255 255 / 14%);
    background:#1b1b1a;
  }
  .case-media-browser-bar span {
    width:9px;
    height:9px;
    border-radius:2px;
    background:rgb(255 255 255 / 18%);
  }
  .case-media-browser-bar code {
    margin-left:12px;
    padding:4px 10px;
    border-radius:4px;
    background:rgb(255 255 255 / 6%);
    color:#a3a09a;
    font:500 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  figcaption {
    display:grid;
    grid-template-columns:auto 1fr;
    gap:14px;
    margin-top:14px;
    color:#77746e;
    font-size:12px;
    line-height:1.5;
  }
  figcaption span {
    color:#a3a09a;
    font:600 10px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    letter-spacing:.12em;
    text-transform:uppercase;
  }

  @media (max-width:560px) {
    .case-media-phone-frame { width:min(100%, 280px); border-radius:28px; }
    .case-media-phone-frame .case-media-surface { border-radius:22px; }
    .case-media-browser { border-radius:9px; }
    .case-media-browser-bar { height:30px; }
    .case-media-plain { border-radius:9px; }
    .case-media-placeholder::before { inset:10px; }
    figcaption { grid-template-columns:1fr; gap:4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-media-video { display:none; }
    .case-media-pause { display:none; }
    .has-media .case-media-surface::after {
      content:attr(data-fallback);
    }
  }
</style>
