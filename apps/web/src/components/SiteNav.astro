---
import { getCollection } from 'astro:content';
import site from '../content/site.yaml';

interface Props {
  /** Home page uses in-page hash links; other routes use /#section. */
  home?: boolean;
}

const { home = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const section = (id: string) => (home ? `#${id}` : `/#${id}`);
const labEntries = (await getCollection('lab')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
const exploreCta: Record<string, string> = {
  'time-2-route': 'Explore the project ↗︎',
  'barcelona-crime-map': 'Explore the research ↗︎',
};
---

<header class="nav">
  <a class="logo" href={home ? '#' : '/'} aria-label="time2map — home">
    <img src="/images/logo.svg" alt="time2map" width="309" height="76" />
  </a>
  <nav id="site-navigation" aria-label="Primary navigation">
    <a class="nav-link" href={section('expertise')}>Expertise</a>
    <a class="nav-link" href={section('work')}>Work</a>
    <a class="nav-link" href={section('process')}>Process</a>
    <a class="nav-link" href="/use-cases" aria-current={path === '/use-cases' ? 'page' : undefined}>Use Cases</a>
    <a class="nav-link" href="/contact-us" aria-current={path === '/contact-us' ? 'page' : undefined}>Contact Us</a>
    <details class="lab-nav">
      <summary>Lab <span class="lab-chevron" aria-hidden="true"><i></i></span></summary>
      <div class="lab-dropdown">
        {labEntries.map((entry) => (
          <a href={`/lab/${entry.id}`}>
            <div class="lab-card-meta">
              <small>{entry.data.displayDate}</small>
              <small>{entry.data.readTime}</small>
            </div>
            <strong>{entry.data.navLabel}</strong>
            <span>{entry.data.description}</span>
            <em>{exploreCta[entry.id] ?? 'Explore ↗︎'}</em>
          </a>
        ))}
      </div>
    </details>
    <a class="nav-mobile-cta" href={site.bookCallUrl} target="_blank" rel="noopener">
      <span>Book a call</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
    </a>
  </nav>
  <a class="pill pill-accent" href={site.bookCallUrl} target="_blank" rel="noopener" aria-label="Book a call">
    <span class="pill-label">Book a call</span>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/></svg>
  </a>
  <button class="nav-menu-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open menu">
    <span></span><span></span>
  </button>
</header>

<script>
  const siteNavHeader = document.querySelector<HTMLElement>('.nav');
  const siteNavigation = siteNavHeader?.querySelector<HTMLElement>('#site-navigation');
  const menuToggle = siteNavHeader?.querySelector<HTMLButtonElement>('.nav-menu-toggle');
  const labNav = document.querySelector<HTMLDetailsElement>('.lab-nav');
  const closeMenu = (restoreFocus = false) => {
    siteNavHeader?.classList.remove('is-menu-open');
    document.documentElement.classList.remove('nav-menu-open');
    document.querySelectorAll<HTMLElement>('body > main, body > .site-footer').forEach((element) => { element.inert = false; });
    menuToggle?.setAttribute('aria-expanded', 'false');
    menuToggle?.setAttribute('aria-label', 'Open menu');
    if (labNav) labNav.open = false;
    if (restoreFocus) menuToggle?.focus();
  };

  menuToggle?.addEventListener('click', () => {
    const willOpen = !siteNavHeader?.classList.contains('is-menu-open');
    siteNavHeader?.classList.toggle('is-menu-open', willOpen);
    document.documentElement.classList.toggle('nav-menu-open', willOpen);
    document.querySelectorAll<HTMLElement>('body > main, body > .site-footer').forEach((element) => { element.inert = willOpen; });
    menuToggle.setAttribute('aria-expanded', String(willOpen));
    menuToggle.setAttribute('aria-label', willOpen ? 'Close menu' : 'Open menu');
  });
  siteNavigation?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMenu();
  });
  siteNavHeader?.querySelector('.logo')?.addEventListener('click', () => closeMenu());
  siteNavHeader?.querySelector(':scope > .pill')?.addEventListener('click', () => closeMenu());
  window.addEventListener('resize', () => {
    if (window.innerWidth > 800) closeMenu();
  });
  if (labNav) {
    const closeLabNav = () => {
      labNav.open = false;
    };
    document.addEventListener('pointerdown', (event) => {
      if (!labNav.open) return;
      if (event.target instanceof Node && !labNav.contains(event.target)) closeLabNav();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (siteNavHeader?.classList.contains('is-menu-open')) closeMenu(true);
      else if (labNav.open) closeLabNav();
    });
  }
</script>
