---
import '../../styles/global.css';
import '../../styles/palette.css';
import SeoHead from '../../components/SeoHead.astro';
import SiteNav from '../../components/SiteNav.astro';
import site from '../../content/site.yaml';
import {
  ARCHI2GO_APP_STORE_URL,
  ARCHI2GO_PLAY_STORE_AVAILABLE,
  ARCHI2GO_PLAY_STORE_URL,
} from '../../lib/archi2go';

const title = 'Get Archi2go';
const description = 'Download Archi2go for your phone or open the web version.';
const liveUrl = 'https://archi2go.time2map.com';
const pageUrl = new URL('/get/archi2go', site.siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: pageUrl,
  isPartOf: { '@type': 'WebSite', name: site.title, url: site.siteUrl },
};
---

<!doctype html>
<html lang="en">
<head>
  <SeoHead title={title} description={description} jsonLd={jsonLd} noindex>
    <meta name="apple-itunes-app" content="app-id=6758726197" />
  </SeoHead>
</head>
<body class="download-page">
  <SiteNav />

  <main class="download-main">
    <section class="download-card" aria-labelledby="download-title">
      <p class="download-kicker"><i aria-hidden="true"></i>Archi2go</p>
      <h1 id="download-title">Take the city<br/><em>with you</em></h1>
      <p class="download-status" data-download-status>Choose your platform to get Archi2go.</p>

      <div class="download-actions">
        <a class="store-link" href={ARCHI2GO_APP_STORE_URL} data-ios-store>
          <img src="/images/store-badges/download-on-app-store.svg" alt="Download on the App Store" width="120" height="40" />
        </a>
        {ARCHI2GO_PLAY_STORE_AVAILABLE ? (
          <a class="store-link" href={ARCHI2GO_PLAY_STORE_URL} data-android-store>
            <img src="/images/store-badges/get-it-on-google-play.svg" alt="Get it on Google Play" width="239" height="71" />
          </a>
        ) : (
          <div class="android-pending" data-android-pending>
            <strong>Google Play</strong>
            <span>Coming soon</span>
          </div>
        )}
      </div>

      <a class="web-fallback" href={liveUrl}>Open web version <span aria-hidden="true">↗</span></a>
    </section>
  </main>

  <script
    is:inline
    define:vars={{
      appStoreUrl: ARCHI2GO_APP_STORE_URL,
      playStoreUrl: ARCHI2GO_PLAY_STORE_URL,
      playStoreAvailable: ARCHI2GO_PLAY_STORE_AVAILABLE,
    }}
  >
    const userAgent = navigator.userAgent || '';
    const isIPhone = /iPhone|iPod/i.test(userAgent);
    const isAndroid = /Android/i.test(userAgent);
    const status = document.querySelector('[data-download-status]');

    if (isIPhone) {
      if (status) status.textContent = 'Opening the App Store…';
      window.location.replace(appStoreUrl);
    } else if (isAndroid && playStoreAvailable) {
      if (status) status.textContent = 'Opening Google Play…';
      window.location.replace(playStoreUrl);
    } else if (isAndroid && status) {
      status.textContent = 'The Android app is coming soon. You can use Archi2go on the web today.';
    }
  </script>
</body>
</html>

<style>
  :global(html) { background:#111110; }
  .download-page { min-height:100svh; background:#111110; color:#fff; }
  .download-main { display:grid; min-height:100svh; place-items:center; padding:calc(var(--nav-height) + 56px) 5vw 72px; }
  .download-card { width:min(100%,620px); text-align:center; }
  .download-kicker { display:flex; align-items:center; justify-content:center; gap:10px; margin:0; color:#cfccc5; font-size:12px; font-weight:600; letter-spacing:1.8px; text-transform:uppercase; }
  .download-kicker i { width:7px; height:7px; border-radius:50%; background:var(--color-accent); }
  h1 { margin:28px 0 0; font:500 clamp(54px,8vw,94px)/.9 var(--font-heading); letter-spacing:-.06em; }
  h1 em { color:#dedbd4; font-style:normal; }
  .download-status { max-width:44ch; margin:28px auto 0; color:#cfccc5; font-size:16px; line-height:1.6; }
  .download-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:12px; margin-top:30px; }
  .store-link { display:flex; align-items:center; min-height:52px; border-radius:8px; transition:transform .2s ease; }
  .store-link img { display:block; width:auto; height:52px; }
  .android-pending { display:grid; align-content:center; min-height:52px; padding:7px 22px; border:1px solid rgb(255 255 255 / 32%); border-radius:8px; background:#1b1b19; text-align:left; }
  .android-pending strong { font-size:13px; }
  .android-pending span { margin-top:3px; color:#aaa79f; font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  .web-fallback { display:inline-flex; gap:10px; margin-top:34px; padding-bottom:5px; border-bottom:1px solid #6d6a64; color:#cfccc5; font-size:14px; }
  .store-link:focus-visible,.web-fallback:focus-visible { outline:3px solid #fff; outline-offset:4px; }
  @media (hover:hover) and (pointer:fine) {
    .store-link:hover { transform:translateY(-2px); }
    .web-fallback:hover { border-color:#fff; color:#fff; }
  }
  @media (max-width:520px) {
    .download-main { padding-inline:6vw; }
    .download-actions { align-items:stretch; flex-direction:column; }
    .store-link,.android-pending { justify-content:center; min-width:210px; }
    .android-pending { text-align:center; }
    .store-link img { height:48px; }
  }
  @media (prefers-reduced-motion:reduce) {
    .store-link { transition:none; }
  }
</style>
