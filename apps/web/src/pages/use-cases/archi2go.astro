  .hero-demo-copy .demo-cue { max-width:44ch; margin:28px 0 0; padding-top:16px; border-top:1px solid var(--a-line-dark); color:#cfccc5; font:500 11px/1.4 var(--a-mono); letter-spacing:.06em; text-transform:uppercase; }

