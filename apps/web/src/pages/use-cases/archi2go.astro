---
import '../../styles/global.css';
import '../../styles/palette.css';
import BackToUseCases from '../../components/BackToUseCases.astro';
import CaseMedia from '../../components/CaseMedia.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import SeoHead from '../../components/SeoHead.astro';
import site from '../../content/site.yaml';
import { breadcrumbSchema } from '../../lib/schema';

const title = 'Archi2go — Map for Travelling Architects';
const description = 'Archi2go: a React Native + Mapbox city guide for architects who travel — curated places, fast 3D maps, on iOS, Android and web.';
const pageUrl = new URL('/use-cases/archi2go', site.siteUrl).href;
const liveUrl = 'https://archi2go.time2map.com';
const liveHost = new URL(liveUrl).host;
const appStoreUrl = 'https://apps.apple.com/app/archi2go';
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.time2map.archi2go';
const heroImage = '/images/use-cases/archi2go-prev.webp';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: 'Archi2go: Architecture Map for Travelling Architects',
    description,
    url: pageUrl,
    image: new URL(heroImage, site.siteUrl).href,
    creator: { '@type': 'Organization', name: site.title, url: site.siteUrl },
    keywords: 'architecture map, travel, React Native, Mapbox, iOS, Android, 3D buildings, city guide',
  },
  breadcrumbSchema([
    { name: 'Home', item: site.siteUrl },
    { name: 'Use Cases', item: new URL('/use-cases', site.siteUrl).href },
    { name: 'Archi2go', item: pageUrl },
  ]),
];

const audience = [
  {
    title: 'Planning the trip at home',
    text: 'Pick a city and read down the list, strongest places first. Shortlist the ones worth the detour before you even land.',
    src: '/images/use-cases/archi2go/mobile-case-plan.webp',
    brief: 'Phone: ranked place list for Barcelona — first items with photo, name, category and the first line of the story; map visible behind the sheet.',
    alt: 'Archi2go ranked place list for a city, strongest places first',
    label: 'Plan',
    cue: 'Ranked list / Strongest first',
  },
  {
    title: 'Who built this, and why',
    text: 'Architect, year and a short story for each building, with sources to read further.',
    src: '/images/use-cases/archi2go/mobile-case-story.webp',
    brief: 'Phone: place card for a building such as Walden 7 — photo carousel, architect and year, description, photo credit, Read more sources.',
    alt: 'Archi2go place card with architect, year, story, photo credit and sources',
    label: 'Story',
    cue: 'Architect / Year / Sources',
  },
  {
    title: 'Landing in the city',
    text: 'The app opens on the city you are standing in. Check a place on the map, then hand it to Google Maps for the walk.',
    src: '/images/use-cases/archi2go/mobile-case-onsite.webp',
    brief: 'Phone: map of the current city on first launch, one place selected, place sheet at half height with the Open in Google Maps button visible.',
    alt: 'Archi2go opened on the current city with a selected place and the Open in Google Maps button',
    label: 'On site',
    cue: 'Map / Open in Google Maps',
  },
];

const journey = [
  {
    id: 'architecture',
    tag: 'Architecture',
    title: 'Buildings with an author',
    text: 'The core of the collection: strong architecture by named architects — style, year and a short story for each building.',
    eg: 'Architects / Style / Year',
    kind: 'image' as const,
    src: '/images/use-cases/archi2go/mobile-journey-01-architecture.webp',
    brief: 'Phone: Architecture tab — Mercat de Santa Caterina and El Born CCM in the grid; photo markers on the map above.',
    alt: 'Archi2go Architecture tab with Mercat de Santa Caterina and El Born CCM',
  },
  {
    id: 'city-core',
    tag: 'City core',
    title: 'The names everyone knows',
    text: 'Landmarks and the streets that connect them, so a first walk covers the essentials without a detour.',
    eg: 'Squares / Avenues / Landmarks',
    kind: 'image' as const,
    src: '/images/use-cases/archi2go/mobile-journey-02-city-core.webp',
    brief: 'Phone: City core tab — Barcelona Pavilion and Casa Batlló in the grid; photo markers on the map above.',
    alt: 'Archi2go City core tab with Barcelona Pavilion and Casa Batlló',
  },
  {
    id: 'parks',
    tag: 'Parks',
    title: 'Where the city exhales',
    text: 'Parks and gardens where landscape is part of the design — a place to pause between buildings.',
    eg: 'Parks / Gardens / Green squares',
    kind: 'image' as const,
    src: '/images/use-cases/archi2go/mobile-journey-03-parks.webp',
    brief: 'Phone: Parks tab — Gardens of the Palau de Pedralbes and Parc Central de Nou Barris; photo markers on the map above.',
    alt: 'Archi2go Parks tab with Pedralbes gardens and Parc Central de Nou Barris',
  },
  {
    id: 'unusual',
    tag: 'Unusual',
    title: 'The ones you would miss',
    text: 'Odd, hidden and unexpected places that do not fit a neat label but earn the detour.',
    eg: 'Odd / Hidden / Unexpected',
    kind: 'image' as const,
    src: '/images/use-cases/archi2go/mobile-journey-04-unusual.webp',
    brief: 'Phone: Unusual tab — Edifici Atalaya and Montjuïc Communications Tower in the grid; map above.',
    alt: 'Archi2go Unusual tab with Edifici Atalaya and Montjuïc Communications Tower',
  },
];

const platformStack = [
  ['Web', 'A responsive map for planning at the desk.', 'TypeScript / Mapbox GL JS'],
  ['Native', 'One shared app for the street.', 'React Native / Mapbox / iOS + Android'],
];

const heroMapImage = '/images/use-cases/archi2go/hero-map-bg.webp';
---

<!doctype html>
<html lang="en">
<head>
  <SeoHead title={title} description={description} ogImage={heroImage} jsonLd={jsonLd} />
</head>
<body class="archi-case-page">
  <SiteNav />

  <main>
    <!-- 1. Hero -->
    <header class="archi-hero" data-archi-hero>
      <div class="hero-map" aria-hidden="true">
        <div class="hero-map-camera" style={`--hero-map-image:url(${heroMapImage})`}></div>
      </div>
      <div class="archi-shell hero-nav-row"><BackToUseCases /></div>

      <div class="archi-shell hero-copy">
        <div>
          <p class="kicker"><i class="marker" aria-hidden="true"></i>Case study / Archi2go</p>
          <h1>A map for architects who <em>travel</em></h1>
        </div>
        <div class="hero-intro">
          <p>Curated architecture, public space and unusual city stories — built as a React Native app with Mapbox, so it feels fast on the street and still works at the desk.</p>
          <div class="store-row">
            <a class="store-badge" href={appStoreUrl} target="_blank" rel="noopener" aria-label="Download on the App Store">
              <img src="/images/store-badges/download-on-app-store.svg" alt="" width="120" height="40" />
            </a>
            <a class="store-badge" href={playStoreUrl} target="_blank" rel="noopener" aria-label="Get it on Google Play">
              <img src="/images/store-badges/get-it-on-google-play.svg" alt="" width="239" height="71" />
            </a>
          </div>
          <a class="text-link hero-web-link" href={liveUrl} target="_blank" rel="noopener">Open web version</a>
        </div>
      </div>

      <div class="archi-shell hero-demo">
        <div class="hero-phone">
          <CaseMedia
            kind="video"
            frame="phone"
            src="/images/use-cases/archi2go/mobile-hero-demo.mp4"
            poster="/images/use-cases/archi2go/mobile-hero-demo-poster.webp"
            alt="Archi2go demo: open a place, read its story and location, then see the building in 3D"
            label="Demo"
            brief="Phone demo from preview.mov — place card with architect, year and story; map location; 3D building context. Muted, loop."
            width={612}
            height={1324}
            priority
          />
        </div>
        <div class="hero-demo-copy">
          <p class="demo-tag">In motion</p>
          <h2>Tap a place <em>Get the full picture</em></h2>
          <p>Architect, year, story and sources on the card. Exact spot on the map. The building in 3D, with its neighbours.</p>
          <p class="demo-cue">Story / Architect / Location / 3D</p>
        </div>
      </div>

    </header>

    <!-- 2. Who it's for -->
    <section class="section section-paper" aria-labelledby="audience-title">
      <div class="archi-shell split-heading">
        <p class="section-index"><i class="marker" aria-hidden="true"></i>Who it’s for</p>
        <div>
          <h2 id="audience-title">Built for people who notice <em>buildings</em></h2>
          <p class="lead">Not another POI dump. A considered collection for architects, students and design-minded travellers who want the city to stay readable on foot.</p>
        </div>
      </div>
      <div
        class="archi-shell aud-carousel"
        data-aud-carousel
        role="group"
        aria-roledescription="carousel"
        aria-label="How people use Archi2go"
      >
        <div class="aud-stage-wrap">
        <button type="button" class="aud-arrow aud-arrow-prev" data-aud-prev aria-label="Previous screen">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="aud-arrow aud-arrow-next" data-aud-next aria-label="Next screen">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="aud-stage" data-aud-stage>
          <ul class="aud-track">
            {audience.map((item, index) => (
              <li
                class="aud-slide"
                data-aud-slide
                data-state={index === 0 ? 'active' : index === 1 ? 'next' : 'far-next'}
                role="group"
                aria-roledescription="slide"
                aria-label={`${index + 1} of ${audience.length}`}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <CaseMedia
                  kind="image"
                  frame="phone"
                  src={item.src}
                  alt={item.alt}
                  label={item.label}
                  brief={item.brief}
                  width={780}
                  height={1691}
                />
              </li>
            ))}
          </ul>
        </div>
        </div>

        <div class="aud-copy" aria-live="polite">
          {audience.map((item, index) => (
            <div class="aud-copy-item" data-aud-copy data-active={index === 0 ? 'true' : 'false'}>
              <h3>{item.title}</h3>
              <p class="aud-text">{item.text}</p>
              <p class="aud-cue">{item.cue}</p>
            </div>
          ))}
        </div>

        <div class="aud-controls">
          <div class="aud-dots" role="tablist" aria-label="Choose screen">
            {audience.map((item, index) => (
              <button
                type="button"
                class="aud-dot"
                role="tab"
                data-aud-dot
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-label={item.title}
              ></button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Scroll journey -->
    <section class="section section-dark" aria-labelledby="journey-title" data-archi-journey>
      <div class="archi-shell split-heading">
        <p class="section-index"><i class="marker" aria-hidden="true"></i>Place types</p>
        <div>
          <h2 id="journey-title">Four ways to read a <em>city</em></h2>
          <p class="lead">Pick a type and the list narrows to it — from authored buildings to the quiet corners nobody put on a postcard.</p>
          </div>
      </div>

      <div class="archi-shell journey-desktop">
        <div class="journey-phone-sticky">
          {journey.map((step, index) => (
            <div class="journey-screen" data-journey-screen={step.id} data-active={index === 0 ? 'true' : 'false'}>
              <CaseMedia
                kind={step.kind}
                frame="phone"
                src={step.src}
                alt={step.alt}
                label={step.tag}
                brief={step.brief}
                width={780}
                height={1691}
                caption=""
              />
            </div>
          ))}
        </div>
        <ol class="journey-steps">
          {journey.map((step, index) => (
            <li class="journey-step" data-journey-step={step.id} data-active={index === 0 ? 'true' : 'false'}>
              <i class="node" aria-hidden="true"></i>
              <div>
                <p class="step-tag">{step.tag}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <p class="step-eg">{step.eg}</p>
              </div>
            </li>
            ))}
          </ol>
        </div>

      <!-- Tablet / narrow desktop: stacked steps, each with its own phone -->
      <ol class="archi-shell journey-stack">
        {journey.map((step) => (
          <li>
            <div class="journey-stack-copy">
              <i class="node is-on" aria-hidden="true"></i>
              <div>
                <p class="step-tag">{step.tag}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <p class="step-eg">{step.eg}</p>
              </div>
            </div>
            <CaseMedia
              kind={step.kind}
              frame="phone"
              src={step.src}
              alt={step.alt}
              label={step.tag}
              brief={step.brief}
              width={780}
              height={1691}
              caption=""
            />
          </li>
        ))}
      </ol>

      <!-- Phone: one phone, app-style type tabs above, swipeable cards below -->
      <div class="archi-shell journey-mobile" data-journey-mobile>
        <div class="jm-tabs" aria-label="Place types">
          {journey.map((step, index) => (
            <button type="button" class="jm-tab" data-jm-tab aria-pressed={index === 0 ? 'true' : 'false'}>{step.tag}</button>
          ))}
        </div>
        <div class="jm-phone" data-jm-phone>
          {journey.map((step, index) => (
            <div class="jm-screen" data-jm-screen data-active={index === 0 ? 'true' : 'false'}>
              <CaseMedia
                kind={step.kind}
                frame="phone"
                src={step.src}
                alt={step.alt}
                label={step.tag}
                brief={step.brief}
                width={780}
                height={1691}
                caption=""
              />
            </div>
          ))}
        </div>
        <ol class="jm-track" data-jm-track>
          {journey.map((step, index) => (
            <li class="jm-card" data-jm-card data-active={index === 0 ? 'true' : 'false'}>
              <p class="step-tag"><span>{String(index + 1).padStart(2, '0')} / {String(journey.length).padStart(2, '0')}</span>{step.tag}</p>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
              <p class="step-eg">{step.eg}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. 2D / 3D compare -->
    <section class="section section-paper" aria-labelledby="compare-title" data-archi-compare>
      <div class="archi-shell split-heading">
        <p class="section-index"><i class="marker" aria-hidden="true"></i>Spatial feel</p>
        <div>
          <h2 id="compare-title">Tilt the map<br/><em>See the city in 3D</em></h2>
      </div>
      </div>
      <div class="archi-shell compare-stage" style="--pos:50%" data-compare-stage>
        <div class="compare-layers" role="img" aria-label="Drag to compare 2D overview and 3D view of the same place">
          <div class="compare-layer compare-base">
            <img
              src="/images/use-cases/archi2go/compare-3d.webp"
              alt=""
              width="1600"
              height="951"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
          <div class="compare-layer compare-reveal">
            <img
              src="/images/use-cases/archi2go/compare-2d.webp"
              alt=""
              width="1600"
              height="951"
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
          <div class="compare-handle" aria-hidden="true"><i></i></div>
        </div>
        <p class="compare-tag compare-tag-2d" aria-hidden="true">2D</p>
        <p class="compare-tag compare-tag-3d" aria-hidden="true">3D</p>
        <p class="compare-note">Real building heights and shapes, <em>smooth in your hand</em> — pan, tilt and zoom the same city without a stutter.</p>
      </div>
    </section>

    <!-- 6. Web preview + platform stack -->
    <section class="section section-dark web-section" aria-labelledby="web-title">
      <div class="archi-shell split-heading">
        <p class="section-index"><i class="marker" aria-hidden="true"></i>Also on the web</p>
        <div>
          <h2 id="web-title">The whole city, <em>in one view</em></h2>
        </div>
      </div>

      <div class="archi-shell web-stage" data-web-preview>
        <div class="web-preview">
          <CaseMedia
            kind="image"
            frame="browser"
            browserHost={liveHost}
            src="/images/use-cases/archi2go-prev.webp"
            alt="Archi2go web app showing a curated Barcelona place list beside the city map"
            label="Web app"
            brief="Desktop view of the Archi2go place collection and map."
            width={1600}
            height={867}
          />
          <a class="web-open-button" href={liveUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 20 20" width="17" height="17" aria-hidden="true">
              <path d="M6 14L14 6M8 6h6v6" />
            </svg>
            Open Archi2go
          </a>
        </div>
      </div>

      <div class="archi-shell platform-stack" aria-label="Technology stack">
        <p class="platform-stack-label">Built across platforms</p>
        <dl>
          {platformStack.map(([platform, description, stack]) => (
            <div>
              <dt>{platform}</dt>
              <dd>
                <span>{description}</span>
                <small>{stack}</small>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 8. CTA -->
    <section class="case-cta" aria-labelledby="cta-title">
      <div class="archi-shell">
        <p class="kicker"><i class="marker" aria-hidden="true"></i>Have a city, collection or spatial story?</p>
        <h2 id="cta-title">Let’s build the map<br/>people want to <em>explore.</em></h2>
        <div class="cta-actions">
          <a class="primary-link button-motion" href="/contact-us">
            Discuss your project
            <span aria-hidden="true"><svg viewBox="0 0 20 20" width="16" height="16"><path d="M6 14L14 6M8 6h6v6" /></svg></span>
          </a>
          <div class="store-row cta-stores">
            <a class="store-badge" href={appStoreUrl} target="_blank" rel="noopener" aria-label="Download on the App Store">
              <img src="/images/store-badges/download-on-app-store.svg" alt="" width="120" height="40" loading="lazy" decoding="async" />
            </a>
            <a class="store-badge" href={playStoreUrl} target="_blank" rel="noopener" aria-label="Get it on Google Play">
              <img src="/images/store-badges/get-it-on-google-play.svg" alt="" width="239" height="71" loading="lazy" decoding="async" />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script>
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Trackpad / horizontal wheel swipe → one step per gesture.
    // After a step, the trackpad's inertia tail (a decaying stream of deltas, up to ~1 s) is
    // swallowed. A new swipe is recognised either by a quiet gap or by the delta *speeding up
    // again*: mean of the newest 4 events vs the 4 before them (inertia only ever slows down,
    // so a rise means fingers are back on the pad).
    const bindWheelSteps = (el: HTMLElement, onStep: (dir: number) => void) => {
      const WHEEL_STEP = 28;
      const WHEEL_WINDOW = 8;
      let acc = 0;
      let last = 0;
      let locked = false;
      let lastDir = 0;
      let stepAt = 0;
      let history: number[] = [];
      const mean = (values: number[]) => values.reduce((sum, v) => sum + v, 0) / values.length;
      el.addEventListener(
        'wheel',
        (event) => {
          const dx = event.deltaX;
          const adx = Math.abs(dx);
          if (adx <= Math.abs(event.deltaY)) return; // vertical scroll passes through
          event.preventDefault();

          const now = performance.now();
          const dir = Math.sign(dx);
          const gap = now - last;
          last = now;

          if (gap > 100) {
            locked = false;
            acc = 0;
            history = [];
          }
          history.push(adx);
          if (history.length > WHEEL_WINDOW) history.shift();

          if (locked && now - stepAt > 200) {
            const reversed = dir !== lastDir && adx > 10;
            let speedingUp = false;
            if (history.length === WHEEL_WINDOW) {
              const older = mean(history.slice(0, WHEEL_WINDOW / 2));
              const newer = mean(history.slice(WHEEL_WINDOW / 2));
              speedingUp = newer > 6 && newer > older * 1.5;
            }
            if (reversed || speedingUp) {
              locked = false;
              acc = 0;
            }
          }

          if (locked) return;

          acc += dx;
          if (Math.abs(acc) > WHEEL_STEP) {
            lastDir = Math.sign(acc);
            onStep(lastDir);
            acc = 0;
            locked = true;
            stepAt = now;
            history = [];
          }
        },
        { passive: false },
      );
    };

    const hero = document.querySelector<HTMLElement>('[data-archi-hero]');
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        hero.toggleAttribute('data-offscreen', !entry.isIntersecting);
      }).observe(hero);
    }

    // —— Videos: play in view, pause offscreen; respect reduced motion ——
    const videos = Array.from(document.querySelectorAll<HTMLVideoElement>('[data-case-video]'));
    if (!reducedMotion && 'IntersectionObserver' in window) {
      const videoIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            const toggle = video.parentElement?.querySelector<HTMLButtonElement>('[data-case-video-toggle]');
            const pausedByUser = toggle?.dataset.userPaused === 'true';
            if (entry.isIntersecting && !pausedByUser) {
              video.play().catch(() => {});
              if (toggle) {
                toggle.setAttribute('aria-pressed', 'false');
                toggle.setAttribute('aria-label', 'Pause video');
              }
            } else {
              video.pause();
            }
          }
        },
        { threshold: 0.45 },
      );
      videos.forEach((v) => videoIo.observe(v));
    } else {
      videos.forEach((v) => {
        v.pause();
        v.removeAttribute('autoplay');
      });
    }

    document.querySelectorAll<HTMLButtonElement>('[data-case-video-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const video = btn.parentElement?.querySelector<HTMLVideoElement>('[data-case-video]');
        if (!video) return;
        if (video.paused) {
          btn.dataset.userPaused = 'false';
          video.play().catch(() => {});
          btn.setAttribute('aria-pressed', 'false');
          btn.setAttribute('aria-label', 'Pause video');
        } else {
          btn.dataset.userPaused = 'true';
          video.pause();
          btn.setAttribute('aria-pressed', 'true');
          btn.setAttribute('aria-label', 'Play video');
        }
      });
    });

    // —— Audience carousel (swipe / arrows / dots / keys) ——
    const audRoot = document.querySelector<HTMLElement>('[data-aud-carousel]');
    if (audRoot) {
      const stage = audRoot.querySelector<HTMLElement>('[data-aud-stage]');
      const slides = Array.from(audRoot.querySelectorAll<HTMLElement>('[data-aud-slide]'));
      const copies = Array.from(audRoot.querySelectorAll<HTMLElement>('[data-aud-copy]'));
      const dots = Array.from(audRoot.querySelectorAll<HTMLButtonElement>('[data-aud-dot]'));
      const prevBtn = audRoot.querySelector<HTMLButtonElement>('[data-aud-prev]');
      const nextBtn = audRoot.querySelector<HTMLButtonElement>('[data-aud-next]');
      let current = 0;

      const stateFor = (offset: number) => {
        if (offset === 0) return 'active';
        if (offset === -1) return 'prev';
        if (offset === 1) return 'next';
        return offset < 0 ? 'far-prev' : 'far-next';
      };

      // Tap on the active phone hides the copy card so the whole screen is visible.
      const setPeek = (on: boolean) => {
        audRoot.dataset.peek = on ? 'true' : 'false';
        slides[current]?.setAttribute('aria-pressed', on ? 'true' : 'false');
      };

      const goTo = (index: number, focusDot = false) => {
        current = Math.max(0, Math.min(slides.length - 1, index));
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.dataset.state = stateFor(i - current);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          slide.tabIndex = active ? 0 : -1;
          if (active) {
            slide.setAttribute('role', 'button');
            slide.setAttribute('aria-label', 'Show screen without the caption');
          } else {
            slide.setAttribute('role', 'group');
            slide.setAttribute('aria-label', `${i + 1} of ${slides.length}`);
            slide.removeAttribute('aria-pressed');
          }
        });
        setPeek(false);
        copies.forEach((copy, i) => {
          copy.dataset.active = i === current ? 'true' : 'false';
        });
        dots.forEach((dot, i) => {
          const selected = i === current;
          dot.setAttribute('aria-selected', selected ? 'true' : 'false');
          dot.tabIndex = selected ? 0 : -1;
          if (selected && focusDot) dot.focus();
        });
        if (prevBtn) prevBtn.disabled = current === 0;
        if (nextBtn) nextBtn.disabled = current === slides.length - 1;
      };

      prevBtn?.addEventListener('click', () => goTo(current - 1));
      nextBtn?.addEventListener('click', () => goTo(current + 1));
      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => goTo(i));
        dot.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') { event.preventDefault(); goTo(current + 1, true); }
          else if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(current - 1, true); }
          else if (event.key === 'Home') { event.preventDefault(); goTo(0, true); }
          else if (event.key === 'End') { event.preventDefault(); goTo(slides.length - 1, true); }
        });
      });
      slides.forEach((slide, i) => {
        slide.addEventListener('click', () => {
          if (stage?.classList.contains('was-dragged')) return;
          if (i !== current) goTo(i);
          else setPeek(audRoot.dataset.peek !== 'true');
        });
        slide.addEventListener('keydown', (event) => {
          if (i !== current || (event.key !== 'Enter' && event.key !== ' ')) return;
          event.preventDefault();
          setPeek(audRoot.dataset.peek !== 'true');
        });
      });
      audRoot.querySelector<HTMLElement>('.aud-copy')?.addEventListener('click', () => setPeek(false));

      // Pointer swipe / drag
      if (stage) {
        let startX = 0;
        let dragging = false;
        let moved = false;
        stage.addEventListener('pointerdown', (event) => {
          dragging = true;
          moved = false;
          startX = event.clientX;
          stage.classList.add('is-dragging');
          stage.classList.remove('was-dragged');
        });
        stage.addEventListener('pointermove', (event) => {
          if (dragging && Math.abs(event.clientX - startX) > 8) moved = true;
        });
        const end = (event: PointerEvent) => {
          if (!dragging) return;
          dragging = false;
          stage.classList.remove('is-dragging');
          const dx = event.clientX - startX;
          if (moved && Math.abs(dx) > 48) {
            goTo(current + (dx < 0 ? 1 : -1));
            stage.classList.add('was-dragged');
            window.setTimeout(() => stage.classList.remove('was-dragged'), 0);
          }
        };
        stage.addEventListener('pointerup', end);
        stage.addEventListener('pointercancel', end);
        stage.addEventListener('pointerleave', end);
        stage.addEventListener('dragstart', (event) => event.preventDefault());

      }

      // Trackpad swipe on the whole carousel (phones, caption card, arrows), not just the stage.
      bindWheelSteps(audRoot, (dir) => goTo(current + dir));

      goTo(0);
    }

    // —— Scroll journey (desktop sticky phone) ——
    const journeyRoot = document.querySelector('[data-archi-journey]');
    if (journeyRoot && 'IntersectionObserver' in window) {
      const steps = Array.from(journeyRoot.querySelectorAll<HTMLElement>('[data-journey-step]'));
      const screens = Array.from(journeyRoot.querySelectorAll<HTMLElement>('[data-journey-screen]'));
      const setActive = (id: string) => {
        steps.forEach((step) => {
          step.dataset.active = step.dataset.journeyStep === id ? 'true' : 'false';
        });
        screens.forEach((screen) => {
          screen.dataset.active = screen.dataset.journeyScreen === id ? 'true' : 'false';
        });
      };
      const journeyIo = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const id = (visible.target as HTMLElement).dataset.journeyStep;
          if (id) setActive(id);
        },
        { rootMargin: '-35% 0px -45% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      steps.forEach((step) => journeyIo.observe(step));
    }

    // —— Journey (mobile): tabs, snap cards and the phone stay in sync ——
    const jmRoot = document.querySelector<HTMLElement>('[data-journey-mobile]');
    if (jmRoot) {
      const tabs = Array.from(jmRoot.querySelectorAll<HTMLButtonElement>('[data-jm-tab]'));
      const screens = Array.from(jmRoot.querySelectorAll<HTMLElement>('[data-jm-screen]'));
      const cards = Array.from(jmRoot.querySelectorAll<HTMLElement>('[data-jm-card]'));
      const track = jmRoot.querySelector<HTMLElement>('[data-jm-track]');
      const tabsRow = jmRoot.querySelector<HTMLElement>('.jm-tabs');
      const phone = jmRoot.querySelector<HTMLElement>('[data-jm-phone]');
      let active = 0;

      const setActive = (index: number) => {
        if (index === active) return;
        active = index;
        tabs.forEach((tab, i) => tab.setAttribute('aria-pressed', i === index ? 'true' : 'false'));
        screens.forEach((screen, i) => { screen.dataset.active = i === index ? 'true' : 'false'; });
        cards.forEach((card, i) => { card.dataset.active = i === index ? 'true' : 'false'; });
        const tab = tabs[index];
        if (tabsRow && tab) {
          tabsRow.scrollTo({ left: tab.offsetLeft - (tabsRow.clientWidth - tab.offsetWidth) / 2, behavior: reducedMotion ? 'auto' : 'smooth' });
        }
      };
      const cardLeft = (index: number) => (cards[index]?.offsetLeft ?? 0) - (cards[0]?.offsetLeft ?? 0);
      // While a programmatic smooth scroll runs, intermediate scroll positions must not
      // pull `active` back — otherwise a quick second swipe steps from the wrong card.
      let pendingCard: number | null = null;
      const scrollToCard = (index: number) => {
        const i = Math.max(0, Math.min(cards.length - 1, index));
        pendingCard = i;
        track?.scrollTo({ left: cardLeft(i), behavior: reducedMotion ? 'auto' : 'smooth' });
        setActive(i);
      };

      let scrollFrame = 0;
      track?.addEventListener(
        'scroll',
        () => {
          cancelAnimationFrame(scrollFrame);
          scrollFrame = requestAnimationFrame(() => {
            if (pendingCard !== null) {
              if (Math.abs(track.scrollLeft - cardLeft(pendingCard)) > 2) return;
              pendingCard = null;
            }
            const pitch = cardLeft(1) || 1;
            setActive(Math.max(0, Math.min(cards.length - 1, Math.round(track.scrollLeft / pitch))));
          });
        },
        { passive: true },
      );
      // A finger on the cards cancels any programmatic target — native scroll takes over.
      track?.addEventListener('touchstart', () => { pendingCard = null; }, { passive: true });
      tabs.forEach((tab, i) => tab.addEventListener('click', () => scrollToCard(i)));

      // Swipe left / right anywhere in the block flips the type, like the tabs inside the app:
      // trackpad → one type per gesture; mouse drag anywhere; finger on the phone
      // (on the cards a finger already scrolls the snap track natively).
      bindWheelSteps(jmRoot, (dir) => scrollToCard(active + dir));
      jmRoot.addEventListener('dragstart', (event) => event.preventDefault());

      let swipeId: number | null = null;
      let startX = 0;
      let startY = 0;
      jmRoot.addEventListener('pointerdown', (event) => {
        const onPhone = phone?.contains(event.target as Node) ?? false;
        if (event.pointerType === 'touch' && !onPhone) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        swipeId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
      });
      const endSwipe = (event: PointerEvent) => {
        if (event.pointerId !== swipeId) return;
        swipeId = null;
        if (event.type !== 'pointerup') return;
        const dx = event.clientX - startX;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(event.clientY - startY)) {
          scrollToCard(active + (dx < 0 ? 1 : -1));
        }
      };
      window.addEventListener('pointerup', endSwipe);
      window.addEventListener('pointercancel', endSwipe);
    }

    // —— 2D / 3D compare (drag on the frame) ——
    // Left of --pos = 2D, right = 3D. Starts at 50%.
    const compareRoot = document.querySelector<HTMLElement>('[data-archi-compare]');
    if (compareRoot) {
      const stage = compareRoot.querySelector<HTMLElement>('[data-compare-stage]');
      const layers = stage?.querySelector<HTMLElement>('.compare-layers');
      if (stage && layers) {
        const apply = (clientX: number) => {
          const rect = layers.getBoundingClientRect();
          const split = Math.max(0, Math.min(100, Math.round(((clientX - rect.left) / rect.width) * 100)));
          stage.style.setProperty('--pos', `${split}%`);
        };
        let dragging = false;
        let touched = false;
        let hintFrame = 0;
        // Touch waits for a horizontal move so a vertical page scroll over the frame doesn't jump the split.
        let pendingTouch = false;
        let startX = 0;
        let startY = 0;
        layers.addEventListener('pointerdown', (event) => {
          touched = true;
          cancelAnimationFrame(hintFrame);
          if (event.pointerType === 'touch') {
            pendingTouch = true;
            startX = event.clientX;
            startY = event.clientY;
            return;
          }
          dragging = true;
          layers.setPointerCapture(event.pointerId);
          apply(event.clientX);
        });
        layers.addEventListener('pointermove', (event) => {
          if (pendingTouch) {
            const dx = Math.abs(event.clientX - startX);
            if (dx > 6 && dx > Math.abs(event.clientY - startY)) {
              pendingTouch = false;
              dragging = true;
            }
          }
          if (dragging) apply(event.clientX);
        });
        const endDrag = (event: PointerEvent) => {
          if (pendingTouch && event.type === 'pointerup') apply(event.clientX);
          pendingTouch = false;
          dragging = false;
        };
        layers.addEventListener('pointerup', endDrag);
        layers.addEventListener('pointercancel', endDrag);

        // Phone layout only: one slow sweep the first time the frame is in view, so it reads as draggable.
        if (!reducedMotion && window.matchMedia('(max-width:720px)').matches && 'IntersectionObserver' in window) {
          const hintIo = new IntersectionObserver(
            ([entry]) => {
              if (!entry.isIntersecting) return;
              hintIo.disconnect();
              const start = performance.now();
              const duration = 1800;
              const tick = (now: number) => {
                if (touched) return;
                const t = Math.min(1, (now - start) / duration);
                const split = 50 + Math.sin(t * Math.PI * 2) * -22 * (1 - t * 0.35);
                stage.style.setProperty('--pos', `${t < 1 ? split.toFixed(2) : 50}%`);
                if (t < 1) hintFrame = requestAnimationFrame(tick);
              };
              window.setTimeout(() => { if (!touched) hintFrame = requestAnimationFrame(tick); }, 350);
            },
            { threshold: 0.6 },
          );
          hintIo.observe(layers);
        }
      }
    }

  </script>
</body>
</html>

