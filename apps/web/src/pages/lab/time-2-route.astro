---
import { getEntry } from 'astro:content';
import '../../styles/global.css';
import '../../styles/palette.css';
import '../../styles/lab.css';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import SeoHead from '../../components/SeoHead.astro';
import Time2RouteArticle from '../../components/Time2RouteArticle.astro';
import site from '../../content/site.yaml';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

// SEO fields (title, description, og:*, dates, author) come from the lab
// collection entry, exactly like /lab/[slug] — only the presentation differs.
const entry = await getEntry('lab', 'time-2-route');
if (!entry) throw new Error('Missing lab content entry: time-2-route');
const { data } = entry;
const authorName = data.authorName ?? site.author.name;
const articleUrl = new URL(`/lab/${entry.id}`, site.siteUrl).href;
const jsonLd = [
  articleSchema(site, data, articleUrl),
  breadcrumbSchema([
    { name: 'Home', item: site.siteUrl },
    { name: data.navLabel, item: articleUrl },
  ]),
];

const intro = 'A map-first route planner for walking and cycling. Build a route, discover interesting places nearby, add stops, read elevation, and share the result.';
const githubUrl = 'https://github.com/time2map/time2route';
const techStack = [
  { label: 'React 19 + React DOM', detail: 'Interface' },
  { label: 'Google Maps JavaScript API', detail: 'Maps, routes and places' },
  { label: 'Geoapify IP Geolocation', detail: 'Location fallback' },
  { label: 'Chart.js', detail: 'Elevation profile' },
  { label: 'vite-plugin-pwa', detail: 'Installable web app' },
];
---
<!doctype html>
<html lang="en">
<head>
  <SeoHead
    title={data.seoTitle ?? data.title}
    description={data.description}
    ogTitle={data.ogTitle || undefined}
    ogDescription={data.ogDescription || undefined}
    ogImage={data.ogImage}
    jsonLd={jsonLd}
    ogType="article"
    publishedTime={data.publishDate.toISOString()}
    author={authorName}
  />
</head>
<body class="lab-page">
  <a class="skip-link" href="#article-content">Skip to article</a>

  <SiteNav />

  <main class="lab-main">
    <section class="lab-hero" aria-labelledby="article-title">
      <div class="lab-hero-topline">
        <div class="eyebrow"><span></span> Product story · July 2026</div>
        <span>3 min read</span>
      </div>
      <h1 id="article-title">Time2Route:<br/><em>Build the route worth taking</em></h1>
      <div class="lab-hero-footer">
        <p>{intro}</p>
        <div class="lab-author">
          <img src="/images/vadim-markelov-avatar.jpg" alt="Vadim Markelov" width="52" height="52"/>
          <span><small>Written by</small><strong>Vadim Markelov</strong></span>
        </div>
      </div>
    </section>

    <article class="lab-article" id="article-content">
      <div class="lab-content">
        <Time2RouteArticle />
      </div>

      <aside class="lab-tech" aria-labelledby="tech-heading">
        <div>
          <div class="eyebrow"><span></span> Under the hood</div>
          <h2 id="tech-heading">Built for routes<br/><em>that travel well</em></h2>
        </div>
        <ul>
          {techStack.map((item) => (
            <li><strong>{item.label}</strong><span>{item.detail}</span></li>
          ))}
        </ul>
      </aside>

      <div class="lab-outro">
        <div>
          <small>Explore the project</small>
          <h2>Plan a route<br/><em>Make it worth taking</em></h2>
        </div>
        <div class="lab-outro-actions">
          <a class="button-motion" href="https://route.time2map.com/" target="_blank" rel="noopener">Open Time2Route <span>↗︎</span></a>
          <a class="button-motion" href={githubUrl} target="_blank" rel="noopener">View source <span>↗︎</span></a>
        </div>
      </div>
    </article>
  </main>

  <SiteFooter />
</body>
</html>
