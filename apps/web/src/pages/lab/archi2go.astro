  .aud-slide[data-state="prev"] { transform:translateX(calc(var(--aud-step) * -1)) scale(.84); }
  .aud-slide[data-state="next"] { transform:translateX(var(--aud-step)) scale(.84); }
  .aud-slide[data-state="far-prev"],.aud-slide[data-state="far-next"] { z-index:1; opacity:0; pointer-events:none; }
  .aud-slide[data-state="far-prev"] { transform:translateX(calc(var(--aud-step) * -1.7)) scale(.72); }
  .aud-slide[data-state="far-next"] { transform:translateX(calc(var(--aud-step) * 1.7)) scale(.72); }

  .aud-copy {
    position:relative;
    z-index:4;
    display:grid;
    width:min(calc(100% - 24px),400px);
    margin:0 auto;
    margin-top:calc(var(--aud-phone) * 1691 / 780 * -.25);
    padding:24px 24px 22px;
    border-radius:12px;
    background:rgb(243 242 238 / 88%);
    -webkit-backdrop-filter:blur(10px);
