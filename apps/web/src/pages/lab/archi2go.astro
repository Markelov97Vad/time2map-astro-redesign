  .store-coming small { margin-top:3px; color:#aaa79f; font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  /* Off-site link over the map: black pill with light ring so it still reads on the dark hero. */
  .hero-web-link {
    display:inline-flex; align-items:center; justify-content:space-between; gap:24px; min-height:54px;
    margin:0; padding:13px 17px; border:1.5px solid rgb(255 255 255 / 72%); border-radius:999px;
    background:#0a0a09; color:#fff; font-size:16px; font-weight:700; line-height:1; letter-spacing:-.01em;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 55%),
      0 12px 28px rgb(0 0 0 / 45%),
