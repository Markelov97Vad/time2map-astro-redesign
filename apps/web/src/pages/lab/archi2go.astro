  .download-copy small { color:#cfccc5; font-size:12px; line-height:1.45; }
  .store-row { display:none; flex-direction:row; flex-wrap:wrap; align-items:center; gap:10px; margin:clamp(18px,2.5vh,24px) 0 0; }
