  /* Audience carousel */
  .aud-carousel { --aud-phone:300px; --aud-step:calc(var(--aud-phone) * 1.12); margin-top:clamp(56px,7vw,96px); overscroll-behavior-x:contain; }
  .aud-stage-wrap { position:relative; }
  .aud-stage { overflow-x:clip; overflow-y:visible; padding-block:8px; touch-action:pan-y; cursor:grab; user-select:none; -webkit-user-select:none; }
  .aud-stage.is-dragging { cursor:grabbing; }
  .aud-track { display:grid; justify-items:center; margin:0; padding:0; list-style:none; }
  .aud-slide {
    grid-area:1 / 1;
    width:var(--aud-phone);
