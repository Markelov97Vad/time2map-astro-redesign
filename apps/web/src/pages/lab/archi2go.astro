  .hero-map {
    position:absolute; inset:0 0 auto; z-index:0; height:clamp(560px, 64vw, 940px); overflow:hidden; pointer-events:none;
    mask-image:linear-gradient(180deg, #000 0%, #000 55%, transparent 100%);
