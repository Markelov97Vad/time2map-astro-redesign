    padding:10px 16px 10px 10px; border:1px solid rgb(255 255 255 / 24%); border-radius:18px;
    background:rgb(10 10 9 / 78%); box-shadow:0 14px 34px rgb(0 0 0 / 28%); backdrop-filter:blur(10px);
  }
