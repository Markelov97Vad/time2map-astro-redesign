  }
  .hero-web-link svg { display:block; flex:none; fill:none; stroke:currentColor; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
  .hero-web-link:focus-visible { outline:3px solid var(--a-white); outline-offset:4px; }

  .primary-link { display:inline-flex; align-items:center; justify-content:space-between; gap:28px; min-width:220px; min-height:52px; margin-top:30px; padding:0 9px 0 20px; border-radius:999px; background:var(--a-white); color:var(--a-ink); font-size:14px; font-weight:600; transition:transform .25s var(--ease-out); }
  .primary-link span { display:grid; place-items:center; width:34px; height:34px; border-radius:50%; background:var(--a-accent); color:var(--a-white); pointer-events:none; transition:background .2s ease,color .2s ease; }
  .primary-link svg { display:block; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .primary-link:focus-visible,.text-link:focus-visible,.store-badge:focus-visible,.tab:focus-visible { outline:3px solid var(--a-white); outline-offset:4px; }
  .section-white .tab:focus-visible,.section-paper .primary-link:focus-visible { outline-color:var(--a-ink); }

  .text-link { display:inline-flex; align-items:center; min-height:44px; border-bottom:1px solid #6d6a64; color:#cfccc5; font-size:14px; transition:color .2s ease,border-color .2s ease; }

  .hero-visual {
