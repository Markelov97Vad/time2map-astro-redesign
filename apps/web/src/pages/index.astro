  <script>
    // Demo video: create the Vimeo player only when its section approaches the viewport.
    // The iframe is not in the HTML at all, so the poster shows until then (and without JS).
    // The iframe stays invisible (CSS) until the player reports frames actually rendering:
    // between creation and first frame it is a black box, and on a slow network that is
    // tens of seconds — the poster covers that whole time instead.
    const videoScreen = document.querySelector<HTMLElement>('.device-screen[data-video-src]');
    if (videoScreen) {
      const VIMEO_ORIGIN = 'https://player.vimeo.com';
      const mountVideo = () => {
        if (videoScreen.querySelector('iframe')) return;
        const frame = document.createElement('iframe');
        frame.src = videoScreen.dataset.videoSrc ?? '';
        frame.title = videoScreen.dataset.videoTitle ?? '';
        frame.allow = 'autoplay; fullscreen';
        frame.loading = 'lazy';
        frame.dataset.cmpAb = '2';
        // Vimeo player postMessage API (what @vimeo/player wraps): after "ready", subscribe to
        // "timeupdate"; the first tick with seconds > 0 means a frame is on screen.
        const onPlayerMessage = (event: MessageEvent) => {
          if (event.origin !== VIMEO_ORIGIN || event.source !== frame.contentWindow) return;
          let data: any = event.data;
          if (typeof data === 'string') { try { data = JSON.parse(data); } catch { return; } }
          if (!data || typeof data !== 'object') return;
          if (data.event === 'ready') {
            frame.contentWindow?.postMessage({ method: 'addEventListener', value: 'timeupdate' }, VIMEO_ORIGIN);
          } else if (data.event === 'timeupdate' && Number(data.data?.seconds) > 0) {
            videoScreen.classList.add('is-playing');
            window.removeEventListener('message', onPlayerMessage);
          }
        };
        window.addEventListener('message', onPlayerMessage);
        videoScreen.appendChild(frame);
      };
      if ('IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver((entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          mountVideo();
          videoObserver.disconnect();
        }, { rootMargin: '0px 0px 300px 0px', threshold: 0.05 });
        videoObserver.observe(videoScreen);
      } else {
        mountVideo();
      }
    }


    const scrollToHashSection = () => {
      if (!location.hash) return;
      const target = document.getElementById(decodeURIComponent(location.hash.slice(1)));
      if (!target) return;
      const nav = document.querySelector<HTMLElement>('.nav');
      const navHeight = nav?.getBoundingClientRect().height ?? 0;
      const targetTop = target.getBoundingClientRect().top + window.scrollY - navHeight;
      window.scrollTo({ top:Math.max(0, targetTop), behavior:'instant' });
    };

    window.addEventListener('load', () => requestAnimationFrame(scrollToHashSection), { once:true });
    window.addEventListener('hashchange', () => requestAnimationFrame(scrollToHashSection));

    const expertise = document.querySelector<HTMLElement>('#expertise');
    const skillCards = [...document.querySelectorAll<HTMLElement>('#expertise .skill-card')];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const bentoMotion = window.matchMedia('(min-width: 801px) and (hover: hover) and (pointer: fine)');

    const proofSection = document.querySelector<HTMLElement>('.proof');
    const proofCards = [...document.querySelectorAll<HTMLElement>('.proof-card')];
    const proofStats = [...document.querySelectorAll<HTMLElement>('.proof-stat strong[data-count-to]')];

    const animateProofStat = (stat:HTMLElement, sequenceStartedAt:number) => {
      const target = Number(stat.dataset.countTo ?? 0);
      const suffix = stat.dataset.countSuffix ?? '';
      const duration = 800;

      const tick = (now:number) => {
        const progress = Math.min((now - sequenceStartedAt) / duration, 1);
        if (progress < 1) {
          const current = Math.min(target - 1, Math.floor(target * progress));
          stat.textContent = `${current}${suffix}`;
          requestAnimationFrame(tick);
        } else {
          stat.textContent = `${target}${suffix}`;
          stat.style.removeProperty('width');
        }
      };

      requestAnimationFrame(tick);
    };

    if (proofSection && proofCards.length && !reduceMotion.matches) {
      document.documentElement.classList.add('has-proof-motion');
      proofCards.forEach((card, index) => card.style.setProperty('--proof-index', String(index)));
      proofStats.forEach((stat) => {
        stat.style.width = `${Math.ceil(stat.getBoundingClientRect().width)}px`;
        stat.textContent = `0${stat.dataset.countSuffix ?? ''}`;
      });
      const proofObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        proofSection.classList.add('is-visible');
        const sequenceStartedAt = performance.now();
        proofStats.forEach((stat) => animateProofStat(stat, sequenceStartedAt));
        window.setTimeout(() => proofSection.classList.add('is-settled'), 1050);
        observer.disconnect();
      }, { threshold:.18, rootMargin:'0px 0px -8% 0px' });
      proofObserver.observe(proofSection);
    } else {
      proofSection?.classList.add('is-visible', 'is-settled');
    }

    if (skillCards.length && finePointer.matches) {
      skillCards.forEach((card) => {
        card.addEventListener('pointermove', (event) => {
          const bounds = card.getBoundingClientRect();
          card.style.setProperty('--pointer-x', `${event.clientX - bounds.left}px`);
          card.style.setProperty('--pointer-y', `${event.clientY - bounds.top}px`);
        }, { passive:true });
      });
    }

    if (expertise && skillCards.length && !reduceMotion.matches && bentoMotion.matches) {
      document.documentElement.classList.add('has-bento-motion');
      skillCards.forEach((card, cardIndex) => {
        card.style.setProperty('--card-index', String(cardIndex));
        card.querySelectorAll<HTMLElement>('.design-art i').forEach((node, nodeIndex) => {
          node.style.setProperty('--node-index', String(nodeIndex));
        });
      });

      const expertiseObserver = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        expertise.classList.add('is-visible');
        window.setTimeout(() => {
          expertise.classList.add('is-settled');
          document.documentElement.classList.remove('has-bento-motion');
        }, 1300);
        observer.disconnect();
      }, { threshold:.08, rootMargin:'0px 0px -8% 0px' });
      expertiseObserver.observe(expertise);
    } else {
      expertise?.classList.add('is-visible');
    }

    const device = document.querySelector('#device');
    const wrap = document.querySelector('.device-wrap');
    wrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=wrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; device.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    wrap?.addEventListener('pointerleave',()=>device.style.transform='rotateY(-8deg) rotateX(5deg)');
    const audioSlides = document.querySelector<HTMLElement>('[data-audio-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-audio-slide]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.dataset.audioSlide);
      if (audioSlides) {
        audioSlides.style.transform = `translateX(-${index * 100}%)`;
        if (audioSlides.closest('.device-wrap')?.classList.contains('is-expanded')) {
          audioSlides.scrollTo({ left:index * audioSlides.clientWidth, behavior:reduceMotion.matches ? 'auto' : 'smooth' });
        }
      }
      document.querySelectorAll('[data-audio-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const recycleDevice = document.querySelector<HTMLElement>('#recycle-device');
    const recycleWrap = document.querySelector<HTMLElement>('.recycle-device-wrap');
    recycleWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=recycleWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(recycleDevice) recycleDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    recycleWrap?.addEventListener('pointerleave',()=>{ if(recycleDevice) recycleDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const recycleSlides = document.querySelector<HTMLElement>('[data-recycle-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-recycle-slide]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.dataset.recycleSlide);
      if (recycleSlides) {
        recycleSlides.style.transform = `translateX(-${index * 100}%)`;
        if (recycleSlides.closest('.device-wrap')?.classList.contains('is-expanded')) {
          recycleSlides.scrollTo({ left:index * recycleSlides.clientWidth, behavior:reduceMotion.matches ? 'auto' : 'smooth' });
        }
      }
      document.querySelectorAll('[data-recycle-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));
    const airportDevice = document.querySelector<HTMLElement>('#airport-device');
    const airportWrap = document.querySelector<HTMLElement>('.airport-device-wrap');
    airportWrap?.addEventListener('pointermove', (event) => { if(event.pointerType !== 'mouse') return; const r=airportWrap.getBoundingClientRect(); const x=(event.clientX-r.left)/r.width-.5; const y=(event.clientY-r.top)/r.height-.5; if(airportDevice) airportDevice.style.transform=`rotateY(${x*22}deg) rotateX(${-y*14}deg)`; });
    airportWrap?.addEventListener('pointerleave',()=>{ if(airportDevice) airportDevice.style.transform='rotateY(-8deg) rotateX(5deg)'; });
    const airportSlides = document.querySelector<HTMLElement>('[data-airport-slides]');
    document.querySelectorAll<HTMLButtonElement>('[data-airport-slide]').forEach((button) => button.addEventListener('click', () => {
      const index = Number(button.dataset.airportSlide);
      if (airportSlides) {
        airportSlides.style.transform = `translateX(-${index * 100}%)`;
        if (airportSlides.closest('.device-wrap')?.classList.contains('is-expanded')) {
          airportSlides.scrollTo({ left:index * airportSlides.clientWidth, behavior:reduceMotion.matches ? 'auto' : 'smooth' });
        }
      }
      document.querySelectorAll('[data-airport-slide]').forEach((item) => item.classList.remove('is-active'));
      button.classList.add('is-active');
    }));

    const enableSwipe = (track: HTMLElement | null, buttonSelector: string) => {
      if (!track) return;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>(buttonSelector)];
      let startX = 0;
      let startY = 0;
      let deltaX = 0;
      let deltaY = 0;
      track.addEventListener('touchstart', (event) => {
        if (track.closest('.device-wrap')?.classList.contains('is-expanded')) return;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        deltaX = 0;
        deltaY = 0;
      }, { passive:true });
      track.addEventListener('touchmove', (event) => {
        if (track.closest('.device-wrap')?.classList.contains('is-expanded')) return;
        deltaX = event.touches[0].clientX - startX;
        deltaY = event.touches[0].clientY - startY;
        if (Math.abs(deltaX) > Math.abs(deltaY)) event.preventDefault();
      }, { passive:false });
      track.addEventListener('touchend', (event) => {
        if (track.closest('.device-wrap')?.classList.contains('is-expanded')) return;
        if (Math.abs(deltaX) < 45 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        event.preventDefault();
        const activeIndex = Math.max(0, buttons.findIndex((button) => button.classList.contains('is-active')));
        const nextIndex = Math.min(buttons.length - 1, Math.max(0, activeIndex + (deltaX < 0 ? 1 : -1)));
        buttons[nextIndex]?.click();
      }, { passive:false });
    };
    enableSwipe(audioSlides, '[data-audio-slide]');
    enableSwipe(recycleSlides, '[data-recycle-slide]');
    enableSwipe(airportSlides, '[data-airport-slide]');

    const enableExpandedNativeScroll = (track: HTMLElement | null, buttonSelector: string) => {
      if (!track) return;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>(buttonSelector)];
      let scrollFrame = 0;
      track.addEventListener('scroll', () => {
        if (!track.closest('.device-wrap')?.classList.contains('is-expanded') || scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
          scrollFrame = 0;
          if (!track.clientWidth) return;
          const index = Math.min(buttons.length - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
          track.style.transform = `translateX(-${index * 100}%)`;
          buttons.forEach((button, buttonIndex) => button.classList.toggle('is-active', buttonIndex === index));
        });
      }, { passive:true });
    };
    enableExpandedNativeScroll(audioSlides, '[data-audio-slide]');
    enableExpandedNativeScroll(recycleSlides, '[data-recycle-slide]');
    enableExpandedNativeScroll(airportSlides, '[data-airport-slide]');

    const deviceWraps = document.querySelectorAll<HTMLElement>('.cesium .device-wrap');
    let expandedWrap: HTMLElement | null = null;
    const setExpanded = (wrap: HTMLElement, expanded: boolean) => {
      const update = () => {
        wrap.classList.toggle('is-expanded', expanded);
        wrap.querySelector<HTMLElement>('.device')?.setAttribute('aria-expanded', String(expanded));
        document.documentElement.classList.toggle('preview-open', expanded);
        document.body.classList.toggle('preview-open', expanded);
        expandedWrap = expanded ? wrap : null;
        if (expanded) {
          const track = wrap.querySelector<HTMLElement>('[data-audio-slides],[data-recycle-slides],[data-airport-slides]');
          const buttons = [...wrap.querySelectorAll<HTMLButtonElement>('.screen-switcher button')];
          const activeIndex = Math.max(0, buttons.findIndex((button) => button.classList.contains('is-active')));
          if (track) requestAnimationFrame(() => { track.scrollLeft = activeIndex * track.clientWidth; });
        }
      };
      if (document.startViewTransition && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.startViewTransition(update);
      else update();
    };
    deviceWraps.forEach((deviceWrap, index) => {
      const preview = deviceWrap.querySelector<HTMLElement>('.device');
      if (!preview) return;
      preview.dataset.previewDevice = String(index + 1);
      preview.tabIndex = 0;
      preview.setAttribute('role', 'button');
      preview.setAttribute('aria-label', 'Open project preview fullscreen');
      preview.setAttribute('aria-expanded', 'false');
      const close = document.createElement('button');
      close.className = 'preview-close';
      close.type = 'button';
      close.setAttribute('aria-label', 'Close fullscreen preview');
      close.textContent = '×';
      deviceWrap.append(close);
      const open = () => { if (!deviceWrap.classList.contains('is-expanded')) setExpanded(deviceWrap, true); };
      preview.addEventListener('click', open);
      preview.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(); } });
      close.addEventListener('click', (event) => { event.stopPropagation(); setExpanded(deviceWrap, false); preview.focus(); });
      deviceWrap.addEventListener('click', (event) => { if (deviceWrap.classList.contains('is-expanded') && event.target === deviceWrap) setExpanded(deviceWrap, false); });
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && expandedWrap) setExpanded(expandedWrap, false); });
  </script>
</body></html>
