---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/palette.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import SeoHead from '../components/SeoHead.astro';
import site from '../content/site.yaml';
import seo from '../content/seo.yaml';
import { organizationSchema, websiteSchema } from '../lib/schema';

const bookCallUrl = site.bookCallUrl;
const demoVideoEmbedUrl = 'https://player.vimeo.com/video/1178497009?autoplay=1&muted=1&loop=1&background=1&playsinline=1&dnt=1';
const demoVideoPoster = '/images/hero-poster.webp';

// Same structured data as the classic home page: Organization (with the
// testimonials shown under "Selected feedback" as reviews) + WebSite. The FAQ
// section is not part of the redesign, so no FAQPage node here.
const testimonials = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
const jsonLd = [organizationSchema(site, testimonials), websiteSchema(site)];
---
<!doctype html>
<html lang="en">
<head>
  <SeoHead
    title={seo.home.title}
    description={seo.home.description}
    ogTitle={seo.home.ogTitle || undefined}
    ogDescription={seo.home.ogDescription || undefined}
    ogImage={seo.home.ogImage || undefined}
    noindex={seo.home.noindex}
    jsonLd={jsonLd}
  >
    <link rel="preload" as="image" href="/images/globe-light-1399.webp" imagesrcset="/images/globe-light-800.webp 800w, /images/globe-light-1399.webp 1399w" imagesizes="(max-width: 800px) 100vw, 58vw" fetchpriority="high" />
  </SeoHead>
</head>
<body>
  <SiteNav home />
  <main>
    <section class="hero">
      <h1>Maps and GIS solutions<br/><em>for the real world</em></h1>
      <p>We design and build interactive maps, geospatial platforms, and data-driven applications for organizations worldwide.</p>
      <div class="hero-actions"><a class="text-link" href="#work">Explore our work ↓</a></div>
      <div class="map-hero" aria-hidden="true">
        <div class="hero-globe"><img src="/images/globe-light-1399.webp" alt="" width="1399" height="1322" srcset="/images/globe-light-800.webp 800w, /images/globe-light-1399.webp 1399w" sizes="(max-width: 800px) 100vw, 58vw" fetchpriority="high" decoding="async" /></div>
        <img class="hero-marker" src="/images/map-pin.svg" alt="" width="54" height="75" />
      </div>
    </section>

    <section class="proof" aria-labelledby="proof-title">
      <header class="proof-header">
        <div class="eyebrow"><span></span> At a glance</div>
        <div class="proof-heading">
          <h2 id="proof-title">Proof,<br/><em>not promises</em></h2>
          <p>Senior geospatial expertise, measured in delivered work and client trust.</p>
        </div>
      </header>

      <div class="proof-grid">
        <a class="proof-card" href="#work">
          <div class="proof-card-top">
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/projects-check.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="10" data-count-suffix="+" aria-label="10+">10+</strong><span>projects<br/>delivered</span></div>
          <span class="proof-link">Explore our work <i aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg></i></span>
        </a>

        <a class="proof-card proof-card-featured" href="https://www.upwork.com/agencies/time2map" target="_blank" rel="noopener">
          <div class="proof-card-top">
            <svg class="proof-upwork-wordmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 102 28" role="img" aria-label="Upwork"><path fill="currentColor" d="M28.18,19.06A6.54,6.54,0,0,1,23,16c.67-5.34,2.62-7,5.2-7s4.54,2,4.54,5-2,5-4.54,5m0-13.34a7.77,7.77,0,0,0-7.9,6.08,26,26,0,0,1-1.93-5.62H12v7.9c0,2.87-1.3,5-3.85,5s-4-2.12-4-5l0-7.9H.49v7.9A8.61,8.61,0,0,0,2.6,20a7.27,7.27,0,0,0,5.54,2.35c4.41,0,7.5-3.39,7.5-8.24V8.77a25.87,25.87,0,0,0,3.66,8.05L17.34,28h3.72l1.29-7.92a11,11,0,0,0,1.36,1,8.32,8.32,0,0,0,4.14,1.28h.34A8.1,8.1,0,0,0,36.37,14a8.12,8.12,0,0,0-8.19-8.31"></path><path fill="currentColor" d="M80.8,7.86V6.18H77.2V21.81h3.65V15.69c0-3.77.34-6.48,5.4-6.13V6c-2.36-.18-4.2.31-5.45,1.87"></path><polygon fill="currentColor" points="55.51 6.17 52.87 17.11 50.05 6.17 45.41 6.17 42.59 17.11 39.95 6.17 36.26 6.17 40.31 21.82 44.69 21.82 47.73 10.71 50.74 21.82 55.12 21.82 59.4 6.17 55.51 6.17"></polygon><path fill="currentColor" d="M67.42,19.07c-2.59,0-4.53-2.05-4.53-5s2-5,4.53-5S72,11,72,14s-2,5-4.54,5m0-13.35A8.1,8.1,0,0,0,59.25,14,8.18,8.18,0,1,0,75.6,14a8.11,8.11,0,0,0-8.18-8.31"></path><path fill="currentColor" d="M91.47,14.13h.84l5.09,7.69h4.11l-5.85-8.53a7.66,7.66,0,0,0,4.74-7.11H96.77c0,3.37-2.66,4.65-5.3,4.65V0H87.82V21.82h3.64Z"></path></svg>
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/job-success-large.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="100" data-count-suffix="%" aria-label="100%">100%</strong><span>Job Success<br/>Score</span></div>
          <span class="proof-link">View Upwork profile <i aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg></i></span>
        </a>

        <a class="proof-card" href="#expertise">
          <div class="proof-card-top">
            <span class="proof-icon" aria-hidden="true"><img src="/images/icons/geospatial.svg" alt="" width="40" height="40" /></span>
          </div>
          <div class="proof-stat"><strong data-count-to="10" data-count-suffix="+" aria-label="10+">10+</strong><span>years of geospatial<br/>expertise</span></div>
          <span class="proof-link">Explore expertise <i aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"/></svg></i></span>
        </a>
      </div>
    </section>

    <section class="cesium audio-feature" id="work">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · izi.TRAVEL founders</div><h2>Audio Guides<br/>Mapping Platform</h2><p>Built a full-stack map platform powering <a href="https://tmatic.travel/" target="_blank" rel="noopener">tmatic.travel</a>. A CMS, responsive public map and partner API deliver audio tours and stories to travelers and cultural institutions worldwide.</p><p class="case-details">Angular and Mapbox power 2D, 3D and dedicated indoor museum modes. Java Spring and PostGIS keep content delivery seamless at global scale.</p><div class="case-metrics"><div class="metric"><b>20K+</b><span>audio tours<br/>worldwide</span></div><div class="metric"><b>500K+</b><span>stories across<br/>the platform</span></div></div><a class="case-link" href="https://tmatic.travel/" target="_blank" rel="noopener">Explore tmatic.travel ↗︎</a></div>
      <div class="device-wrap">
        <div class="device" id="device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="audio-slides" data-audio-slides><div class="device-screen" data-video-src={demoVideoEmbedUrl} data-video-title="time2map demo video"><div class="device-poster"><img src={demoVideoPoster} alt="" width="1280" height="814" loading="lazy" decoding="async" /></div></div><img src="/images/audio-guides-1-1280.webp" alt="Audio Guides public map view" width="1441" height="813" srcset="/images/audio-guides-1-720.webp 720w, /images/audio-guides-1-1280.webp 1280w, /images/audio-guides-1-1441.webp 1441w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/audio-guides-2-1280.webp" alt="Audio Guides content management system" width="1441" height="813" srcset="/images/audio-guides-2-720.webp 720w, /images/audio-guides-2-1280.webp 1280w, /images/audio-guides-2-1441.webp 1441w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/audio-guides-3-1280.webp" alt="Audio Guides mobile interface" width="1441" height="813" srcset="/images/audio-guides-3-720.webp 720w, /images/audio-guides-3-1280.webp 1280w, /images/audio-guides-3-1441.webp 1441w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /></div></div></div>
        <div class="screen-switcher" aria-label="Audio Guides video and screenshots"><button class="is-active" data-audio-slide="0">01<span class="sr-only">, show demo video</span></button><button data-audio-slide="1">02<span class="sr-only">, show screenshot 1</span></button><button data-audio-slide="2">03<span class="sr-only">, show screenshot 2</span></button><button data-audio-slide="3">04<span class="sr-only">, show screenshot 3</span></button></div>
      </div>
    </section>

    <section class="cesium recycle-feature" id="recyclemap">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Greenpeace</div><h2>Crowdmapping<br/>for Recycling</h2><p>Developed a crowdmapping platform for <a href="https://es.greenpeace.org/" target="_blank" rel="noopener">Greenpeace’s</a> Recyclemap project, enabling volunteers to add, update and moderate recycling and ZeroWaste locations across the country.</p><p class="case-details">Angular and Mapbox GL power mobile and desktop experiences. Python, PostGIS, Martin and H3 clustering process OSM data and provide scalable spatial queries for thousands of active users.</p><div class="case-metrics"><div class="metric"><b>Web + mobile</b><span>responsive mapping<br/>applications</span></div><div class="metric"><b>Live data</b><span>community-powered<br/>locations</span></div></div><a class="case-link" href="https://wastefreemap.com" target="_blank" rel="noopener">Explore Waste Free Map ↗︎</a></div>
      <div class="device-wrap recycle-device-wrap">
        <div class="device recycle-device" id="recycle-device"><div class="device-top"><span></span></div><div class="screen audio-screen recycle-screen"><div class="recycle-slides" data-recycle-slides><img src="/images/recycling-1-1280.webp" alt="Recyclemap crowdmapping interface" width="1720" height="956" srcset="/images/recycling-1-720.webp 720w, /images/recycling-1-1280.webp 1280w, /images/recycling-1-1720.webp 1720w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/recycling-2-1280.webp" alt="Recycling point details" width="1441" height="813" srcset="/images/recycling-2-720.webp 720w, /images/recycling-2-1280.webp 1280w, /images/recycling-2-1441.webp 1441w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/recycling-3-1280.webp" alt="Recyclemap mobile interface" width="1441" height="813" srcset="/images/recycling-3-720.webp 720w, /images/recycling-3-1280.webp 1280w, /images/recycling-3-1441.webp 1441w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /></div></div></div>
        <div class="screen-switcher" aria-label="Recyclemap screenshots"><button class="is-active" data-recycle-slide="0">01<span class="sr-only">, show screenshot 1</span></button><button data-recycle-slide="1">02<span class="sr-only">, show screenshot 2</span></button><button data-recycle-slide="2">03<span class="sr-only">, show screenshot 3</span></button></div>
      </div>
    </section>

    <section class="cesium airport-feature" id="airport-maps">
      <div class="sticky-copy"><div class="eyebrow light"><span></span> Featured project · Global aviation</div><h2>Automated 300+<br/>Airport Maps</h2><p>Prepared more than 300 airport maps for <a href="https://www.airportmaps.com/" target="_blank" rel="noopener">airportmaps.com</a> in only 1.5 months, meeting a demanding global production schedule.</p><p class="case-details">Python scripts extracted and processed OSM and official airport POI data for terminals, entrances and roads. Automated styling reduced production time by 50%, while designers finalized accurate web maps and print-ready PDFs.</p><div class="case-metrics"><div class="metric"><b>300+</b><span>airport maps<br/>in production</span></div><div class="metric"><b>−50%</b><span>map production<br/>time</span></div></div><a class="case-link" href="https://www.airportmaps.com/" target="_blank" rel="noopener">Explore Airport Maps ↗︎</a></div>
      <div class="device-wrap airport-device-wrap">
        <div class="device airport-device" id="airport-device"><div class="device-top"><span></span></div><div class="screen audio-screen"><div class="airport-slides" data-airport-slides><img src="/images/airport-maps-1-1280.webp" alt="Automated airport map" width="1720" height="1290" srcset="/images/airport-maps-1-720.webp 720w, /images/airport-maps-1-1280.webp 1280w, /images/airport-maps-1-1720.webp 1720w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/airport-maps-2-1280.webp" alt="Airport terminal map" width="1720" height="1290" srcset="/images/airport-maps-2-720.webp 720w, /images/airport-maps-2-1280.webp 1280w, /images/airport-maps-2-1720.webp 1720w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /><img src="/images/airport-maps-3-1280.webp" alt="Airport map production result" width="1720" height="1290" srcset="/images/airport-maps-3-720.webp 720w, /images/airport-maps-3-1280.webp 1280w, /images/airport-maps-3-1720.webp 1720w" sizes="(max-width: 800px) 84vw, 860px" loading="lazy" decoding="async" /></div></div></div>
        <div class="screen-switcher" aria-label="Airport Maps screenshots"><button class="is-active" data-airport-slide="0">01<span class="sr-only">, show screenshot 1</span></button><button data-airport-slide="1">02<span class="sr-only">, show screenshot 2</span></button><button data-airport-slide="2">03<span class="sr-only">, show screenshot 3</span></button></div>
      </div>
    </section>

    <section class="all-cases-bridge" id="more-cases" aria-labelledby="all-cases-title">
      <div class="all-cases-minimal">
        <h2 id="all-cases-title">More work<br/><em>Every detail</em></h2>
        <a class="button-motion" href="/use-cases">Explore all cases <span aria-hidden="true">↗︎</span></a>
      </div>
    </section>

    <section class="expertise bento-section" id="expertise">
      <div class="bento-heading"><div class="eyebrow light"><span></span> What we do?</div><h2>Everything is spatial<br/><em>One senior team</em></h2></div>
      <div class="bento-grid">
        <article class="skill-card card-maps card-wide"><div class="skill-visual skill-visual-maps"><img src="/images/maps-card-1100.webp" alt="Interactive city map with points of interest, routes, zones, and layer controls" width="1360" height="454" loading="lazy" decoding="async" srcset="/images/maps-card-700.webp 700w, /images/maps-card-1100.webp 1100w, /images/maps-card-1360.webp 1360w" sizes="(max-width: 800px) 100vw, 680px" /></div><div><small>Maps & GIS Solutions</small><h3>Custom interactive maps</h3><p>Mapbox · MapLibre · Leaflet</p></div></article>
        <article class="skill-card card-mobile-app"><div class="mobile-app-visual" aria-hidden="true"><img src="/images/mobile-maps-900.webp" alt="" width="900" height="761" loading="lazy" decoding="async" srcset="/images/mobile-maps-480.webp 480w, /images/mobile-maps-900.webp 900w" sizes="(max-width: 800px) 245px, 335px" /></div><h3>Mobile map applications</h3><p>iOS · Android · cross-platform</p></article>
        <article class="skill-card card-cesium card-tall"><div class="skill-visual skill-visual-terrain"><img src="/images/3d-mount-640.webp" alt="Detailed photorealistic 3D mountain terrain model" width="1000" height="1056" loading="lazy" decoding="async" srcset="/images/3d-mount-320.webp 320w, /images/3d-mount-640.webp 640w, /images/3d-mount-1000.webp 1000w" sizes="(max-width: 800px) 170px, 400px" /></div><div><h3>3D maps & terrain models</h3><p>Cesium · Deck.gl · Three.js</p></div></article>
        <article class="skill-card card-data card-wide"><div class="skill-visual skill-visual-postgis"><img src="/images/postGIS-900.webp" alt="PostGIS database servers supporting layered digital maps" width="900" height="600" loading="lazy" decoding="async" srcset="/images/postGIS-520.webp 520w, /images/postGIS-900.webp 900w" sizes="(max-width: 800px) 60vw, 420px" /></div><div><h3>Tile servers & spatial databases</h3><p>GDB · PostGIS · Geoserver · QGIS Server · Titiler</p></div></article>
        <article class="skill-card card-mobile"><div class="mobile-phone" aria-hidden="true"><img src="/images/phone-400.webp" alt="" width="640" height="640" loading="lazy" decoding="async" srcset="/images/phone-320.webp 320w, /images/phone-400.webp 400w, /images/phone-640.webp 640w" sizes="(max-width: 800px) 211px, 320px" /></div><h3>Offline maps</h3><p>Maps that work beyond the network</p></article>
        <article class="skill-card card-cloud card-wide"><div class="cloud-pipeline" aria-hidden="true"><img src="/images/cicd-pipeline-1360.webp" alt="" width="1360" height="453" loading="lazy" decoding="async" srcset="/images/cicd-pipeline-700.webp 700w, /images/cicd-pipeline-1360.webp 1360w" sizes="(max-width: 800px) 375px, 680px" /></div><div class="cloud-copy"><h3>CI/CD & cloud deployment</h3><p>Reliable releases at any scale</p></div></article>
        <article class="skill-card card-cad card-wide">
          <div class="cad-flow" role="img" aria-label="A DWG architectural model integrated into a GIS application">
            <div class="cad-flow-stage">
              <div class="cad-flow-source"><img src="/images/cad-model-600.webp" alt="" width="1000" height="751" loading="lazy" decoding="async" srcset="/images/cad-model-360.webp 360w, /images/cad-model-600.webp 600w, /images/cad-model-1000.webp 1000w" sizes="(max-width: 800px) 195px, 325px" /></div>
              <div class="cad-flow-result"><img class="cad-flow-target" src="/images/inter-gis-1200.webp" alt="" width="1200" height="737" loading="lazy" decoding="async" srcset="/images/inter-gis-700.webp 700w, /images/inter-gis-1200.webp 1200w" sizes="(max-width: 800px) 332px, 600px" /></div>
            </div>
          </div>
          <div class="cad-copy"><h3>CAD ↔︎ GIS integration</h3><p>Engineering drawings · spatial data · conversion</p></div>
        </article>
      </div>
      <div class="capability-group" aria-labelledby="capability-title">
        <div class="capability-group-head">
          <span>Supporting capabilities</span>
          <h3 id="capability-title">The disciplines behind every delivery</h3>
          <p>Senior expertise applied where the product needs it.</p>
        </div>
        <div class="capability-list">
          <article><span>01</span><div><h4>Frontend development</h4><p>React · Vue · Angular · responsive interfaces</p></div></article>
          <article><span>02</span><div><h4>UX / UI design</h4><p>Figma · prototypes · responsive design systems</p></div></article>
          <article><span>03</span><div><h4>Business + System Analysis</h4><p>Clear requirements, workflows, and product logic.</p></div></article>
          <article><span>04</span><div><h4>Backend development</h4><p>Python · Java · APIs · integrations</p></div></article>
          <article><span>05</span><div><h4>Quality Assurance</h4><p>Automated and manual testing across the delivery cycle.</p></div></article>
          <article><span>06</span><div><h4>Software Architecture</h4><p>Systems designed to scale, integrate, and evolve.</p></div></article>
          <article><span>07</span><div><h4>High-load systems</h4><p>Performance and resilience under real-world pressure.</p></div></article>
          <article><span>08</span><div><h4>Geodata preprocessing</h4><p>Cleaning · transformation · digitizing</p></div></article>
          <article><span>09</span><div><h4>Geospatial analysis &amp; visualization</h4><p>QGIS · ArcGIS · GDAL · FME</p></div></article>
          <article><span>10</span><div><h4>Web cartography</h4><p>Mapbox Studio · visual map systems</p></div></article>
        </div>
      </div>
    </section>

    <section class="technologies" id="technologies" aria-labelledby="technologies-title">
      <div class="technology-side">
        <div class="eyebrow light"><span></span> Our toolkit</div>
        <div class="technology-intro">
          <h2 id="technologies-title">Built with the<br/> <em>right tools</em></h2>
          <p>A practical stack selected around the product, its users, and the scale it needs to reach.</p>
        </div>
      </div>
      <div class="technology-map">
        <article class="technology-row">
          <div class="technology-label"><span>01</span><h3>Design</h3></div>
          <ul><li><i><img src="/images/tech/figma.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Figma</li><li><i><img src="/images/tech/adobe.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Adobe</li></ul>
        </article>
        <article class="technology-row">
          <div class="technology-label"><span>02</span><h3>Frontend</h3></div>
          <ul><li><i><img src="/images/tech/react.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>React</li><li><i><img src="/images/tech/typescript.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>TypeScript</li><li><i><img src="/images/tech/angular.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Angular</li><li><i><img src="/images/tech/mapbox.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Mapbox GL JS</li><li><i><img src="/images/tech/cesium.svg" alt="" aria-hidden="true" loading="lazy" decoding="async" width="28" height="28"/></i>Cesium</li></ul>
        </article>
