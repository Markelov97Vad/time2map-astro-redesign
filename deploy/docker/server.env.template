# Runtime env for the `app` container (rendered by CI via envsubst → `.env`).
# Do not copy this file as-is: placeholders must be substituted.
#
# Secrets (GitHub Actions): ADMIN_USER, ADMIN_PASS, CONTACT_TO, CONTACT_FROM,
# SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SITE_URL, ALLOWED_ORIGIN.
# See docs/DEPLOYMENT.md.

# --- Keystatic admin (Basic Auth; routes not proxied in Docker prod yet) ---
ADMIN_USER=${ADMIN_USER}
ADMIN_PASS=${ADMIN_PASS}

# --- Contact email (SMTP) ---
CONTACT_TO=${CONTACT_TO}
CONTACT_FROM=${CONTACT_FROM}
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_SECURE=${SMTP_SECURE}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}

# --- URLs / CORS ---
SITE_URL=${SITE_URL}
ALLOWED_ORIGIN=${ALLOWED_ORIGIN}
