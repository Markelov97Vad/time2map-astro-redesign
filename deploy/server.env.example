# Backend runtime config for bare-metal / local reference.
# Production Docker: CI renders deploy/docker/server.env.template → /opt/time2map/.env
# via envsubst (see docs/DEPLOYMENT.md). Do not commit real secrets.

# --- Keystatic admin (Basic Auth) ---
ADMIN_USER=admin
ADMIN_PASS=CHANGE-ME-to-a-strong-password

# --- Contact email (SMTP) ---
CONTACT_TO=contact@time2map.com
# CONTACT_FROM="time2map website <contact@time2map.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- URLs / CORS ---
SITE_URL=https://time2map.com
ALLOWED_ORIGIN=https://time2map.com

# --- Publish pipeline (bare-metal only; unset in Docker) ---
# PUBLISH_DIR=/var/www/time2map
# PUBLISH_KEEP=5
